<div class="card overflow-hidden shadow-sm flex flex-col" data-console-server="{{server.id}}">
  <div class="border-b border-line/50 bg-inset/10 p-5 font-bold tracking-wide text-sm flex items-center justify-between gap-4">
    <div class="flex items-center gap-2">{{{icon 'terminal' 'size-4 text-link'}}} Console</div>
    <div class="flex items-center gap-1.5" data-tip="Announce your console commands in the game chat under this name, for example Server Admin. Leave blank to stay silent. This is separate from the game's own [Rcon] line.">
      {{{icon 'megaphone' 'size-3.5 text-ink-faint'}}}
      <input class="input input-sm w-36 shadow-sm border border-line/50 bg-canvas text-xs font-medium" id="console-label" placeholder="Announce as…" aria-label="Announce console commands as" value="{{server.consoleLabel}}" maxlength="48" autocomplete="off" spellcheck="false">
      <button class="btn btn-sm bg-canvas border-line/50 shadow-sm hover:bg-inset/30" id="console-label-save">Save</button>
    </div>
  </div>
  
  <div class="p-5 sm:p-6 bg-canvas flex-1 flex flex-col gap-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-line/30 pb-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:flex-wrap gap-2 w-full sm:w-auto">
        <div class="relative flex-1 sm:max-w-xs">
          {{{icon 'filter' 'size-4 absolute left-3 top-1/2 -translate-y-1/2 text-ink-faint'}}}
          <input class="input pl-9 shadow-sm text-sm" placeholder="Filter log lines… (wrap in / / for a regex)" id="console-filter" aria-label="Filter log lines">
        </div>
        <div class="flex flex-wrap gap-1.5">
          <label class="chip bg-inset/30 border-line/50 hover:bg-inset/50 transition-colors cursor-pointer gap-1.5 px-3 py-1 font-bold text-xs"><input type="checkbox" class="msm-check" data-level-filter="INFO" checked> INFO</label>
          <label class="chip bg-warn/10 text-warn-strong border-warn/30 hover:bg-warn/20 transition-colors cursor-pointer gap-1.5 px-3 py-1 font-bold text-xs"><input type="checkbox" class="msm-check" data-level-filter="WARN" checked> WARN</label>
          <label class="chip bg-danger/10 text-danger border-danger/30 hover:bg-danger/20 transition-colors cursor-pointer gap-1.5 px-3 py-1 font-bold text-xs"><input type="checkbox" class="msm-check" data-level-filter="ERROR" checked> ERROR</label>
          <label class="chip bg-inset/30 border-line/50 hover:bg-inset/50 transition-colors cursor-pointer gap-1.5 px-3 py-1 font-bold text-xs" data-tip="Hides the repeating connection lines the panel adds every few seconds while it checks on your server over its remote console (Rcon): player count, time and world settings. Turn this off to see the raw log exactly as the server writes it."><input type="checkbox" class="msm-check" id="console-hide-rcon" checked> Hide Noise</label>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <button class="btn btn-sm bg-canvas border-line/50 shadow-sm hover:bg-inset/30" data-menu="console-dl-menu">{{{icon 'download' 'size-3.5'}}} Download {{{icon 'chevron-down' 'size-3.5'}}}</button>
        <template id="console-dl-menu">
          <a href="/api/servers/{{server.id}}/logs?tail=2000" download="{{server.name}}-recent.log">{{{icon 'scroll-text' 'size-3.5'}}} Recent Output (Last 2000 Lines)</a>
          <a href="/api/servers/{{server.id}}/logs/game/latest.log" download>{{{icon 'file-text' 'size-3.5'}}} Full latest.log</a>
          <a href="/api/servers/{{server.id}}/logs/bundle.zip" download>{{{icon 'folder-archive' 'size-3.5'}}} All Log Files (.zip)</a>
        </template>
      </div>
    </div>

  {{! Rotated game logs the server itself keeps next to latest.log. Populated by
      console.js on load; hidden until there's at least one. }}
  <details class="mb-3 rounded-md border border-line text-xs" data-console-logfiles hidden>
    <summary class="cursor-pointer px-3 py-2 font-semibold text-ink-faint marker:content-none">
      {{{icon 'archive' 'size-3.5'}}} Older log files <span data-console-logfiles-count></span>
    </summary>
    <div class="divide-y divide-line border-t border-line" data-console-logfiles-list></div>
  </details>

  <div class="console h-96 overflow-y-auto overflow-x-auto break-words" id="console-log">
    {{#if consoleLines}}
      {{#each consoleLines}}
        <div data-level="{{level}}"{{#if (eq level 'WARN')}} class="text-gold-300"{{/if}}{{#if (eq level 'ERROR')}} class="text-redstone-400"{{/if}}>{{text}}</div>
      {{/each}}
    {{else}}
      {{! stone literal, not ink token - the console stays dark in both themes. }}
      <div class="grid h-full place-items-center px-4 text-center text-sm text-stone-400" data-console-empty>
        <div>
          {{{icon 'terminal' 'mx-auto size-6 text-stone-500'}}}
          <p class="mt-2">No console output yet. Start the server to see live logs.</p>
        </div>
      </div>
    {{/if}}
  </div>

  {{#unless perms.console}}
    <p class="notice notice-info mt-3">You can watch this console, but running commands needs the console permission on this server.</p>
  {{/unless}}
  <div class="mt-3 flex gap-2{{#unless perms.console}} hidden{{/unless}}">
    <span class="grid place-items-center rounded-md border border-line-strong bg-inset px-3 font-mono text-sm text-ok">/</span>
    {{! min-w-0: see settings.hbs - without it this input won't shrink below its
        placeholder's intrinsic width and pushes the page wider on narrow screens. }}
    <input class="input min-w-0 flex-1 font-mono" placeholder="Type a command (Enter to send, ↑ for history)" id="console-input" aria-label="Server command" autocomplete="off">
    <button class="btn btn-primary" id="console-send">{{{icon 'terminal' 'size-4'}}} Send</button>
  </div>
  <div class="mt-2 flex flex-wrap gap-1.5{{#unless perms.console}} hidden{{/unless}}">
    <button class="chip bg-inset/30 border-line/50 hover:bg-inset/50 transition-colors font-bold text-[10px] uppercase tracking-wider" data-quick-cmd="time set day">{{{icon 'sun' 'size-3.5'}}} time set day</button>
    <button class="chip bg-inset/30 border-line/50 hover:bg-inset/50 transition-colors font-bold text-[10px] uppercase tracking-wider" data-quick-cmd="weather clear">{{{icon 'cloud-sun' 'size-3.5'}}} weather clear</button>
    <button class="chip bg-inset/30 border-line/50 hover:bg-inset/50 transition-colors font-bold text-[10px] uppercase tracking-wider" data-quick-cmd="save-all">{{{icon 'save' 'size-3.5'}}} save-all</button>
    <button class="chip bg-inset/30 border-line/50 hover:bg-inset/50 transition-colors font-bold text-[10px] uppercase tracking-wider" data-quick-cmd="whitelist list">{{{icon 'clipboard-copy' 'size-3.5'}}} whitelist list</button>
    <button class="chip bg-inset/30 border-line/50 hover:bg-inset/50 transition-colors font-bold text-[10px] uppercase tracking-wider" data-quick-cmd="list">{{{icon 'users' 'size-3.5'}}} list</button>
  </div>
  </div>
</div>
<script type="module" src="/js/pages/console.js"></script>
