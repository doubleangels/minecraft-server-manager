<div class="card grid place-items-center px-6 py-16 text-center">
  <div class="grid size-16 place-items-center rounded-2xl bg-ok/10 text-ok ring-1 ring-ok/20 shadow-xs">{{{icon (default iconName 'boxes') 'size-8'}}}</div>
  <h3 class="mt-4 text-lg font-bold tracking-tight text-ink">{{title}}</h3>
  <p class="mt-1.5 max-w-md text-sm text-ink-faint leading-relaxed">{{message}}</p>
  {{#if ctaHref}}<a href="{{ctaHref}}" class="btn btn-primary mt-5 shadow-sm">{{ctaLabel}}</a>
  {{else if ctaId}}<button id="{{ctaId}}" class="btn btn-primary mt-5 shadow-sm" type="button">{{ctaLabel}}</button>{{/if}}
</div>
