{{> page-header heading="MODPACKS" sub="Browse CurseForge and Modrinth packs and manage installed ones. Every install is version-pinned, so restarts never surprise you."}}

<div id="modpacks-page">
  <div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:flex-wrap gap-2">
    <input class="input min-w-0 max-w-md flex-1" id="packs-q" placeholder="Search modpacks, e.g. Simply Optimized, All the Mods…" autocomplete="off">
    <div class="seg" id="packs-platforms" role="group" aria-label="Search platform">
      <button type="button" class="seg-btn" aria-pressed="true" data-platform="modrinth">Modrinth</button>
      <button type="button" class="seg-btn" aria-pressed="false" data-platform="curseforge">CurseForge</button>
    </div>
    <div class="ml-auto flex gap-2">
      {{! Honest label + weight: this button focuses the search field, it doesn't install anything. }}
      <button class="btn" id="packs-install-btn">{{{icon 'search' 'size-4'}}} Search Packs</button>
      <a href="/settings" class="btn">{{{icon 'key' 'size-4'}}} API Keys</a>
    </div>
  </div>

  <div class="hidden" id="packs-results-wrap">
    <h3 class="mb-3 mt-6 eyebrow">Search Results</h3>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" id="packs-results"></div>
  </div>

  <h3 class="mb-3 mt-6 eyebrow">Installed</h3>

  {{#unless packServers.length}}
    {{> empty-state iconName='package' title='No Modpacks Installed' message='No server is running a managed modpack yet. Search above, then use the create wizard. Every install is version-pinned, so restarts never surprise you.' ctaHref='/servers/new' ctaLabel='Create a Server'}}
  {{/unless}}

  {{! Same column count as search results - the same card width jumped between
      the two sections at xl. }}
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" id="packs-installed">
    {{#each packServers}}
      <div class="card cursor-pointer p-0 transition-all hover:-translate-y-1 hover:shadow-lg bg-canvas relative overflow-hidden group" style="border-top: 4px solid {{accent}}"
           data-pack-card data-server-id="{{id}}" data-server-name="{{name}}"
           data-pack-name="{{pack.name}}" data-current="{{pack.version}}" data-latest="{{pack.latest}}"
           {{#if pack.latestVersionId}}data-version-id="{{pack.latestVersionId}}"{{/if}}>
        
        <div class="absolute inset-0 bg-gradient-to-b from-black/5 to-transparent h-12 pointer-events-none" style="background-image: linear-gradient(to bottom, {{accent}}20, transparent);"></div>
        
        <div class="p-5 relative z-10">
          <div class="flex items-start gap-4">
            <img src="{{iconSrc this.icon}}" alt="" class="size-12 shrink-0 rounded-xl shadow-md ring-1 ring-inset ring-black/10 object-cover" style="background: {{accent}}" data-fallback-icon="/icons/servers/grass.svg">
            <div class="min-w-0 flex-1">
              <div class="truncate font-bold text-lg text-ink" title="{{pack.name}}">{{pack.name}}</div>
              <div class="text-[11px] font-medium text-ink-soft uppercase tracking-wider mt-0.5"><span class="font-bold text-ink">{{platformName pack.platform}}</span> <span class="mx-1 opacity-50">·</span> on <a href="/servers/{{id}}" class="text-link hover:underline transition-colors">{{name}}</a></div>
            </div>
          </div>
          
          <div class="mt-4 flex items-center justify-between">
            <span class="text-[10px] font-bold text-ink-faint uppercase tracking-wider">Current Version</span>
            <span class="chip bg-inset/50 max-w-40 shrink-0 border-line/50 font-bold text-ink-soft shadow-inner" title="pinned @ {{pack.version}}"><span class="truncate">pinned @ {{pack.version}}</span></span>
          </div>
        </div>
        
        <div class="flex items-center gap-2 border-t border-line/30 bg-inset/10 p-3 sm:px-5">
          {{#if updateAvailable}}
            <span class="badge badge-warn min-w-0 border-warn/30 bg-warn/10 text-warn-strong text-[10px] uppercase font-bold tracking-widest"><span class="truncate" title="{{pack.latest}} available">{{pack.latest}} Available</span></span>
            <button class="btn btn-sm btn-primary ml-auto shrink-0 shadow-sm" data-pack-upgrade>{{{icon 'circle-arrow-up' 'size-3.5'}}} Upgrade…</button>
          {{else}}
            <span class="text-[11px] font-bold text-ok flex items-center gap-1.5 uppercase tracking-wider">{{{icon 'check-circle' 'size-3.5'}}} Up to date</span>
            <button class="btn btn-ghost btn-sm ml-auto border border-line/50 shadow-sm bg-canvas hover:bg-inset/30" data-pack-check>{{{icon 'rotate-cw' 'size-3.5'}}} Check Now</button>
          {{/if}}
        </div>
      </div>
    {{/each}}
  </div>
</div>
<script type="module" src="/js/pages/modpacks.js"></script>
