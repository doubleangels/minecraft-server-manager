{{#if notFound}}
  <div class="card w-full max-w-sm p-8 text-center shadow-md">
    <div class="pixel text-4xl text-danger mb-4">{{{icon 'alert-triangle' 'size-10 mx-auto'}}}</div>
    <h1 class="text-xl font-bold tracking-tight">Status Page Not Found</h1>
    <p class="mt-2 text-sm font-medium text-ink-faint">This status page does not exist, or the server owner has turned it off.</p>
  </div>
{{else}}
  <div class="card w-full max-w-md overflow-hidden bg-canvas shadow-lg relative" style="border-top: 4px solid {{page.accent}}">
    <div class="absolute inset-0 bg-gradient-to-b from-black/5 to-transparent h-20 pointer-events-none" style="background-image: linear-gradient(to bottom, {{page.accent}}20, transparent);"></div>
    <div class="texture-top p-6 sm:p-8 text-center relative z-10">
      <img src="{{iconSrc page.icon}}" alt="" class="mx-auto size-20 rounded-2xl shadow-md ring-1 ring-inset ring-black/10 transition-transform hover:scale-105 duration-300 object-cover" style="background: {{page.accent}}" data-fallback-icon="/icons/servers/grass.svg">
      <h1 class="mt-4 text-2xl font-bold tracking-tight text-ink">{{page.name}}</h1>
      {{#if page.motd}}<p class="mt-1.5 text-sm font-medium text-ink-soft">{{page.motd}}</p>{{/if}}
      
      <div class="mt-4 inline-flex items-center justify-center gap-1.5 text-[11px] uppercase tracking-widest font-bold px-3 py-1 rounded-md border border-line/50 bg-inset/20 shadow-sm {{statusText page.status}}">
        <span class="status-dot relative {{statusDot page.status}} {{#if (statusPulse page.status)}}pulse{{/if}}"></span>
        {{statusLabel page.status}}
      </div>
    </div>
    
    <dl class="grid grid-cols-3 gap-px border-t border-line/50 bg-line/50 text-center tabular-nums">
      <div class="bg-canvas hover:bg-inset/10 transition-colors p-4">
        <dt class="text-[10px] font-bold uppercase tracking-wider text-ink-faint flex items-center justify-center gap-1.5 mb-1.5">{{{icon 'layers' 'size-3'}}} Version</dt>
        <dd class="text-sm font-bold text-ink-soft"><b class="text-ink mr-0.5">{{page.flavor}}</b> {{page.mcVersion}}</dd>
      </div>
      <div class="bg-canvas hover:bg-inset/10 transition-colors p-4">
        <dt class="text-[10px] font-bold uppercase tracking-wider text-ink-faint flex items-center justify-center gap-1.5 mb-1.5">{{{icon 'users' 'size-3'}}} Players</dt>
        <dd class="text-sm font-bold text-ink">{{page.online}} <span class="text-ink-faint font-medium">/ {{page.max}}</span></dd>
      </div>
      <div class="bg-canvas hover:bg-inset/10 transition-colors p-4">
        <dt class="text-[10px] font-bold uppercase tracking-wider text-ink-faint flex items-center justify-center gap-1.5 mb-1.5">{{{icon 'clock' 'size-3'}}} Uptime</dt>
        <dd class="text-sm font-bold text-ink">{{#if page.uptime}}{{page.uptime}}{{else}}<span class="text-ink-faint font-medium">Unknown</span>{{/if}}</dd>
      </div>
    </dl>
    
    <div class="bg-inset/20 border-t border-line/30 p-3 text-center">
      <p class="text-[10px] font-bold uppercase tracking-widest text-ink-faint opacity-70">Powered by Minecraft Server Manager</p>
    </div>
  </div>
  {{! A public status page that renders once goes stale in minutes - a plain
      meta refresh keeps it honest with zero JS on an anonymous page. }}
  <meta http-equiv="refresh" content="60">
{{/if}}
