{{#unless serversOnly}}{{> page-header heading="DASHBOARD" sub="Every server at a glance: status, resource use, and the latest activity across the panel."}}{{/unless}}

{{#unless serversOnly}}
<div class="mb-6 {{#if noServers}}hidden{{/if}}">
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
    <!-- Servers & Players -->
    <div class="card min-w-0 p-4 sm:p-5 flex flex-col justify-between relative overflow-hidden">
      <div class="absolute -right-4 -top-4 text-ink-faint/5 pointer-events-none">
        {{{icon 'server' 'size-24'}}}
      </div>
      <div class="eyebrow flex items-center gap-1.5">{{{icon 'server' 'size-4'}}} Servers & Players</div>
      <div class="mt-4 flex items-end justify-between gap-4">
        <div>
          <div class="text-4xl font-bold tracking-tight tabular-nums {{#if totals.running}}text-ok{{/if}}">{{totals.running}}<span class="ml-1 text-lg font-medium text-ink-soft">/ {{totals.total}}</span></div>
          <div class="mt-1 text-xs text-ink-faint font-medium uppercase tracking-wide">Servers Online</div>
        </div>
        <div class="text-right">
          <div class="text-4xl font-bold tracking-tight tabular-nums">{{totals.players}}</div>
          <div class="mt-1 text-xs text-ink-faint font-medium uppercase tracking-wide">Players Connected</div>
        </div>
      </div>
      <div class="mt-5 pt-4 border-t border-line/50 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-medium">
        {{#if overview.byStatus.running}}<span class="flex items-center gap-1.5 text-ok" title="Running"><span class="status-dot {{statusDot 'running'}}"></span>{{overview.byStatus.running}}</span>{{/if}}
        {{#if overview.byStatus.starting}}<span class="flex items-center gap-1.5 text-link" title="Starting"><span class="status-dot {{statusDot 'starting'}}"></span>{{overview.byStatus.starting}}</span>{{/if}}
        {{#if overview.byStatus.unhealthy}}<span class="flex items-center gap-1.5 text-warn" title="Unhealthy"><span class="status-dot {{statusDot 'unhealthy'}}"></span>{{overview.byStatus.unhealthy}}</span>{{/if}}
        {{#if overview.byStatus.stalled}}<span class="flex items-center gap-1.5 text-danger" title="Stalled"><span class="status-dot {{statusDot 'stalled'}}"></span>{{overview.byStatus.stalled}}</span>{{/if}}
        {{#if overview.byStatus.updating}}<span class="flex items-center gap-1.5 text-link" title="Updating"><span class="status-dot {{statusDot 'updating'}}"></span>{{overview.byStatus.updating}}</span>{{/if}}
        {{#if overview.byStatus.crashed}}<span class="flex items-center gap-1.5 text-danger" title="Crashed"><span class="status-dot {{statusDot 'crashed'}}"></span>{{overview.byStatus.crashed}}</span>{{/if}}
        {{#if overview.byStatus.stopped}}<span class="flex items-center gap-1.5 text-ink-faint" title="Stopped"><span class="status-dot {{statusDot 'stopped'}}"></span>{{overview.byStatus.stopped}}</span>{{/if}}
      </div>
    </div>

    <!-- Compute -->
    <div class="card min-w-0 p-4 sm:p-5 flex flex-col justify-between relative overflow-hidden">
      <div class="absolute -right-4 -top-4 text-ink-faint/5 pointer-events-none">
        {{{icon 'cpu' 'size-24'}}}
      </div>
      <div class="eyebrow flex items-center justify-between gap-1.5">
        <span class="flex items-center gap-1.5">{{{icon 'cpu' 'size-4'}}} Compute</span>
        <div class="flex items-center gap-1.5 text-[10px] font-bold text-ink-soft uppercase tracking-wider bg-inset/50 px-2 py-1 rounded-md" id="docker-status">
          <span class="status-dot relative bg-stone-500"></span> DOCKER
        </div>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-4">
        <div>
          <div class="text-3xl font-bold tracking-tight tabular-nums">{{combined.cpuTotal}}<span class="text-sm font-medium text-ink-soft">%</span></div>
          <div class="mt-1 text-xs text-ink-faint font-medium uppercase tracking-wide">CPU Usage</div>
        </div>
        <div>
          <div class="text-3xl font-bold tracking-tight tabular-nums"><span data-overview-mem-used>{{overview.mem.usedMb}}</span><span class="text-sm font-medium text-ink-soft">MB</span></div>
          <div class="mt-1 text-xs text-ink-faint font-medium uppercase tracking-wide">RAM Used</div>
        </div>
      </div>
      <div class="mt-5 pt-4 border-t border-line/50 flex flex-col gap-1.5 text-xs font-medium">
        <div class="flex justify-between items-center"><span class="text-ink-faint">CPU Core Capacity</span> <span class="text-ink bg-inset/50 px-1.5 py-0.5 rounded">{{combined.cpuCapacity}}%</span></div>
        <div class="flex justify-between items-center"><span class="text-ink-faint">Total RAM Allotted</span> <span class="text-ink bg-inset/50 px-1.5 py-0.5 rounded">{{overview.mem.allottedMb}} MB</span></div>
      </div>
    </div>

    <!-- Storage -->
    <div class="card min-w-0 p-4 sm:p-5 flex flex-col justify-between relative overflow-hidden">
      <div class="absolute -right-4 -top-4 text-ink-faint/5 pointer-events-none">
        {{{icon 'hard-drive' 'size-24'}}}
      </div>
      <div class="eyebrow flex items-center gap-1.5">{{{icon 'hard-drive' 'size-4'}}} Storage</div>
      <div class="mt-4">
        <div class="text-4xl font-bold tracking-tight tabular-nums">{{bytes overview.disk.usedBytes}}</div>
        <div class="mt-1 text-xs text-ink-faint font-medium uppercase tracking-wide">Total Data Footprint</div>
      </div>
      <div class="mt-auto pt-4 border-t border-line/50">
        <p class="text-xs text-ink-faint font-medium leading-relaxed">
          Storage used by all server data folders and configurations across your panel.
        </p>
      </div>
    </div>

    <!-- Health & Updates -->
    <div class="flex flex-col gap-3 sm:gap-4">
      <a href="/health" class="card min-w-0 p-4 sm:p-5 flex-1 flex flex-col justify-center transition hover:border-line-strong hover:shadow-raised group" aria-label="Open the health page">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3.5">
            <div class="p-2.5 rounded-xl {{#if overview.healthTotal}}bg-danger/15 text-danger{{else}}bg-ok/15 text-ok{{/if}}">
              {{{icon 'activity' 'size-5'}}}
            </div>
            <div>
              <div class="text-sm font-bold tracking-wide">System Health</div>
              <div class="text-xs text-ink-faint font-medium mt-0.5">{{#if overview.healthTotal}}{{overview.health.crashes}} crashes, {{overview.health.oom}} out of memory{{else}}All systems stable · 24h{{/if}}</div>
            </div>
          </div>
          <div class="text-2xl font-bold tabular-nums {{#if overview.healthTotal}}text-danger{{else}}text-ok{{/if}} group-hover:scale-110 transition-transform">{{overview.healthTotal}}</div>
        </div>
      </a>
      <a href="/updates" class="card min-w-0 p-4 sm:p-5 flex-1 flex flex-col justify-center transition hover:border-line-strong hover:shadow-raised group" aria-label="Open the updates page">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3.5">
            <div class="p-2.5 rounded-xl {{#if overview.updates.all}}bg-warn/15 text-warn{{else}}bg-inset text-ink-soft{{/if}}">
              {{{icon 'circle-arrow-up' 'size-5'}}}
            </div>
            <div>
              <div class="text-sm font-bold tracking-wide">Available Updates</div>
              <div class="text-xs text-ink-faint font-medium mt-0.5">{{overview.updates.mods}} mods, {{overview.updates.server}} server</div>
            </div>
          </div>
          <div class="text-2xl font-bold tabular-nums {{#if overview.updates.all}}text-warn{{else}}text-ink-soft{{/if}} group-hover:scale-110 transition-transform">{{overview.updates.all}}</div>
        </div>
      </a>
    </div>
  </div>
</div>
{{/unless}}

<div id="docker-warning" class="notice notice-danger mb-4 hidden">
  {{{icon 'triangle-alert' 'size-4 mt-0.5 shrink-0 text-danger'}}}
  <div>
    <span class="font-semibold text-danger">Docker isn't reachable.</span>
    <span id="docker-warning-reason">Start Docker, then refresh. Creating or starting servers needs Docker running.</span>
  </div>
</div>

{{#unless serversOnly}}
<div class="mb-8 {{#if noServers}}hidden{{/if}}" id="combined-overview">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="font-bold text-lg tracking-wide flex items-center gap-2">
      {{{icon 'bar-chart' 'size-5 text-ink-soft'}}}
      Live Resource Overview
    </h2>
  </div>
  <div data-combined-root>
    {{> combined-graphs}}
  </div>
</div>
{{/unless}}

{{#unless noServers}}
<div class="mb-4 flex flex-col gap-3 sticky top-0 z-40 bg-canvas/90 backdrop-blur-md pt-2 pb-3 -mx-4 px-4 sm:mx-0 sm:px-0 sm:static sm:bg-transparent sm:flex-row sm:items-center sm:justify-between sm:pb-0 sm:pt-0">
  <input class="input flex-1 sm:max-w-xs shadow-sm" placeholder="Search servers, tags…" id="server-filter">
  <div class="flex flex-wrap items-center gap-3">
    <div class="flex items-center gap-2">
      <label class="text-xs font-medium text-ink-faint shrink-0" for="server-sort">Sort</label>
      <select class="input w-auto shrink-0 shadow-sm" id="server-sort" data-label="Sort servers">
        <option value="status" {{#if (eq sort 'status')}}selected{{/if}}>Status</option>
        <option value="name" {{#if (eq sort 'name')}}selected{{/if}}>Name</option>
        <option value="size" {{#if (eq sort 'size')}}selected{{/if}}>Size</option>
        <option value="started" {{#if (eq sort 'started')}}selected{{/if}}>Last Started</option>
        <option value="created" {{#if (eq sort 'created')}}selected{{/if}}>Created</option>
      </select>
    </div>
    <div class="seg shrink-0 ml-auto sm:ml-0 shadow-sm" role="group" aria-label="View">
      <button class="seg-btn" id="view-grid" aria-pressed="false" data-tip="Grid view.">{{{icon 'layout-grid' 'size-4'}}}</button>
      <button class="seg-btn" id="view-list" aria-pressed="false" data-tip="List view.">{{{icon 'list' 'size-4'}}}</button>
    </div>
  </div>
</div>

{{/unless}}

{{#if noServers}}
  {{> empty-state iconName='pickaxe' title='No Servers Yet' message='Create your first Minecraft server. Pick a server type and version, or start from a blueprint. You will be playing in minutes.' ctaHref='/servers/new' ctaLabel='Create a Server'}}
{{else}}
<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" id="server-grid">
  {{#each servers}}
    {{> server-card}}
  {{/each}}

  <a href="/servers/new" class="grid min-h-44 place-items-center rounded-xl border-2 border-dashed border-line text-ink-faint transition hover:border-ok hover:text-ok hover:bg-inset/10">
    <div class="grid place-items-center text-center">
      {{{icon 'plus' 'size-8'}}}
      <div class="mt-2 text-sm font-medium">Create a Server</div>
      {{! label kept in sync with the empty-state CTA, topbar, and setup }} 
    </div>
  </a>
</div>
{{/if}}

<div class="mt-8 {{#if serversOnly}}hidden{{/if}}">
  <div class="mb-3 flex items-center justify-between">
    <h2 class="font-semibold">Recent Activity</h2>
    <a href="/activity" class="text-sm text-link hover:underline">View All →</a>
  </div>
  <div class="card">
    <ol class="divide-y divide-line">
      {{#each activity}}
        <li class="flex flex-wrap items-center gap-2 p-3 text-sm">
          <span class="badge shrink-0 {{eventBadge type}}">{{type}}</span>
          <span class="min-w-0 flex-1">{{summary}}</span>
          {{! deleted-server names are plain faint text - link-styled dead spans read as broken. }}
          {{#if serverId}}<a href="/servers/{{serverId}}" class="shrink-0 text-xs text-link hover:underline">{{server}}</a>{{else}}<span class="shrink-0 text-xs text-ink-faint">{{server}}</span>{{/if}}
          <span class="shrink-0 text-xs text-ink-faint" data-ts-ago="{{ts}}">{{ts}}</span>
        </li>
      {{else}}
        <li class="p-8 text-center text-sm text-ink-faint">No activity yet. Actions on your servers will show up here.</li>
      {{/each}}
    </ol>
  </div>
</div>
<script type="module" src="/js/pages/dashboard.js"></script>
