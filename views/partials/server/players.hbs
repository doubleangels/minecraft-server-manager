<div data-players-root data-server-id="{{server.id}}" data-running="{{#if (or (eq server.status 'running') (eq server.status 'unhealthy'))}}1{{else}}0{{/if}}">

  <div class="mb-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-line/50 pb-4">
    <div class="flex flex-wrap items-center gap-2 flex-1">
      {{#if players.length}}
      <input class="input flex-1 sm:max-w-xs shadow-sm" placeholder="Search players…" id="players-search">
      <select class="input w-auto shadow-sm" id="players-filter" data-label="Filter players">
        <option value="all">All Players</option>
        <option value="online">Online</option>
        <option value="whitelisted">Whitelisted</option>
        <option value="ops">Ops</option>
        <option value="banned">Banned</option>
      </select>
      {{/if}}
      <label class="flex cursor-pointer items-center gap-2 text-sm font-medium text-ink-soft ml-2">
        <span class="msm-toggle"><input type="checkbox" id="players-wl-enforce" {{#if whitelistEnforced}}checked{{/if}}><span></span></span>
        Whitelist Enforced
      </label>
    </div>
    <div class="flex gap-2 shrink-0">
      <button class="btn btn-primary btn-sm shadow-md" id="players-add">{{{icon 'user-plus' 'size-3.5'}}} Add Player</button>
    </div>
  </div>

  {{#unless (or (eq server.status 'running') (eq server.status 'unhealthy'))}}
    <div class="notice notice-warn mb-4 max-w-prose text-xs">
      The server is offline. Whitelist, operator, and ban changes are written straight to the server files and take effect on the next start.
      Kicks and teleports need a running server.
    </div>
  {{/unless}}

  {{#if players.length}}
  <div class="card overflow-hidden shadow-sm">
    <div class="border-b border-line/50 bg-inset/10 p-5 font-bold tracking-wide text-sm flex items-center justify-between gap-4">
      <div class="flex items-center gap-2">{{{icon 'users' 'size-4 text-link'}}} Players</div>
      <span class="text-[10px] uppercase tracking-widest text-ink-faint bg-inset/50 border border-line/30 px-2 py-0.5 rounded shadow-inner font-bold">{{players.length}} Total</span>
    </div>
    <div class="overflow-x-auto">
      <table class="table-base table-stack w-full text-sm">
        <thead class="bg-canvas/50">
          <tr class="text-[10px] uppercase tracking-widest text-ink-faint">
            <th class="font-bold py-3 pl-5">Player</th>
            <th class="font-bold py-3">Status</th>
            <th class="font-bold py-3">Roles</th>
            <th class="font-bold py-3">Details</th>
            <th class="text-right font-bold py-3 pr-5">Actions</th>
          </tr>
        </thead>
      <tbody class="divide-y divide-line/30">
        {{#each players}}
          <tr class="hover:bg-inset/10 transition-colors group" data-player-row
              data-name="{{name}}"
              data-online="{{#if online}}1{{else}}0{{/if}}"
              data-whitelisted="{{#if whitelisted}}1{{else}}0{{/if}}"
              data-op="{{#if op}}1{{else}}0{{/if}}"
              data-banned="{{#if banned}}1{{else}}0{{/if}}"
              data-last-seen="{{lastSeen}}">
            <td data-th="Player" class="p-3 pl-5">
              <a href="/servers/{{../server.id}}/players/{{name}}" class="group/link flex items-center gap-3" data-tip="Open {{name}}'s page: roles, teleport, and inventory.">
                <span class="relative grid size-10 shrink-0 place-items-center overflow-hidden rounded-full bg-inset/50 border border-line/50 text-[11px] font-bold shadow-sm">
                  {{#if bedrock}}{{{icon 'gamepad-2' 'size-4'}}}{{else}}{{name.[0]}}{{/if}}
                  {{#if uuid}}<img class="absolute inset-0 h-full w-full object-cover" data-skin-uuid="{{uuid}}" alt="{{name}}" aria-hidden="true" loading="lazy">{{/if}}
                </span>
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <div class="truncate font-bold text-ink transition group-hover/link:text-link">{{name}}</div>
                    {{#if bedrock}}<span class="badge bg-inset/50 border border-line/50 text-[9px] uppercase tracking-wider shrink-0" data-tip="Joined from Bedrock Edition via Geyser/Floodgate.">{{{icon 'gamepad-2' 'size-3'}}} Bedrock</span>{{/if}}
                  </div>
                  {{#if uuid}}<div class="max-w-36 truncate font-mono text-[10px] font-medium text-ink-faint bg-inset/30 px-1 py-0.5 rounded border border-line/30 inline-block mt-1">{{uuid}}</div>{{/if}}
                </div>
              </a>
            </td>
            <td data-th="Status" data-player-status class="p-3">
              {{#if online}}
                <span class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-ok-strong bg-ok/10 px-2 py-0.5 rounded-full border border-ok/20 w-fit"><span class="status-dot relative bg-grass-500 pulse"></span> Online</span>
              {{else if banned}}
                <span class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-danger-strong bg-danger/10 px-2 py-0.5 rounded-full border border-danger/20 w-fit"><span class="status-dot bg-redstone-500"></span> Banned</span>
              {{else if whitelisted}}
                <span class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-ok-strong bg-ok/10 px-2 py-0.5 rounded-full border border-ok/20 w-fit opacity-75"><span class="status-dot bg-grass-700"></span> Whitelisted</span>
              {{else}}
                <span class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-ink-soft bg-inset/50 px-2 py-0.5 rounded-full border border-line/50 w-fit"><span class="status-dot bg-stone-500"></span> Joined</span>
                {{#if ../whitelistEnforced}}
                  <div class="mt-1.5 text-[10px] font-bold uppercase tracking-wider text-warn" data-tip="Whitelist enforcement is on. This player has never been whitelisted, so they will be turned away when they try to join.">Blocked</div>
                {{else}}
                  <div class="mt-1.5 text-[10px] font-bold uppercase tracking-wider text-ink-faint">Not whitelisted</div>
                {{/if}}
              {{/if}}
              {{#if lastSeen}}<div class="mt-1 text-[10px] font-medium text-ink-faint" data-tip="The last time this name was seen in the server's cache.">seen ~{{lastSeen}}</div>{{/if}}
            </td>
            {{! Off-state chips keep full opacity - dimming reads as disabled,
                and genuinely disabled composers already use opacity for that. }}
            <td data-th="Roles" class="p-3">
              <div class="flex flex-wrap gap-1.5">
                <button class="chip font-bold text-[10px] uppercase tracking-wider shadow-sm transition-colors border {{#if whitelisted}}bg-ok/10 text-ok-strong border-ok/30 hover:bg-ok/20{{else}}bg-inset/30 border-line/50 text-ink-soft hover:bg-inset/50{{/if}}"
                        data-role-toggle="whitelist" data-name="{{name}}" data-on="{{#if whitelisted}}1{{else}}0{{/if}}"
                        data-tip="{{#if whitelisted}}Remove this player from the whitelist.{{else}}Add this player to the whitelist.{{/if}}">
                  {{{icon 'shield-check' 'size-3.5'}}} <span data-chip-label>Whitelist</span>
                </button>
                <button class="chip font-bold text-[10px] uppercase tracking-wider shadow-sm transition-colors border {{#if op}}bg-link/10 text-link border-link/30 hover:bg-link/20{{else}}bg-inset/30 border-line/50 text-ink-soft hover:bg-inset/50{{/if}}"
                        data-role-toggle="op" data-name="{{name}}" data-on="{{#if op}}1{{else}}0{{/if}}"
                        data-tip="{{#if op}}Remove operator status from this player.{{else}}Make this player an operator (level 4).{{/if}}">
                  {{{icon 'shield' 'size-3.5'}}} <span data-chip-label>Op{{#if op}} L{{opLevel}}{{/if}}</span>
                </button>
                <button class="chip font-bold text-[10px] uppercase tracking-wider shadow-sm transition-colors border {{#if banned}}bg-danger/10 text-danger border-danger/30 hover:bg-danger/20{{else}}bg-inset/30 border-line/50 text-ink-soft hover:bg-inset/50{{/if}}"
                        data-role-toggle="ban" data-name="{{name}}" data-on="{{#if banned}}1{{else}}0{{/if}}"
                        data-tip="{{#if banned}}Pardon this player.{{else}}Ban this player.{{/if}}">
                  {{{icon 'ban' 'size-3.5'}}} <span data-chip-label>{{#if banned}}Banned{{else}}Ban{{/if}}</span>
                </button>
              </div>
            </td>
            <td data-th="Details" class="text-[11px] font-medium text-ink-faint p-3" data-ban-details>
              {{#if banned}}
                <div class="truncate text-danger font-bold sm:max-w-56 bg-danger/5 px-2 py-1 rounded border border-danger/10 mb-1" title="{{default banReason 'No reason recorded'}}">{{default banReason 'No reason recorded'}}</div>
                {{#if banDate}}<div class="mt-0.5">{{banDate}}{{#if banSource}} · {{banSource}}{{/if}}</div>{{/if}}
                {{#if banExpires}}<div class="mt-0.5 text-warn font-bold uppercase tracking-wider text-[9px]">expires {{banExpires}}</div>{{/if}}
              {{else}}
                <span class="opacity-50">-</span>
              {{/if}}
            </td>
            <td data-th="" class="p-3 sm:text-right pr-5">
              <div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap sm:opacity-0 group-hover:opacity-100 transition-opacity">
                {{#if online}}
                  <button class="btn btn-ghost btn-sm text-warn hover:bg-warn/10 rounded-full size-8 p-0 grid place-items-center" data-act="kick" data-name="{{name}}" data-tip="Kick with a message.">{{{icon 'log-out' 'size-4'}}}</button>
                {{/if}}
                {{#if (or (eq ../server.status 'running') (eq ../server.status 'unhealthy'))}}
                  <button class="btn btn-ghost btn-sm text-link hover:bg-link/10 rounded-full size-8 p-0 grid place-items-center" data-act="teleport" data-name="{{name}}" data-tip="Teleport by coordinates, biome, or player.">{{{icon 'compass' 'size-4'}}}</button>
                {{else}}
                  <span data-tip="Start the server to teleport players."><button class="btn btn-ghost btn-sm text-ink-faint rounded-full size-8 p-0 grid place-items-center" data-act="teleport" data-name="{{name}}" disabled>{{{icon 'compass' 'size-4'}}}</button></span>
                {{/if}}
                <button class="btn btn-ghost btn-sm text-ink-faint hover:text-ink hover:bg-inset/30 rounded-full size-8 p-0 grid place-items-center" data-menu="player-menu-{{@index}}" data-tip="More actions.">{{{icon 'ellipsis' 'size-4'}}}</button>
                <template id="player-menu-{{@index}}">
                  <button data-act="op-level" data-name="{{name}}">{{{icon 'shield' 'size-3.5'}}} Set Operator Level…</button>
                  <button data-act="ban-reason" data-name="{{name}}">{{{icon 'ban' 'size-3.5'}}} Ban with Reason…</button>
                  <button data-act="notes" data-name="{{name}}">{{{icon 'sticky-note' 'size-3.5'}}} Moderator Notes…</button>
                  {{#if uuid}}<button data-act="copy-uuid" data-uuid="{{uuid}}">{{{icon 'clipboard-copy' 'size-3.5'}}} Copy UUID</button>{{/if}}
                  {{#unless online}}<button class="text-danger" data-act="delete-player" data-name="{{name}}">{{{icon 'trash-2' 'size-3.5'}}} Delete Player…</button>{{/unless}}
                </template>
              </div>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
    </div>
    <div class="hidden p-12 text-center text-sm font-medium text-ink-faint" id="players-no-match">
      <span class="grid size-12 place-items-center rounded-full bg-inset/30 border border-line/30 shadow-inner mx-auto mb-3">{{{icon 'search' 'size-5 opacity-50'}}}</span>
      No players match these filters.
    </div>
  </div>
  {{else}}
    {{> empty-state iconName='users' title='No Players Seen Yet' message='Add a player by name and the panel looks them up with Mojang, or players appear here automatically the first time they join.'}}
  {{/if}}

  <div class="card overflow-hidden shadow-sm mt-6">
    <div class="border-b border-line/50 bg-inset/10 p-5 font-bold tracking-wide text-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-2">{{{icon 'shield-alert' 'size-4 text-link'}}} Banned IPs</div>
      <div class="flex flex-wrap items-end gap-2 w-full sm:w-auto">
        <input class="input input-sm w-full sm:w-32 bg-canvas shadow-sm" placeholder="IP address" id="banip-ip">
        <input class="input input-sm w-full sm:w-40 bg-canvas shadow-sm" placeholder="Reason (optional)" id="banip-reason">
        <input class="input input-sm w-full sm:w-32 bg-canvas shadow-sm" placeholder="Linked player" id="banip-player" list="banip-player-list" autocomplete="off" data-tip="Optional. Tags this ban with the player it belongs to.">
        <datalist id="banip-player-list">
          {{#each players}}<option value="{{name}}">{{/each}}
        </datalist>
        <select class="input input-sm w-full sm:w-auto bg-canvas shadow-sm" id="banip-duration" data-label="Ban duration">
          <option value="">Permanent</option>
          <option value="3600000">1 Hour</option>
          <option value="86400000">1 Day</option>
          <option value="259200000">3 Days</option>
          <option value="604800000">7 Days</option>
          <option value="2592000000">30 Days</option>
        </select>
        <button class="btn btn-sm btn-primary shadow-sm w-full sm:w-auto" id="banip-add">{{{icon 'ban' 'size-3.5'}}} Ban IP</button>
      </div>
    </div>
    {{! Both branches stay in the DOM so bans/pardons can swap them in place. }}
    <div class="overflow-x-auto {{#unless bannedIps.length}}hidden{{/unless}}" id="banip-table">
      <table class="table-base table-stack w-full text-sm">
        <thead class="bg-canvas/50">
          <tr class="text-[10px] uppercase tracking-widest text-ink-faint border-b border-line/30">
            <th class="font-bold py-3 pl-5">IP</th>
            <th class="font-bold py-3">Player</th>
            <th class="font-bold py-3">Reason</th>
            <th class="font-bold py-3">Date</th>
            <th class="font-bold py-3">Expires</th>
            <th class="text-right font-bold py-3 pr-5">Actions</th>
          </tr>
        </thead>
        <tbody id="banip-rows" class="divide-y divide-line/30">
          {{#each bannedIps}}
            <tr class="hover:bg-inset/10 transition-colors group" data-banip-row="{{ip}}">
              <td data-th="IP" class="p-3 pl-5 font-mono text-xs font-bold text-ink"><span class="bg-inset/30 px-1.5 py-0.5 rounded border border-line/30">{{ip}}</span></td>
              <td data-th="Player" class="p-3 text-[11px] font-medium text-ink-soft">{{default player '<span class="opacity-50">-</span>'}}</td>
              <td data-th="Reason" class="p-3 text-[11px] font-medium text-ink-soft">{{default reason '<span class="opacity-50">-</span>'}}</td>
              <td data-th="Date" class="p-3 text-[11px] font-medium text-ink-faint">{{default created '<span class="opacity-50">-</span>'}}</td>
              <td data-th="Expires" class="p-3 text-[11px] font-medium text-ink-faint">{{#if (eq expires 'forever')}}<span class="badge bg-inset/50 border border-line/50 text-[9px] uppercase tracking-wider">Permanent</span>{{else}}{{expires}}{{/if}}</td>
              <td data-th="" class="p-3 sm:text-right pr-5">
                <div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap sm:opacity-0 group-hover:opacity-100 transition-opacity">
                  <button class="btn btn-ghost btn-sm text-danger hover:bg-danger/10 rounded-full size-8 p-0 grid place-items-center" data-act="pardon-ip" data-ip="{{ip}}" data-tip="Remove this IP ban.">{{{icon 'x' 'size-4'}}}</button>
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    <div class="p-8 text-center text-[11px] font-medium text-ink-faint bg-canvas {{#if bannedIps.length}}hidden{{/if}}" id="banip-empty">
      No banned IPs.
    </div>
  </div>
</div>

<script type="application/json" id="players-data">{{jsonScript players}}</script>
<script type="module" src="/js/pages/players.js"></script>
