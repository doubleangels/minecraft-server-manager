{{> page-header heading="FILE MANAGER" sub="The whole panel data folder: servers, backups, library, and logs. Admins only, and the panel's own database is protected."}}

<div data-files-global data-files-path="{{filePath}}" class="contents">
  <div class="card overflow-hidden">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-line/50 bg-inset/10 p-4">
      <nav class="flex min-w-0 flex-wrap items-center gap-1.5 font-mono text-sm font-bold text-ink-soft bg-canvas px-3 py-1.5 rounded-lg border border-line/30 shadow-inner" aria-label="Breadcrumb">
        {{{icon 'hard-drive' 'size-4 text-link mr-1'}}}
        {{#if crumbs.length}}
          <a class="hover:text-link transition-colors" href="/files">data</a>
          {{#each crumbs}}
            <span class="text-ink-faint">/</span>
            {{#if @last}}
              <span class="truncate text-ink">{{name}}</span>
            {{else}}
              <a class="hover:text-link transition-colors" href="/files?path={{enc}}">{{name}}</a>
            {{/if}}
          {{/each}}
        {{else}}
          <span class="text-ink">data</span>
        {{/if}}
      </nav>
      <div class="flex flex-wrap gap-2 sm:ml-auto w-full sm:w-auto">
        <button class="btn btn-sm bg-canvas border-line/50 shadow-sm hover:bg-inset/30 flex-1 sm:flex-none justify-center" id="files-search" data-tip="Search the text of files under this folder.">{{{icon 'search' 'size-4'}}} Find</button>
        <button class="btn btn-sm btn-primary shadow-sm flex-1 sm:flex-none justify-center" id="files-upload">{{{icon 'upload' 'size-4'}}} Upload</button>
        <button class="btn btn-sm bg-canvas border-line/50 shadow-sm hover:bg-inset/30 flex-1 sm:flex-none justify-center" id="files-mkdir">{{{icon 'folder-plus' 'size-4'}}} Folder</button>
      </div>
    </div>
    
    <div class="overflow-x-auto">
      <table class="table-base table-stack w-full text-sm" id="files-table">
        <thead class="bg-canvas/50">
          <tr class="text-[10px] uppercase tracking-widest text-ink-faint">
            <th class="font-bold py-3 pl-5">Name</th>
            <th class="text-right font-bold py-3">Size</th>
            <th class="text-right font-bold py-3">Modified</th>
            <th class="text-right font-bold py-3 pr-5">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line/30">
          {{#if filePath}}
            <tr class="hover:bg-inset/10 transition-colors">
              <td data-th="" colspan="4" class="p-3 pl-5">
                <a class="inline-flex items-center gap-2 text-[11px] font-bold text-ink-faint hover:text-ink transition-colors bg-inset/30 px-2 py-1 rounded border border-line/30" href="/files{{#if parentEnc}}?path={{parentEnc}}{{/if}}">{{{icon 'corner-left-up' 'size-3.5'}}} Back</a>
              </td>
            </tr>
          {{/if}}
          {{#each files}}
            <tr class="hover:bg-inset/10 transition-colors group" data-file-row data-path="{{path}}" data-name="{{name}}" data-dir="{{dir}}" data-size="{{size}}">
              {{! w-full + max-w-0 (sm+ only): makes `truncate` actually engage in an
                  auto-layout table - long names no longer force horizontal scroll. }}
              <td data-th="Name" class="sm:w-full sm:max-w-0 p-3 pl-5">
                <div class="flex items-center gap-3">
                  {{#if dir}}
                    <span class="grid size-8 place-items-center rounded bg-warn/10 border border-warn/30 shrink-0 text-warn-strong shadow-inner">{{{icon 'folder' 'size-4'}}}</span>
                    <a class="min-w-0 truncate font-bold text-ink hover:text-link transition-colors" href="/files?path={{enc}}" title="{{name}}">{{name}}</a>
                  {{else}}
                    <span class="grid size-8 place-items-center rounded bg-inset/30 border border-line/50 shrink-0 text-ink-faint shadow-inner">{{{icon 'file-text' 'size-4'}}}</span>
                    <span class="min-w-0 truncate font-bold text-ink-soft" title="{{name}}">{{name}}</span>
                  {{/if}}
                </div>
              </td>
              <td data-th="Size" class="whitespace-nowrap sm:text-right font-bold tabular-nums text-ink-soft p-3">{{#if dir}}<span class="text-ink-faint font-medium">—</span>{{else}}{{bytes size}}{{/if}}</td>
              <td data-th="Modified" class="whitespace-nowrap sm:text-right text-[11px] font-medium text-ink-faint p-3" data-ts="{{mtime}}">{{mtime}}</td>
              <td data-th="" class="sm:text-right p-3 pr-5">
                <div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap sm:opacity-0 group-hover:opacity-100 transition-opacity">
                  {{#unless dir}}
                    <button class="btn btn-ghost btn-sm text-ink-faint hover:text-ink hover:bg-inset/30 rounded-full size-8 p-0 grid place-items-center" data-file-edit data-tip="Edit as text (≤ 8 MB).">{{{icon 'file-code' 'size-4'}}}</button>
                    <button class="btn btn-ghost btn-sm text-ink-faint hover:text-ink hover:bg-inset/30 rounded-full size-8 p-0 grid place-items-center" data-file-download data-tip="Download the file.">{{{icon 'download' 'size-4'}}}</button>
                  {{/unless}}
                  <button class="btn btn-ghost btn-sm text-ink-faint hover:text-ink hover:bg-inset/30 rounded-full size-8 p-0 grid place-items-center" data-menu="file-menu-{{@index}}" data-tip="Rename, move, or copy this file.">{{{icon 'ellipsis' 'size-4'}}}</button>
                  <template id="file-menu-{{@index}}">
                    <button data-file-rename data-path="{{path}}" data-name="{{name}}">{{{icon 'pencil' 'size-3.5'}}} Rename</button>
                    <button data-file-move data-path="{{path}}" data-name="{{name}}">{{{icon 'move' 'size-3.5'}}} Move to…</button>
                    <button data-file-copy data-path="{{path}}" data-name="{{name}}">{{{icon 'copy' 'size-3.5'}}} Copy to…</button>
                  </template>
                  <button class="btn btn-ghost btn-sm text-danger hover:bg-danger/10 rounded-full size-8 p-0 grid place-items-center" data-file-delete data-tip="Delete this file ({{bytes size}})." aria-label="Delete {{name}}">{{{icon 'trash-2' 'size-4'}}}</button>
                </div>
              </td>
            </tr>
          {{else}}
            <tr data-files-empty><td data-th="" colspan="4" class="py-12 text-center text-sm text-ink-faint">
              <span class="grid size-12 place-items-center rounded-full bg-inset/30 border border-line/30 shadow-inner mx-auto mb-3">{{{icon 'folder-open' 'size-6 opacity-50'}}}</span>
              <p class="font-medium">This folder is empty. Upload files or create a folder above.</p>
            </td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  <p class="mt-4 flex items-start gap-2 bg-danger/10 text-danger p-3 rounded-lg border border-danger/30 max-w-prose text-xs font-medium shadow-sm">
    {{{icon 'shield-alert' 'size-4 shrink-0'}}}
    <span>Be careful: this is the panel's entire data folder. Deleting server or backup files here skips the usual safeguards.</span>
  </p>
</div>
<script type="module" src="/js/pages/files-global.js"></script>
