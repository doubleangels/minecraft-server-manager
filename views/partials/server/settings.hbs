<div class="grid gap-5 lg:grid-cols-2" data-settings-server="{{server.id}}" data-settings-icon="{{server.icon}}" data-settings-accent="{{server.accent}}" data-settings-tags="{{jsonAttr server.tags}}" data-settings-env="{{settingsEnv}}" data-settings-docker-name="{{server.containerName}}" data-settings-docker-network="{{server.networkName}}" data-settings-docker-ports="{{jsonAttr server.extraPorts}}" data-settings-docker-binds="{{jsonAttr server.extraBinds}}">
  <div class="card overflow-hidden shadow-sm flex flex-col">
    <div class="border-b border-line/50 bg-inset/10 p-5 font-bold tracking-wide text-sm flex items-center gap-2">
      {{{icon 'fingerprint' 'size-4 text-link'}}} Identity
    </div>
    <div class="p-5 sm:p-6 bg-canvas flex-1 space-y-5">
      <div>
        <label class="label" for="st-name">Display name</label>
        <input class="input" id="st-name" value="{{server.name}}">
        <p class="help">Rename it freely. Folders, container names, and history all stay keyed to the internal ID.</p>
      </div>
      <div>
        <label class="label" for="st-desc">Description</label>
        <textarea class="input" id="st-desc" rows="3">{{server.description}}</textarea>
        <p class="help">Markdown supported; shown on the Overview tab.</p>
      </div>
      <div>
        <label class="label" for="st-motd">MOTD <span class="text-xs font-normal text-ink-faint">(shown in every player's server list)</span></label>
        <input class="input font-mono" id="st-motd" value="{{motd}}" autocomplete="off">
        <div class="console mt-2 py-2 text-sm" id="st-motd-preview"></div>
        <p class="help">Applies on the next restart.</p>
      </div>
      {{! Both pickers use ONE selection language: aria-pressed + the theme-aware
          .swatch ring (the old white ring was invisible on the light theme, and
          the icon picker used a different green-border treatment one row over).
          The current stock icon is marked in place - no duplicate "current" tile. }}
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <span class="label">Icon</span>
          <div class="flex flex-wrap gap-1.5" id="st-icon-picker">
            {{#if (startsWith server.icon 'custom:')}}
              <button class="swatch grid size-9 place-items-center p-1 shadow-sm" style="background: {{server.accent}}" data-pick-icon="{{server.icon}}" data-tip="Current custom icon." aria-pressed="true"><img src="{{iconSrc server.icon}}" alt="" class="size-full rounded-sm" data-fallback-icon="/icons/servers/grass.svg"></button>
            {{/if}}
            <button class="swatch grid size-9 place-items-center p-1 shadow-sm" style="background: {{server.accent}}" data-pick-icon="grass" aria-pressed="{{eq server.icon 'grass'}}"><img src="/icons/servers/grass.svg" alt="Grass block" class="size-full rounded-sm"></button>
            <button class="swatch grid size-9 place-items-center p-1 shadow-sm" style="background: {{server.accent}}" data-pick-icon="creeper" aria-pressed="{{eq server.icon 'creeper'}}"><img src="/icons/servers/creeper.svg" alt="Creeper" class="size-full rounded-sm"></button>
            <button class="swatch grid size-9 place-items-center p-1 shadow-sm" style="background: {{server.accent}}" data-pick-icon="diamond" aria-pressed="{{eq server.icon 'diamond'}}"><img src="/icons/servers/diamond.svg" alt="Diamond" class="size-full rounded-sm"></button>
            <button class="swatch grid size-9 place-items-center p-1 shadow-sm" style="background: {{server.accent}}" data-pick-icon="portal" aria-pressed="{{eq server.icon 'portal'}}"><img src="/icons/servers/portal.svg" alt="Nether portal" class="size-full rounded-sm"></button>
            <button class="swatch grid size-9 place-items-center p-1 shadow-sm" style="background: {{server.accent}}" data-pick-icon="chest" aria-pressed="{{eq server.icon 'chest'}}"><img src="/icons/servers/chest.svg" alt="Chest" class="size-full rounded-sm"></button>
            <button class="swatch grid size-9 place-items-center p-1 shadow-sm" style="background: {{server.accent}}" data-pick-icon="sword" aria-pressed="{{eq server.icon 'sword'}}"><img src="/icons/servers/sword.svg" alt="Sword" class="size-full rounded-sm"></button>
            <button class="swatch grid size-9 place-items-center p-1 shadow-sm" style="background: {{server.accent}}" data-pick-icon="potion" aria-pressed="{{eq server.icon 'potion'}}"><img src="/icons/servers/potion.svg" alt="Potion" class="size-full rounded-sm"></button>
            <button class="swatch grid size-9 place-items-center p-1 shadow-sm" style="background: {{server.accent}}" data-pick-icon="tnt" aria-pressed="{{eq server.icon 'tnt'}}"><img src="/icons/servers/tnt.svg" alt="TNT" class="size-full rounded-sm"></button>
            <button class="grid size-9 place-items-center rounded bg-inset/30 border border-line/50 text-ink-faint transition hover:bg-inset/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link" id="st-icon-upload" data-tip="Upload a custom icon (PNG/SVG).">{{{icon 'upload' 'size-4'}}}</button>
          </div>
        </div>
        <div>
          <span class="label">Accent color</span>
          {{! Amethyst is a deliberate off-ramp from the four semantic ramps -
              it's identity decoration from Minecraft source material, not meaning. }}
          <div class="flex flex-wrap items-center gap-1.5" id="st-accent-picker">
            <button class="swatch size-9 shadow-sm" style="background: #3fa62b" data-pick-accent="#3fa62b" data-tip="Grass" aria-pressed="false"></button>
            <button class="swatch size-9 shadow-sm" style="background: #21a7ab" data-pick-accent="#21a7ab" data-tip="Diamond" aria-pressed="false"></button>
            <button class="swatch size-9 shadow-sm" style="background: #e5484d" data-pick-accent="#e5484d" data-tip="Redstone" aria-pressed="false"></button>
            <button class="swatch size-9 shadow-sm" style="background: #e99417" data-pick-accent="#e99417" data-tip="Gold" aria-pressed="false"></button>
            <button class="swatch size-9 shadow-sm" style="background: #9a5cc6" data-pick-accent="#9a5cc6" data-tip="Amethyst" aria-pressed="false"></button>
          </div>
        </div>
      </div>
      <div>
        <label class="label" for="st-tag-input">Tags</label>
        {{! Chips are rendered by server-settings.js from data-settings-tags - no server copy, or they double up. }}
        <div class="flex flex-wrap items-center gap-1.5" id="st-tags">
          <input class="input w-32" id="st-tag-input" placeholder="add tag…">
        </div>
      </div>
      <div>
        <label class="label" for="st-notes">Private notes <span class="badge bg-inset/50 border border-line/50 text-[9px] uppercase tracking-wider ml-1">admin only</span></label>
        <textarea class="input font-mono text-xs" id="st-notes" rows="2" placeholder="Scratchpad, never shown to viewers">{{server.notes}}</textarea>
      </div>
      <div class="space-y-3 border-t border-line/50 pt-4 mt-2">
        <label class="flex items-center justify-between gap-4 text-sm bg-inset/30 p-3 rounded-lg border border-line/30 shadow-inner">
          <span class="font-bold text-ink-soft">Start on panel boot</span>
          <span class="msm-toggle"><input type="checkbox" id="st-autostart" {{#if server.autoStart}}checked{{/if}}><span></span></span>
        </label>
        <label class="flex items-center justify-between gap-4 text-sm bg-inset/30 p-3 rounded-lg border border-line/30 shadow-inner">
          <span class="font-bold text-ink-soft">Auto-restart on crash <span class="block text-xs font-medium text-ink-faint mt-1">Waits longer between each try, and gives up after 3 rapid crashes.</span></span>
          <span class="msm-toggle"><input type="checkbox" id="st-autorestart" {{#if server.autoRestart}}checked{{/if}}><span></span></span>
        </label>
      </div>
    </div>
  </div>

  <div class="space-y-5">
    <div class="card overflow-hidden shadow-sm">
      <div class="border-b border-line/50 bg-inset/10 p-5 font-bold tracking-wide text-sm flex items-center gap-2">
        {{{icon 'cpu' 'size-4 text-link'}}} Resources
      </div>
      <div class="p-5 sm:p-6 bg-canvas space-y-5">
        <div>
          <label class="label" for="st-heap">Java heap</label>
          <div class="flex items-center gap-4">
            <input type="range" min="1024" max="16384" step="512" value="{{server.resources.heapMb}}" id="st-heap" class="msm-range flex-1" data-out="out-heap" data-unit=" MB">
            <span class="w-24 text-right font-mono text-sm font-bold bg-inset/30 border border-line/30 px-2 py-1 rounded shadow-inner" id="out-heap">{{server.resources.heapMb}} MB</span>
          </div>
          <p class="help">The amount of RAM Minecraft itself may use.</p>
        </div>
        <div>
          <label class="label" for="st-cmem">Container memory limit</label>
          <div class="flex items-center gap-4">
            <input type="range" min="1024" max="20480" step="512" value="{{server.resources.containerMemoryMb}}" id="st-cmem" class="msm-range flex-1" data-out="out-cmem" data-unit=" MB">
            <span class="w-24 text-right font-mono text-sm font-bold bg-inset/30 border border-line/30 px-2 py-1 rounded shadow-inner" id="out-cmem">{{server.resources.containerMemoryMb}} MB</span>
          </div>
          <p class="help">The hard limit Docker enforces. Keep it 25% to 50% above the Java heap: Java needs extra room beyond the heap, and if the server reaches this limit it is stopped for running out of memory.</p>
        </div>
        <div class="rounded-lg border border-line/50 bg-inset/10 p-3 text-xs font-medium" id="st-headroom" aria-live="polite"></div>
        <div>
          <label class="label" for="st-cpu">CPU limit</label>
          <div class="flex items-center gap-4">
            <input type="range" min="0" max="16" step="0.5" value="{{server.resources.cpus}}" id="st-cpu" class="msm-range msm-range-alt flex-1" data-out="out-cpu" data-unit=" cores" data-zero="∞">
            <span class="w-24 text-right font-mono text-sm font-bold bg-inset/30 border border-line/30 px-2 py-1 rounded shadow-inner" id="out-cpu">{{#if server.resources.cpus}}{{server.resources.cpus}} cores{{else}}∞{{/if}}</span>
          </div>
          <p class="help">0 means unlimited. When capped, the server slows down instead of being stopped.</p>
        </div>
        <div>
          <label class="label" for="st-quota">Disk quota <span class="badge bg-inset/50 border border-line/50 text-[9px] uppercase tracking-wider ml-1">panel-enforced</span></label>
          <div class="flex items-center gap-4">
            <input type="range" min="0" max="200" step="5" value="{{quotaGb}}" id="st-quota" class="msm-range flex-1" data-out="out-quota" data-unit=" GB" data-zero="off">
            <span class="w-24 text-right font-mono text-sm font-bold bg-inset/30 border border-line/30 px-2 py-1 rounded shadow-inner" id="out-quota">{{quotaGb}} GB</span>
          </div>
          <p class="help">The panel enforces this quota itself, since Docker can't limit disk use for this kind of storage. Over quota, actions that would grow the disk are blocked, and an optional strict mode stops the server.</p>
        </div>
      </div>
    </div>

    {{#if server.packUnpinned}}
    <div class="notice notice-warn max-w-prose text-sm font-medium leading-relaxed shadow-sm">
      <b>This modpack has no pinned version.</b> The container downloads the newest pack version every time it
      starts. That can silently change your mods and even your world's Minecraft version. Open the
      <b>Modpack</b> section and pick the version you're running to lock it in.
    </div>
    {{/if}}

    <div class="card overflow-hidden shadow-sm">
      <div class="border-b border-line/50 bg-inset/10 p-5 font-bold tracking-wide text-sm flex items-center gap-2">
        {{{icon 'arrow-up-circle' 'size-4 text-link'}}} Update Policy
      </div>
      <div class="p-5 sm:p-6 bg-canvas space-y-3 text-sm font-medium">
        <label class="flex items-center gap-3 bg-inset/30 p-3 rounded-lg border border-line/30 cursor-pointer hover:bg-inset/50 transition-colors"><input type="radio" name="up" value="manual" class="msm-radio mt-0.5" {{#if (eq server.updatePolicy 'manual')}}checked{{/if}}> <div><span class="font-bold text-ink-soft block">Manual Only</span> <span class="text-xs text-ink-faint mt-0.5 block">never changes anything, and no update badges for this server</span></div></label>
        <label class="flex items-center gap-3 bg-inset/30 p-3 rounded-lg border border-line/30 cursor-pointer hover:bg-inset/50 transition-colors"><input type="radio" name="up" value="notify" class="msm-radio mt-0.5" {{#if (eq server.updatePolicy 'notify')}}checked{{/if}}> <div><span class="font-bold text-ink-soft block">Notify Me</span> <span class="text-xs text-ink-faint mt-0.5 block">show a badge when updates exist; you apply them</span></div></label>
        <label class="flex items-center gap-3 bg-inset/30 p-3 rounded-lg border border-line/30 cursor-pointer hover:bg-inset/50 transition-colors"><input type="radio" name="up" value="auto" class="msm-radio mt-0.5" {{#if (eq server.updatePolicy 'auto')}}checked{{/if}}> <div><span class="font-bold text-ink-soft block">Auto-Update</span> <span class="text-xs text-ink-faint mt-0.5 block leading-relaxed">applies pack updates after the daily check: pre-update backup, health check, automatic rollback on failure, but never across Minecraft versions.</span></div></label>
      </div>
    </div>

    {{! Admin-only: same gate as the wizard's Advanced Docker settings - the
        API 403s these fields for other roles. }}
    {{#if (eq user.role 'admin')}}
    <div class="card overflow-hidden shadow-sm border border-danger/20">
      <div class="border-b border-danger/20 bg-danger/5 p-5 font-bold tracking-wide text-sm flex items-center gap-2 text-danger-strong">
        {{{icon 'shield-alert' 'size-4'}}} Advanced Docker Settings
      </div>
      <div class="p-5 sm:p-6 bg-canvas space-y-5">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="label" for="st-docker-name">Container name</label>
            <input class="input font-mono" id="st-docker-name" value="{{server.containerName}}" placeholder="msm-{{server.id}}" autocomplete="off">
          </div>
          <div>
            <label class="label" for="st-docker-network">Docker network</label>
            <input class="input font-mono" id="st-docker-network" list="st-docker-networks" placeholder="Default (bridge)" autocomplete="off">
            <datalist id="st-docker-networks"></datalist>
          </div>
        </div>

        <div>
          <div class="mb-2 flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-ink-faint">Extra port mappings</span>
            <button type="button" class="btn btn-sm btn-ghost border border-line/50 shadow-sm" id="st-docker-port-add">{{{icon 'plus' 'size-3.5'}}} Add Port</button>
          </div>
          <div class="space-y-2 bg-inset/10 p-3 rounded-lg border border-line/30 empty:hidden" id="st-docker-ports"></div>
          <p class="help">For example, UDP 19132 for Bedrock or Geyser, or TCP 8100 for BlueMap.</p>
        </div>

        <div>
          <div class="mb-2 flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-ink-faint">Extra volume binds</span>
            <button type="button" class="btn btn-sm btn-ghost border border-line/50 shadow-sm" id="st-docker-bind-add">{{{icon 'plus' 'size-3.5'}}} Add Bind</button>
          </div>
          <div class="space-y-2 bg-inset/10 p-3 rounded-lg border border-line/30 empty:hidden" id="st-docker-binds"></div>
          <p class="help">Free-form host paths. The panel already has root-equivalent access through the Docker socket, so double-check these.</p>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-t border-line/50 pt-4 mt-2">
          <p class="text-[11px] font-bold uppercase tracking-wider text-ink-faint m-0">Takes effect after rebuild.</p>
          <button type="button" class="btn shrink-0 bg-canvas border-line/50 shadow-sm" id="st-docker-preview">{{{icon 'file-code' 'size-4'}}} Preview as YAML</button>
        </div>
      </div>
    </div>
    {{/if}}

    <div class="card overflow-hidden shadow-sm">
      <div class="border-b border-line/50 bg-inset/10 p-5 font-bold tracking-wide text-sm flex items-center gap-2">
        {{{icon 'wrench' 'size-4 text-link'}}} Blueprint &amp; Maintenance
      </div>
      <div class="p-5 sm:p-6 bg-canvas">
        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-2">
          <button class="btn bg-canvas border-line/50 shadow-sm flex-1 sm:flex-none justify-center" id="st-export-bp">{{{icon 'drafting-compass' 'size-4'}}} Blueprint</button>
          <button class="btn bg-canvas border-line/50 shadow-sm flex-1 sm:flex-none justify-center" id="st-clone">{{{icon 'copy' 'size-4'}}} Clone Server</button>
          <button class="btn btn-primary shadow-sm flex-1 sm:flex-none justify-center{{#unless perms.power}} hidden{{/unless}}" data-server-action="recreate" data-server-id="{{server.id}}" data-server-name="{{server.name}}" data-tip="Applies pending settings and resource changes.">{{{icon 'wrench' 'size-4'}}} Rebuild</button>
        </div>
        {{! Destruction lives behind its own divider, never one accidental click
            from the safe maintenance actions above. }}
        <div class="mt-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-t border-line/50 pt-5{{#unless perms.delete}} hidden{{/unless}}">
          <p class="text-[11px] font-medium leading-relaxed text-ink-faint">Removes the server from the panel. Files and backups are kept on disk by default; tick &quot;also delete files and backups&quot; in the confirmation to remove them.</p>
          <button class="btn btn-danger shrink-0 shadow-sm" data-server-action="delete" data-server-id="{{server.id}}" data-server-name="{{server.name}}">{{{icon 'trash-2' 'size-4'}}} Delete Server</button>
        </div>
      </div>
    </div>
  </div>

  {{#if advancedSections.length}}
  <div class="space-y-4 lg:col-span-2" id="st-advanced">
    <div class="notice notice-info text-xs font-medium leading-relaxed shadow-sm">
      {{{icon 'info' 'size-4 mt-0.5 shrink-0 text-link'}}}
      <div>Every environment variable this server's image supports, taken straight from its documentation. It's the same list as the create wizard's Advanced mode, pre-filled with what's currently set. Leave a field empty to use that variable's default; only values you change are sent. Takes effect after the container is rebuilt.</div>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {{#each advancedSections}}
        <details class="card overflow-hidden shadow-sm group bg-canvas">
          <summary class="flex cursor-pointer items-center gap-3 p-4 font-bold text-sm marker:content-none hover:bg-inset/10 transition-colors">
            <span class="grid size-6 place-items-center rounded bg-inset/50 border border-line/50 shadow-inner shrink-0">{{{icon icon 'size-3.5 text-link'}}}</span>
            {{label}}
            <span class="badge bg-inset/50 border border-line/50 text-[9px] uppercase tracking-wider ml-1">{{fields.length}}</span>
            <span class="ml-auto text-ink-faint transition group-open:rotate-180 bg-canvas border border-line/50 rounded-full size-6 grid place-items-center shadow-sm">{{{icon 'chevron-down' 'size-3.5'}}}</span>
          </summary>
          <div class="divide-y divide-line/30 border-t border-line/50 bg-inset/5 p-4">
            {{#each fields}}
              {{> catalog-field}}
            {{/each}}
          </div>
        </details>
      {{/each}}
    </div>
  </div>
  {{/if}}
</div>

<div class="mt-4 flex justify-end gap-2">
  <button class="btn" id="st-discard">Discard</button>
  <button class="btn btn-primary" id="st-save">Save Changes</button>
</div>

<script type="module" src="/js/pages/server-settings.js"></script>
