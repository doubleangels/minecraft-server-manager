{{> page-header heading="HEALTH" sub="Crashes, out-of-memory stops, and auto-restarts from the last 24 hours. Dismissing an alert hides it for you only and keeps it in each server's history."}}

<div id="health-page">
  {{#if alerts.length}}
    <div class="mb-6 grid grid-cols-1 sm:grid-cols-3 gap-4" data-health-summary>
      <div class="bg-danger/10 border border-danger/20 rounded-xl p-4 flex flex-col items-center justify-center text-center transition hover:scale-105">
        <div class="text-[10px] font-bold uppercase tracking-widest text-danger mb-1 flex items-center gap-1.5">{{{icon 'triangle-alert' 'size-3.5'}}} Crashes</div>
        <div class="text-3xl font-bold tabular-nums text-danger">{{counts.crashes}}</div>
      </div>
      <div class="bg-danger/10 border border-danger/20 rounded-xl p-4 flex flex-col items-center justify-center text-center transition hover:scale-105">
        <div class="text-[10px] font-bold uppercase tracking-widest text-danger mb-1 flex items-center gap-1.5">{{{icon 'memory-stick' 'size-3.5'}}} Out of Memory</div>
        <div class="text-3xl font-bold tabular-nums text-danger">{{counts.oom}}</div>
      </div>
      <div class="bg-warn/10 border border-warn/20 rounded-xl p-4 flex flex-col items-center justify-center text-center transition hover:scale-105">
        <div class="text-[10px] font-bold uppercase tracking-widest text-warn mb-1 flex items-center gap-1.5">{{{icon 'refresh-cw' 'size-3.5'}}} Auto-Restarts</div>
        <div class="text-3xl font-bold tabular-nums text-warn">{{counts.autoRestarted}}</div>
      </div>
    </div>
    
    <div class="mb-4 flex items-center justify-between">
      <h2 class="font-bold text-lg tracking-wide flex items-center gap-2">{{{icon 'activity' 'size-5 text-ink-soft'}}} Alerts Log</h2>
      <button type="button" class="btn btn-danger btn-sm shadow-sm" data-clear-all>Clear All</button>
    </div>

    <ul class="card divide-y divide-line/30 p-0 overflow-hidden" data-alert-list>
      {{#each alerts}}
        <li class="flex flex-col gap-3 p-4 sm:flex-row sm:items-start sm:p-5 hover:bg-inset/10 transition-colors" data-alert-id="{{id}}">
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
              {{#if (eq type 'crashed')}}<span class="badge badge-danger bg-danger/15 text-danger border border-danger/30 uppercase text-[10px] tracking-wider py-0.5 px-2">Crash</span>
              {{else if (eq type 'oom')}}<span class="badge badge-danger bg-danger/15 text-danger border border-danger/30 uppercase text-[10px] tracking-wider py-0.5 px-2">Out of Memory</span>
              {{else}}<span class="badge badge-warn bg-warn/15 text-warn border border-warn/30 uppercase text-[10px] tracking-wider py-0.5 px-2">Auto-Restart</span>{{/if}}
              
              {{#if serverId}}<a href="/servers/{{serverId}}" class="truncate font-bold text-base text-ink hover:text-link transition-colors">{{server}}</a>{{else}}<span class="truncate font-bold text-base text-ink-faint">A removed server</span>{{/if}}
              <span class="text-[11px] font-medium text-ink-faint bg-inset/50 px-2 py-0.5 rounded-md ml-auto sm:ml-0" data-ts-ago="{{at}}">{{at}}</span>
            </div>
            
            <p class="mt-2.5 break-words text-sm font-medium text-ink-soft bg-inset/20 p-2.5 rounded-lg border border-line/30">{{summary}}</p>
            
            {{#if (eq type 'crashed')}}
              <dl class="mt-3 grid gap-x-4 gap-y-2 text-xs sm:grid-cols-[max-content_1fr] bg-danger/5 p-3 rounded-lg border border-danger/10">
                {{#if exitCode}}<dt class="font-bold text-ink-soft uppercase tracking-wider text-[10px]">Exit Code</dt><dd class="font-mono font-bold text-ink">{{exitCode}}</dd>{{/if}}
                <dt class="font-bold text-ink-soft uppercase tracking-wider text-[10px]">Auto-Restart</dt>
                <dd class="font-medium">{{#if willRestart}}The panel will restart it automatically.{{else}}It will not restart on its own.{{/if}}</dd>
                {{#if report}}
                  {{#if report.exception}}<dt class="font-bold text-ink-soft uppercase tracking-wider text-[10px] mt-1">Error</dt><dd class="break-words font-medium mt-1">{{report.exception}}</dd>{{/if}}
                  {{#if report.suspects.length}}<dt class="font-bold text-ink-soft uppercase tracking-wider text-[10px] mt-1">Suspected Mods</dt><dd class="break-words font-medium mt-1">{{#each report.suspects}}<span class="chip text-[10px] bg-canvas border-line/50">{{this}}</span>{{#unless @last}} {{/unless}}{{/each}}</dd>{{/if}}
                  <dt class="font-bold text-ink-soft uppercase tracking-wider text-[10px] mt-1">Crash Report</dt><dd class="break-all font-mono text-[10px] mt-1">{{report.filename}}</dd>
                {{/if}}
              </dl>
            {{/if}}
            
            {{#if serverId}}
              <div class="mt-4 flex flex-wrap gap-2 text-xs font-bold">
                <a class="btn btn-sm bg-inset/30 hover:bg-inset/50 text-ink-soft border border-line/50" href="/servers/{{serverId}}/history">{{{icon 'history' 'size-3.5'}}} Open History</a>
                {{#if hasLog}}<a class="btn btn-sm bg-inset/30 hover:bg-inset/50 text-ink-soft border border-line/50" href="/api/events/{{id}}/excerpt" target="_blank" rel="noopener">{{{icon 'file-text' 'size-3.5'}}} View Log</a>{{/if}}
              </div>
            {{/if}}
          </div>
          <button type="button" class="btn btn-ghost btn-sm shrink-0 self-start text-ink-faint hover:text-danger hover:bg-danger/10" data-dismiss aria-label="Dismiss this alert">Dismiss</button>
        </li>
      {{/each}}
    </ul>
    {{#if (gt counts.total alerts.length)}}
      <p class="mt-3 text-[11px] font-medium text-ink-faint text-center">Showing the newest {{alerts.length}} of {{counts.total}} alerts. Dismiss some to see the rest.</p>
    {{/if}}
  {{else}}
    {{> empty-state iconName='activity' title='No Alerts' message='No server has crashed, run out of memory, or needed an automatic restart in the last 24 hours, or you have dismissed them all.'}}
  {{/if}}
</div>
<script type="module" src="/js/pages/health.js"></script>
