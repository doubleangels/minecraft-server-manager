{{#unless serversOnly}}{{> page-header heading="DASHBOARD" sub="Every server at a glance: status, resource use, and the latest activity across the panel."}}{{/unless}}

{{! Blocking problems first: nothing below works without Docker. }}
<div id="docker-warning" class="notice notice-danger mb-4 hidden">
  {{{icon 'triangle-alert' 'size-4 mt-0.5 shrink-0 text-danger'}}}
  <div>
    <span class="font-semibold text-danger">Docker isn't reachable.</span>
    <span id="docker-warning-reason">Start Docker, then refresh. Creating or starting servers needs Docker running.</span>
  </div>
</div>

{{! Update counts live in the Updates card below (with the mod/server split),
    so this row is just people + infrastructure. }}
<div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-3 {{#if serversOnly}}hidden{{/if}}">
  <div class="card p-4">
    <div class="text-xs text-ink-faint">Servers online</div>
    {{! Green only when something IS online - 0/3 in success green lied. }}
    <div class="mt-1 text-2xl font-bold tabular-nums {{#if totals.running}}text-ok{{/if}}">{{totals.running}}<span class="text-base font-medium text-ink-faint"> / {{totals.total}}</span></div>
    {{! The status breakdown, folded in here instead of its own row. }}
    <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs text-ink-faint">
      {{#if overview.byStatus.starting}}<span class="flex items-center gap-1"><span class="status-dot bg-gold-500"></span>{{overview.byStatus.starting}} starting</span>{{/if}}
      {{#if overview.byStatus.unhealthy}}<span class="flex items-center gap-1"><span class="status-dot bg-gold-500"></span>{{overview.byStatus.unhealthy}} unhealthy</span>{{/if}}
      {{#if overview.byStatus.stalled}}<span class="flex items-center gap-1"><span class="status-dot bg-redstone-500"></span>{{overview.byStatus.stalled}} stalled</span>{{/if}}
      {{#if overview.byStatus.updating}}<span class="flex items-center gap-1"><span class="status-dot bg-diamond-500"></span>{{overview.byStatus.updating}} updating</span>{{/if}}
      {{#if overview.byStatus.crashed}}<span class="flex items-center gap-1"><span class="status-dot bg-redstone-500"></span>{{overview.byStatus.crashed}} crashed</span>{{/if}}
      {{#if overview.byStatus.stopped}}<span class="flex items-center gap-1"><span class="status-dot bg-stone-500"></span>{{overview.byStatus.stopped}} stopped</span>{{/if}}
    </div>
  </div>
  <div class="card p-4">
    <div class="text-xs text-ink-faint">Players connected</div>
    <div class="mt-1 text-2xl font-bold tabular-nums">{{totals.players}}</div>
  </div>
  <div class="card col-span-2 p-4 sm:col-span-1">
    <div class="text-xs text-ink-faint">Docker</div>
    <div class="mt-1 flex items-center gap-2 text-sm font-semibold text-ink-faint" id="docker-status">
      <span class="status-dot relative bg-stone-500"></span> Checking…
    </div>
  </div>
</div>

{{#unless serversOnly}}
<div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4 {{#if noServers}}hidden{{/if}}">
  <div class="card min-w-0 p-4">
    <div class="flex items-center gap-1 text-xs text-ink-faint">{{{icon 'memory-stick' 'size-3.5'}}} Memory allotted</div>
    <div class="mt-1 break-words text-2xl font-bold tabular-nums">{{overview.mem.allottedMb}}<span class="text-base font-medium text-ink-faint"> MB</span></div>
    <div class="text-xs text-ink-faint"><span data-overview-mem-used>{{overview.mem.usedMb}}</span> MB in use{{#if overview.mem.allottedMb}} · {{pct overview.mem.usedMb overview.mem.allottedMb}}% used{{/if}}</div>
  </div>

  <div class="card min-w-0 p-4">
    <div class="flex items-center gap-1 text-xs text-ink-faint">{{{icon 'hard-drive' 'size-3.5'}}} Storage used</div>
    <div class="mt-1 break-words text-2xl font-bold tabular-nums">{{bytes overview.disk.usedBytes}}</div>
    <div class="text-xs text-ink-faint">across all server data folders</div>
  </div>

  <a href="/health" class="card block min-w-0 p-4 transition hover:border-line-strong" aria-label="Open the health page">
    <div class="flex items-center gap-1 text-xs text-ink-faint">{{{icon 'activity' 'size-3.5'}}} Health · 24h</div>
    <div class="mt-1 break-words text-2xl font-bold tabular-nums {{#if overview.healthTotal}}text-danger{{else}}text-ok{{/if}}">{{overview.healthTotal}}<span class="text-base font-medium text-ink-faint"> alert{{#unless (eq overview.healthTotal 1)}}s{{/unless}}</span></div>
    <div class="text-xs text-ink-faint">{{#if overview.healthTotal}}{{overview.health.crashes}} crash{{#unless (eq overview.health.crashes 1)}}es{{/unless}}, {{overview.health.oom}} out of memory, {{overview.health.autoRestarted}} auto-restart{{#unless (eq overview.health.autoRestarted 1)}}s{{/unless}}{{else}}No crashes, out-of-memory stops, or auto-restarts{{/if}}</div>
  </a>

  <a href="/updates" class="card block min-w-0 p-4 transition hover:border-line-strong" aria-label="Open the updates page">
    <div class="flex items-center gap-1 text-xs text-ink-faint">{{{icon 'circle-arrow-up' 'size-3.5'}}} Updates</div>
    <div class="mt-1 break-words text-2xl font-bold tabular-nums {{#if overview.updates.all}}text-warn{{/if}}">{{overview.updates.all}}</div>
    <div class="text-xs text-ink-faint">{{overview.updates.mods}} mod{{#unless (eq overview.updates.mods 1)}}s{{/unless}} / {{overview.updates.server}} server-level</div>
  </a>
</div>
{{/unless}}




{{#unless noServers}}
{{#unless serversOnly}}<h2 class="mb-3 font-semibold">Servers</h2>{{/unless}}
<div class="mb-4 flex flex-wrap items-center gap-2">
  <input class="input w-full sm:w-auto sm:max-w-xs sm:flex-1" type="search" placeholder="Search servers, tags…" aria-label="Search servers" id="server-filter">
  {{! Visible "Sort" label: only the first option carried a "Sort:" prefix, so
      the closed trigger read context-free once anything else was picked. }}
  <label class="text-xs text-ink-faint" for="server-sort">Sort</label>
  <select class="input w-auto" id="server-sort" data-label="Sort servers">
    <option value="status" {{#if (eq sort 'status')}}selected{{/if}}>Status</option>
    <option value="name" {{#if (eq sort 'name')}}selected{{/if}}>Name</option>
    <option value="size" {{#if (eq sort 'size')}}selected{{/if}}>Size</option>
    <option value="started" {{#if (eq sort 'started')}}selected{{/if}}>Last Started</option>
    <option value="created" {{#if (eq sort 'created')}}selected{{/if}}>Created</option>
  </select>
  <div class="seg ml-auto" role="group" aria-label="View">
    <button class="seg-btn" id="view-grid" aria-pressed="false" data-tip="Grid view.">{{{icon 'layout-grid' 'size-4'}}}</button>
    <button class="seg-btn" id="view-list" aria-pressed="false" data-tip="List view.">{{{icon 'list' 'size-4'}}}</button>
  </div>
</div>

{{/unless}}

{{#if noServers}}
  {{> empty-state iconName='pickaxe' title='No Servers Yet' message='Create your first Minecraft server. Pick a server type and version, or start from a blueprint. You will be playing in minutes.' ctaHref='/servers/new' ctaLabel='Create a Server'}}
{{else}}
<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" id="server-grid">
  {{#each servers}}
    {{> server-card}}
  {{/each}}

  <a href="/servers/new" class="grid min-h-44 place-items-center rounded-lg border-2 border-dashed border-line text-ink-faint transition hover:border-grass-600 hover:text-ok">
    <div class="grid place-items-center text-center">
      {{{icon 'plus' 'size-8'}}}
      <div class="mt-2 text-sm font-medium">Create a Server</div>
      {{! label kept in sync with the empty-state CTA, topbar, and setup }} 
    </div>
  </a>
</div>
{{/if}}

{{! Fleet resource charts sit after the servers themselves: the servers are
    what people come here for, the combined graph is context. }}
{{#unless serversOnly}}
<div class="mt-8 {{#if noServers}}hidden{{/if}}" id="combined-overview">
  <div class="mb-3 flex items-center justify-between">
    <h2 class="font-semibold">Resource Overview</h2>
  </div>
  <div data-combined-root>
    {{> combined-graphs}}
  </div>
</div>
{{/unless}}

<div class="mt-8 {{#if serversOnly}}hidden{{/if}}">
  <div class="mb-3 flex items-center justify-between">
    <h2 class="font-semibold">Recent Activity</h2>
    <a href="/activity" class="text-sm text-link hover:underline">View All →</a>
  </div>
  <div class="card">
    <ol class="divide-y divide-line">
      {{#each activity}}
        {{! The summary keeps a readable minimum width; on a phone the server and
            time drop to their own line instead of squeezing it to a word a line. }}
        <li class="flex flex-wrap items-center gap-x-2 gap-y-1 p-3 text-sm">
          <span class="badge shrink-0">{{type}}</span>
          <span class="min-w-[12rem] flex-1 break-words">{{summary}}</span>
          <span class="flex shrink-0 items-center gap-2 text-xs">
            {{! deleted-server names are plain faint text - link-styled dead spans read as broken. }}
            {{#if serverId}}<a href="/servers/{{serverId}}" class="text-link hover:underline">{{server}}</a>{{else}}<span class="text-ink-faint">{{server}}</span>{{/if}}
            <span class="text-ink-faint" data-ts-ago="{{ts}}">{{ts}}</span>
          </span>
        </li>
      {{else}}
        <li class="p-8 text-center text-sm text-ink-faint">No activity yet. Actions on your servers will show up here.</li>
      {{/each}}
    </ol>
  </div>
</div>
<script type="module" src="/js/pages/dashboard.js"></script>
