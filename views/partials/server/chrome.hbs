<div class="card mb-6 overflow-hidden bg-canvas shadow-md transition-shadow relative" style="border-top: 4px solid {{server.accent}}">
  <div class="texture-top flex flex-col sm:flex-row sm:items-start justify-between gap-5 p-4 sm:p-5 relative z-10">
    <div class="flex min-w-0 flex-col sm:flex-row sm:items-center gap-4 sm:gap-5 w-full sm:w-auto">
      <div class="relative shrink-0 mx-auto sm:mx-0">
        <img src="{{iconSrc server.icon}}" alt="" class="size-20 sm:size-16 rounded-2xl sm:rounded-xl object-cover shadow-md ring-1 ring-inset ring-black/10 hover:scale-105 transition-transform duration-300" style="background: {{server.accent}}" data-fallback-icon="/icons/servers/grass.svg">
      </div>

      <div class="min-w-0 flex-1 text-center sm:text-left">
        <div class="flex flex-col sm:flex-row sm:items-center sm:flex-wrap gap-x-3 gap-y-2 justify-center sm:justify-start">
          <h2 class="min-w-0 max-w-full break-words text-2xl font-bold tracking-tight text-ink">{{server.name}}</h2>
          <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-widest border border-line/50 shadow-sm bg-canvas {{statusText server.status}} shrink-0 mx-auto sm:mx-0">
            <span class="status-dot relative {{statusDot server.status}} {{#if (statusPulse server.status)}}pulse{{/if}}"></span>
            {{statusLabel server.status}}
          </span>
          <span class="badge badge-warn text-[10px] uppercase font-bold tracking-widest border border-warn/30 bg-warn/10 text-warn-strong px-2 py-0.5 {{#unless server.statusDetail}}hidden{{/unless}}" data-status-detail="{{server.id}}">{{server.statusDetail}}</span>
          {{#if server.updateAvailable}}<span class="badge badge-warn text-[10px] uppercase font-bold tracking-widest border border-warn/30 bg-warn/10 text-warn-strong px-2 py-0.5">Update Available</span>{{/if}}
          {{#if server.crashesUnread}}<span class="badge badge-danger text-[10px] uppercase font-bold tracking-widest border border-danger/30 bg-danger/10 text-danger px-2 py-0.5">{{server.crashesUnread}} new {{plural server.crashesUnread 'crash' 'crashes'}}</span>{{/if}}
        </div>
        
        <p class="mt-2.5 flex flex-wrap items-center justify-center sm:justify-start gap-x-2 gap-y-1.5 text-xs font-medium text-ink-faint">
          <span class="text-ink bg-inset/50 px-1.5 py-0.5 rounded-md border border-line/30"><b class="font-bold mr-1">{{server.flavor}}</b> {{server.mcVersion}}</span>
          <span class="bg-inset/30 px-1.5 py-0.5 rounded border border-line/30">Java <span class="font-bold text-ink-soft">{{server.javaTag}}</span></span>
          <span class="bg-inset/30 px-1.5 py-0.5 rounded border border-line/30 font-mono text-[11px] text-ink-soft">TCP:{{server.ports.game}}</span>
          {{#if server.pack}}<span class="bg-info/10 text-link border border-info/20 px-1.5 py-0.5 rounded"><span class="font-bold uppercase text-[10px] tracking-wider">{{platformName server.pack.platform}}</span>: {{server.pack.name}} @ <span class="font-bold">{{server.pack.version}}</span></span>{{/if}}
          {{#if server.stats.uptime}}<span class="flex items-center gap-1 bg-inset/30 px-1.5 py-0.5 rounded border border-line/30">{{{icon 'clock' 'size-3 text-ink-soft'}}} Up <span class="font-bold">{{server.stats.uptime}}</span></span>{{/if}}
        </p>
        
        {{#if server.tags.length}}
          <div class="mt-3 flex flex-wrap items-center justify-center sm:justify-start gap-1.5">
            {{#each server.tags}}<span class="chip text-[10px] py-0.5 px-2 bg-inset/40 text-ink-soft border-line/50 border hover:bg-inset/80 transition-colors">{{this}}</span>{{/each}}
          </div>
        {{/if}}
      </div>
    </div>
    
    {{! Power controls }}
    <div class="flex flex-wrap sm:flex-col lg:flex-row items-center sm:items-end lg:items-center justify-center gap-2 mt-4 sm:mt-0{{#unless perms.power}} hidden{{/unless}} shrink-0">
      {{#if (or (eq server.status 'running') (eq server.status 'starting') (eq server.status 'unhealthy') (eq server.status 'stalled'))}}
        <button class="btn border border-line/50 shadow-sm font-bold bg-canvas hover:bg-inset/30" data-server-action="restart" data-server-id="{{server.id}}" data-server-name="{{server.name}}">{{{icon 'rotate-cw' 'size-4'}}} Restart</button>
        <button class="btn btn-danger font-bold shadow-sm" data-server-action="stop" data-server-id="{{server.id}}" data-server-name="{{server.name}}">{{{icon 'square' 'size-4 text-white/80'}}} Stop</button>
        <button class="btn btn-ghost border border-line/30 text-ink-faint hover:text-danger hover:bg-danger/10 size-9 p-0 grid place-items-center rounded-full" data-server-action="kill" data-server-id="{{server.id}}" data-server-name="{{server.name}}" data-tip="Force stop. Skips the world save; use only if the server is frozen.">{{{icon 'zap' 'size-4'}}}</button>
      {{else}}
        <button class="btn btn-primary font-bold shadow-sm" data-server-action="start" data-server-id="{{server.id}}" data-server-name="{{server.name}}">{{{icon 'play' 'size-4 text-white/80'}}} Start</button>
        {{#if (eq server.status 'crashed')}}<a class="btn border border-danger/30 text-danger bg-danger/5 hover:bg-danger/15 font-bold shadow-sm" href="/servers/{{server.id}}/history">{{{icon 'flame' 'size-4'}}} Latest Crash</a>{{/if}}
      {{/if}}
      {{#if server.pendingRecreate}}
        <button class="btn border border-warn/30 text-warn bg-warn/10 hover:bg-warn/20 font-bold shadow-sm" data-server-action="recreate" data-server-id="{{server.id}}" data-server-name="{{server.name}}" data-tip="Settings changed. Rebuild the container to apply them.">{{{icon 'wrench' 'size-4'}}} Apply Changes</button>
      {{/if}}
    </div>
  </div>

  {{! Navigation }}
  <nav class="flex flex-wrap items-center gap-x-1 gap-y-1 border-t border-line/50 px-3 py-2 bg-inset/5">
    {{#each nav.groups}}
      <a href="{{href}}"
         class="inline-flex shrink-0 items-center gap-2 whitespace-nowrap rounded-lg px-3 py-2 text-[13px] font-bold transition-all
           {{#if active}}bg-inset/50 text-ink shadow-sm border border-line/30{{else}}text-ink-soft hover:bg-inset/30 hover:text-ink border border-transparent{{/if}}">
        {{{icon icon 'size-4 opacity-80'}}} {{label}}
        {{#if badge}}<span class="badge badge-danger text-[9px] px-1.5 py-0">{{badge}}</span>{{/if}}
      </a>
    {{/each}}
  </nav>
  
  {{! Sub-navigation }}
  {{#if nav.sub}}
    <div class="flex flex-wrap items-center gap-2 border-t border-line/30 bg-inset/20 px-4 py-2.5">
      {{#each nav.sub}}
        <a href="{{href}}" class="subtab shrink-0 text-xs font-bold px-3 py-1.5 rounded-md transition-colors {{#if active}}bg-canvas text-ink shadow-sm border border-line/50{{else}}text-ink-soft hover:bg-inset/30 hover:text-ink border border-transparent{{/if}}">
          {{label}}{{#if badge}} <span class="badge badge-danger ml-1 text-[9px] px-1 py-0">{{badge}}</span>{{/if}}
        </a>
      {{/each}}
    </div>
  {{/if}}
</div>
