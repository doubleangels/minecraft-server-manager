{{! Crashed, or holding unread crash reports: a redstone edge and outline in
    place of the accent, matching the server card on the dashboard. }}
{{! Way back out of a server below lg, where the sidebar is tucked away and
    the phone's bottom bar belongs to this server's own sections. }}
<a href="/servers" class="-mt-2 mb-3 inline-flex items-center gap-1 text-sm text-ink-faint hover:text-ink lg:hidden">{{{icon 'chevron-left' 'size-4'}}} All Servers</a>
<div data-server-title="{{server.id}}" data-server-name="{{server.name}}" data-server-status="{{server.status}}" class="card mb-6 overflow-hidden{{#if (or (eq server.status 'crashed') server.crashesUnread)}} border-danger/50{{/if}}" style="border-top: 3px solid {{#if (or (eq server.status 'crashed') server.crashesUnread)}}var(--color-redstone-500){{else}}{{server.accent}}{{/if}}">
  {{! icon+name grouped into ONE flex item, separate from the actions column,
      using flex-auto (basis: auto) rather than flex-1 (basis: 0%). That's
      the actual fix, not just the grouping: flex-wrap decides whether to
      wrap BEFORE grow/shrink is resolved, based on each item's hypothetical
      (flex-basis) size - flex-1's 0% basis tells the browser this item
      contributes NOTHING to that decision, so on a running server (Restart +
      Stop + kill button eating most of a narrow row) it never wraps and
      instead squeezes the name down to 0 post-hoc, wrapping a single-word
      name like "Skyblock" one letter per line. flex-auto's real content-based
      basis makes the wrap trigger correctly once both genuinely don't fit. }}
  <div class="texture-top flex flex-wrap items-start justify-between gap-4 p-4 sm:p-5">
    <div class="flex min-w-0 flex-auto items-center gap-4">
      <img src="{{iconSrc server.icon}}" alt="" class="size-14 shrink-0 rounded-lg" style="background: {{server.accent}}" data-fallback-icon="/icons/servers/grass.svg">

      <div class="min-w-0 flex-1">
        {{! Phone: the name takes its own line, status + badges flow after it at
            their natural width (a flex-col stretched every badge edge to edge). }}
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5">
          <h2 class="min-w-0 max-w-full basis-full break-words text-xl font-bold sm:basis-auto">{{server.name}}</h2>
          <span class="flex items-center gap-1.5 text-xs font-medium {{statusText server.status}}">
            <span class="status-dot relative {{statusDot server.status}} {{#if (statusPulse server.status)}}pulse{{/if}}"></span>
            {{statusLabel server.status}}
          </span>
          <span class="badge badge-warn {{#unless server.statusDetail}}hidden{{/unless}}" data-status-detail="{{server.id}}">{{server.statusDetail}}</span>
          {{#if server.updateAvailable}}<span class="badge badge-warn">update available</span>{{/if}}
          {{#if server.crashesUnread}}<span class="badge badge-danger">{{server.crashesUnread}} new {{plural server.crashesUnread 'crash' 'crashes'}}</span>{{/if}}
        </div>
        <p class="mt-1 flex flex-wrap gap-x-3 text-xs text-ink-faint">
          <span><b class="font-semibold text-ink-soft">{{server.flavor}}</b> {{server.mcVersion}}</span>
          <span>Java: {{server.javaTag}}</span>
          <span>Port {{server.ports.game}}</span>
          {{#if server.pack}}<span>{{platformName server.pack.platform}}: {{server.pack.name}} @ {{server.pack.version}} (pinned)</span>{{/if}}
          {{#if server.stats.uptime}}<span>Up {{server.stats.uptime}}</span>{{/if}}
        </p>
        {{#if server.tags.length}}
          <div class="mt-2 flex flex-wrap gap-1.5">{{#each server.tags}}<span class="chip">{{this}}</span>{{/each}}</div>
        {{/if}}
      </div>
    </div>
    {{! Power controls need the `power` permission on this server (perms comes
        from the page route). Kept in the DOM but hidden so the action
        handlers in app.js still bind on every other page state. }}
    {{! Phone: one row of equal-width buttons under the name; sm+: natural width. }}
    <div class="flex w-full flex-wrap gap-2 sm:w-auto{{#unless perms.power}} hidden{{/unless}}">
      {{#if (or (eq server.status 'running') (eq server.status 'starting') (eq server.status 'unhealthy') (eq server.status 'stalled'))}}
        <button class="btn flex-1 sm:flex-none" data-server-action="restart" data-server-id="{{server.id}}" data-server-name="{{server.name}}" data-players-online="{{server.players.online}}">{{{icon 'rotate-cw' 'size-4'}}} Restart</button>
        <button class="btn btn-danger flex-1 sm:flex-none" data-server-action="stop" data-server-id="{{server.id}}" data-server-name="{{server.name}}" data-players-online="{{server.players.online}}">{{{icon 'square' 'size-4'}}} Stop</button>
        <button class="btn btn-ghost" data-server-action="kill" data-server-id="{{server.id}}" data-server-name="{{server.name}}" aria-label="Force Stop" data-tip="Force stop. Skips the world save; use only if the server is frozen.">{{{icon 'zap' 'size-4'}}}</button>
      {{else}}
        <button class="btn btn-primary flex-1 sm:flex-none" data-server-action="start" data-server-id="{{server.id}}" data-server-name="{{server.name}}">{{{icon 'play' 'size-4'}}} Start</button>
        {{#if (eq server.status 'crashed')}}<a class="btn flex-1 sm:flex-none" href="/servers/{{server.id}}/history">{{{icon 'flame' 'size-4'}}} Latest Crash</a>{{/if}}
      {{/if}}
      {{#if server.pendingRecreate}}
        <button class="btn flex-1 sm:flex-none" data-server-action="recreate" data-server-id="{{server.id}}" data-server-name="{{server.name}}" data-players-online="{{server.players.online}}" data-tip="Settings changed. Rebuild the server to apply them.">{{{icon 'wrench' 'size-4'}}} Apply Changes</button>
      {{/if}}
    </div>
  </div>

  {{! Top-level sections. Phone: a tab bar fixed to the bottom edge, in thumb
      reach, all six side by side (z 25, see the scale in input.css; the page
      reserves room for it through --bottom-nav, and the bar is exactly that
      tall so nothing peeks between it and a sticky action bar). The active tab
      is marked by a pill behind its icon (input.css), never a line on the
      bar's top edge. sm+: one row in the card, the active tab a tinted pill
      like every other tab row in the panel. }}
  <nav data-bottom-nav class="fixed inset-x-0 bottom-0 z-[25] grid h-[calc(3.5rem+env(safe-area-inset-bottom))] grid-cols-6 bg-canvas pb-[env(safe-area-inset-bottom)] shadow-[inset_0_1px_0_var(--color-line)] sm:h-auto sm:border-t sm:border-line sm:shadow-none pl-[env(safe-area-inset-left)] pr-[env(safe-area-inset-right)] sm:static sm:z-auto sm:flex sm:flex-nowrap sm:items-center sm:gap-0.5 sm:overflow-x-auto sm:bg-transparent sm:p-0 sm:px-2" aria-label="Server sections">
    {{#each nav.groups}}
      <a href="{{href}}" data-nav-group="{{key}}" data-nav-tabs="{{tabs}}"{{#if active}} aria-current="page"{{/if}}
         class="relative flex min-w-0 shrink-0 flex-col items-center justify-center gap-0.5 whitespace-nowrap px-0.5 pb-1 pt-1 text-[10px] font-medium transition sm:my-1.5 sm:inline-flex sm:flex-row sm:justify-start sm:gap-1.5 sm:rounded-sm sm:px-3 sm:py-1.5 sm:text-sm
           {{#if active}}text-ink{{else}}text-ink-faint hover:text-ink sm:hover:bg-inset{{/if}}">
        {{{icon icon 'size-5 sm:size-4'}}} <span class="max-w-full truncate">{{label}}</span>
        {{#if badge}}<span class="badge badge-danger absolute right-1 top-1 px-1 text-[10px] leading-none sm:static sm:px-1.5 sm:text-xs sm:leading-normal">{{badge}}</span>{{/if}}
      </a>
    {{/each}}
  </nav>
  {{! Sub-nav for the active section (only when it has more than one). }}
  {{#if nav.sub}}
    {{! Wraps onto a second line on a phone rather than hiding tabs off-screen. }}
    <div class="flex flex-wrap items-center gap-1 border-t border-line bg-inset/40 px-3 py-1.5">
      {{#each nav.sub}}
        <a href="{{href}}" class="subtab shrink-0 {{#if active}}active{{/if}}">
          {{label}}{{#if badge}} <span class="badge badge-danger">{{badge}}</span>{{/if}}
        </a>
      {{/each}}
    </div>
  {{/if}}
</div>
