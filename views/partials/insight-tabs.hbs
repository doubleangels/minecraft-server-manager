{{! Activity and Health as tabs, so the phone's Activity tab reaches both. The
    badge counts unread health alerts. Hidden from lg up (the sidebar has both). }}
<nav class="-mt-2 mb-5 flex flex-wrap gap-1 lg:hidden" aria-label="Insights">
  <a href="/activity" class="subtab {{#if (eq active 'activity')}}active{{/if}}">Activity</a>
  <a href="/health" class="subtab {{#if (eq active 'health')}}active{{/if}}">Health{{#if healthCount}} <span class="badge badge-danger">{{healthCount}}</span>{{/if}}</a>
</nav>
