<div class="card mb-6 overflow-hidden" style="border-top: 4px solid {{server.accent}}">
  <div class="texture-top flex flex-wrap items-start justify-between gap-4 p-4 sm:p-5">
    <div class="flex min-w-0 flex-auto items-center gap-4">
      <div class="relative shrink-0">
        <img src="{{iconSrc server.icon}}" alt="" class="size-16 rounded-xl object-cover shadow-sm ring-1 ring-inset ring-black/10" style="background: {{server.accent}}" data-fallback-icon="/icons/servers/grass.svg">
      </div>

      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="min-w-0 max-w-full break-words text-2xl font-bold tracking-tight">{{server.name}}</h2>
          <span class="flex items-center gap-1.5 text-xs font-medium {{statusText server.status}}">
            <span class="status-dot relative {{statusDot server.status}} {{#if (statusPulse server.status)}}pulse{{/if}}"></span>
            {{statusLabel server.status}}
          </span>
          <span class="badge badge-warn {{#unless server.statusDetail}}hidden{{/unless}}" data-status-detail="{{server.id}}">{{server.statusDetail}}</span>
          {{#if server.updateAvailable}}<span class="badge badge-warn">update available</span>{{/if}}
          {{#if server.crashesUnread}}<span class="badge badge-danger">{{server.crashesUnread}} new {{plural server.crashesUnread 'crash' 'crashes'}}</span>{{/if}}
        </div>
        <p class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-sm text-ink-faint">
          <span><b class="font-semibold text-ink-soft">{{server.flavor}}</b> {{server.mcVersion}}</span>
          <span>Java: {{server.javaTag}}</span>
          <span>Port {{server.ports.game}}</span>
          {{#if server.pack}}<span>{{platformName server.pack.platform}}: {{server.pack.name}} @ {{server.pack.version}} (pinned)</span>{{/if}}
          {{#if server.stats.uptime}}<span>Up {{server.stats.uptime}}</span>{{/if}}
        </p>
        {{#if server.tags.length}}
          <div class="mt-2.5 flex flex-wrap gap-1.5">{{#each server.tags}}<span class="chip">{{this}}</span>{{/each}}</div>
        {{/if}}
      </div>
    </div>
    {{! Power controls need the `power` permission on this server (perms comes
        from the page route). Kept in the DOM but hidden so the action
        handlers in app.js still bind on every other page state. }}
    <div class="flex flex-wrap gap-2{{#unless perms.power}} hidden{{/unless}}">
      {{#if (or (eq server.status 'running') (eq server.status 'starting') (eq server.status 'unhealthy') (eq server.status 'stalled'))}}
        <button class="btn" data-server-action="restart" data-server-id="{{server.id}}" data-server-name="{{server.name}}">{{{icon 'rotate-cw' 'size-4'}}} Restart</button>
        <button class="btn btn-danger" data-server-action="stop" data-server-id="{{server.id}}" data-server-name="{{server.name}}">{{{icon 'square' 'size-4'}}} Stop</button>
        <button class="btn btn-ghost" data-server-action="kill" data-server-id="{{server.id}}" data-server-name="{{server.name}}" data-tip="Force stop. Skips the world save; use only if the server is frozen.">{{{icon 'zap' 'size-4'}}}</button>
      {{else}}
        <button class="btn btn-primary" data-server-action="start" data-server-id="{{server.id}}" data-server-name="{{server.name}}">{{{icon 'play' 'size-4'}}} Start</button>
        {{#if (eq server.status 'crashed')}}<a class="btn" href="/servers/{{server.id}}/history">{{{icon 'flame' 'size-4'}}} Latest Crash</a>{{/if}}
      {{/if}}
      {{#if server.pendingRecreate}}
        <button class="btn" data-server-action="recreate" data-server-id="{{server.id}}" data-server-name="{{server.name}}" data-tip="Settings changed. Rebuild the container to apply them.">{{{icon 'wrench' 'size-4'}}} Apply Changes</button>
      {{/if}}
    </div>
  </div>

  {{! Top-level domain sections. flex-wrap on mobile instead of scrolling. }}
  <nav class="flex flex-wrap items-center gap-x-0.5 gap-y-1 border-t border-line px-2 py-1">
    {{#each nav.groups}}
      <a href="{{href}}"
         class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium transition
           {{#if active}}bg-inset/50 text-ink{{else}}text-ink-faint hover:bg-inset/30 hover:text-ink{{/if}}">
        {{{icon icon 'size-4'}}} {{label}}
        {{#if badge}}<span class="badge badge-danger">{{badge}}</span>{{/if}}
      </a>
    {{/each}}
  </nav>
  {{! Sub-nav for the active section (only when it has more than one). }}
  {{#if nav.sub}}
    <div class="flex flex-wrap items-center gap-1 border-t border-line bg-inset/40 px-3 py-2">
      {{#each nav.sub}}
        <a href="{{href}}" class="subtab shrink-0 {{#if active}}active{{/if}}">
          {{label}}{{#if badge}} <span class="badge badge-danger">{{badge}}</span>{{/if}}
        </a>
      {{/each}}
    </div>
  {{/if}}
</div>
