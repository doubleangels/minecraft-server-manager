<a href="/servers/{{id}}" class="card group relative block overflow-hidden transition-all duration-200 hover:-translate-y-0.5 hover:border-line-strong hover:shadow-md"
   data-filter="{{name}} {{flavor}} {{mcVersion}}{{#each tags}} {{this}}{{/each}}"
   style="border-left: 4px solid {{accent}}">
  <div class="p-5 sm:p-6">
    <div class="flex items-start gap-3 sm:gap-4">
      <div class="relative shrink-0">
        <img src="{{iconSrc this.icon}}" alt="" class="size-12 rounded-xl object-cover shadow-sm ring-1 ring-inset ring-black/10" style="background: {{accent}}" data-fallback-icon="/icons/servers/grass.svg">
      </div>

      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2">
          <h3 class="truncate font-semibold group-hover:text-ok">{{name}}</h3>
          {{#if updateAvailable}}<span class="badge badge-warn shrink-0" title="Update available">update</span>{{/if}}
          {{#if crashesUnread}}<span class="badge badge-danger shrink-0" title="New crash reports">{{crashesUnread}} {{plural crashesUnread 'crash' 'crashes'}}</span>{{/if}}
        </div>
        <p class="mt-0.5 flex flex-wrap items-center gap-x-2 text-xs text-ink-faint">
          <span class="font-medium text-ink-soft">{{flavor}}</span>
          <span>{{mcVersion}}</span>
          <span>·</span>
          <span>:{{ports.game}}</span>
        </p>
      </div>
      <span class="flex flex-col items-end gap-0.5">
        <span class="flex items-center gap-1.5 text-xs font-medium {{statusText status}}">
          <span class="status-dot relative {{statusDot status}} {{#if (statusPulse status)}}pulse{{/if}}"></span>
          {{statusLabel status}}
        </span>
        <span class="max-w-40 truncate text-right text-[11px] text-warn {{#unless statusDetail}}hidden{{/unless}}" data-status-detail="{{id}}" title="{{statusDetail}}">{{statusDetail}}</span>
      </span>
    </div>

    <div class="mt-4 grid grid-cols-3 gap-3 rounded-lg bg-inset/30 p-3 text-xs tabular-nums shadow-inner" data-card-stats>
      <div class="min-w-0">
        <div class="text-base font-semibold text-ink">Players</div>
        <div class="mt-1 font-semibold text-ink">{{players.online}}<span class="font-normal text-ink-soft">/{{players.max}}</span></div>
      </div>
      <div class="min-w-0">
        <div class="text-base font-semibold text-ink">CPU</div>
        <div class="mt-1 font-semibold text-ink">{{#if (eq status 'running')}}{{stats.cpuPct}}%{{else}}-{{/if}}</div>
      </div>
      <div class="min-w-0">
        <div class="text-base font-semibold text-ink">Memory</div>
        <div class="mt-1 truncate font-semibold text-ink"{{#if memory.note}} data-tip="{{memory.note}}"{{/if}}>{{#if (eq status 'running')}}{{stats.memUsedMb}}<span class="font-normal text-ink-soft"> / {{resources.containerMemoryMb}} MB</span>{{else}}-{{/if}}</div>
      </div>
    </div>

    <div class="mt-3" data-card-disk>
      <div class="mb-1 flex justify-between text-base font-semibold text-ink">
        <span>Disk</span><span class="text-xs font-normal text-ink-faint">{{bytes disk.used}}{{#if disk.quota}} of {{bytes disk.quota}}{{else}} (no quota){{/if}}</span>
      </div>
      <div class="meter"><div class="{{meterColor disk.used disk.quota}}" style="width: {{pct disk.used disk.quota}}%"></div></div>
    </div>

    {{#if tags.length}}
      <div class="mt-3 flex flex-wrap gap-1.5" data-card-tags>
        {{#each tags}}<span class="chip">{{this}}</span>{{/each}}
      </div>
    {{/if}}
  </div>
</a>
