{{> page-header heading="SETTINGS" sub="Panel settings, connection keys, and user accounts."}}

{{! [&>*]:min-w-0 - grid items default to min-width:auto, so without it a card
    containing a wrapping flex row (the API-key/domain inputs) is sized off that
    row's UNWRAPPED max-content width and drags the whole grid (and page) wider
    than the viewport on mobile, even though the row itself wraps correctly. }}
<div class="grid gap-5 lg:grid-cols-2 [&>*]:min-w-0" id="settings-page">

  {{#> settings/card heading="API Keys" desc="Keys the panel uses to reach mod sites on your behalf. Stored encrypted."}}
    <div class="space-y-5">
      <div>
        <label class="label" for="set-cf-key">CurseForge API key</label>
        {{! min-w-0 + flex-wrap: the monospace placeholder would otherwise refuse
            to shrink and push the page wider than a narrow screen; wrapping lets
            the buttons drop to their own row. }}
        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-2">
          <input class="input min-w-0 flex-1 font-mono" id="set-cf-key" type="password" placeholder="{{#if cfKeyMasked}}{{cfKeyMasked}} (stored){{else}}paste your key from console.curseforge.com{{/if}}" autocomplete="off">
          <button class="btn" id="set-cf-save">Save Key</button>
          <button class="btn btn-ghost" id="set-cf-test" data-tip="Test the stored key against CurseForge.">Test Key</button>
        </div>
        <p class="help">Needed for automatic CurseForge modpacks and CurseForge mod downloads. New keys are checked against CurseForge before they're saved.</p>
      </div>
      <div>
        <span class="label">Modrinth</span>
        <p class="help">No key needed. Modrinth's public API is used directly.</p>
      </div>
    </div>
  {{/settings/card}}

  {{#> settings/card heading="Panel"}}
    <div class="space-y-5">
      <div>
        <label class="label" for="set-domain">Public domain</label>
        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-2">
          <input class="input min-w-0 flex-1" id="set-domain" placeholder="mc.example.com" value="{{publicHost}}" autocomplete="off" spellcheck="false">
          <button class="btn" id="set-domain-save">Save Domain</button>
        </div>
        <p class="help">Shown to players instead of your IP address in connect addresses (for example, <span class="font-mono">mc.example.com:25565</span>). Leave blank to use the server's IP address. Enter the domain only, with no scheme or port.</p>
        {{#if cookieSecureWarning}}
        <div class="notice notice-danger mt-2">
          {{{icon 'triangle-alert' 'size-4 mt-0.5 shrink-0 text-danger'}}}
          <div>
            <span class="font-semibold text-danger">The login cookie is not marked Secure.</span>
            <span>A public domain is set, but the secure-cookie option is not. If this panel is reachable over plain HTTP, the login cookie can be read in transit. Put the panel behind HTTPS and set <span class="font-mono">COOKIE_SECURE=true</span>, or <span class="font-mono">COOKIE_SECURE=auto</span> together with <span class="font-mono">TRUST_PROXY</span>, in the environment. See the README for details.</span>
          </div>
        </div>
        {{/if}}
      </div>

      <div>
        <span class="label">Time zone &amp; region</span>
        {{! data-native only until tzPicker fills them - it enhances post-fill. }}
        <div class="grid gap-2 sm:grid-cols-2">
          <select class="input" id="set-tz" data-native aria-label="Time zone" data-label="Time zone"></select>
          <select class="input" id="set-country" data-native aria-label="Country" data-label="Country"></select>
        </div>
        <div class="mt-2 flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-2">
          <button class="btn" id="set-loc-save">Save Time Zone</button>
          <span class="help mt-0" id="set-loc-note"></span>
        </div>
        <p class="help">Controls how dates and player-activity times are shown across the panel. "Auto" follows this machine's system settings.</p>
      </div>

      <div class="border-t border-line pt-4">
        <span class="label">Bind address &amp; port</span>
        <dl class="grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
          <div><dt class="text-base font-semibold text-ink">Bind Address</dt><dd class="mt-0.5 font-mono font-medium">{{panel.host}}</dd></div>
          <div><dt class="text-base font-semibold text-ink">Port</dt><dd class="mt-0.5 font-mono font-medium">{{panel.port}}</dd></div>
        </dl>
        <p class="help">Set these in <span class="font-mono">.env</span> (PANEL_HOST and PANEL_PORT). A restart applies the changes. Theme is per-browser, set with the topbar toggle.</p>
      </div>

      <div class="border-t border-line pt-4">
        <span class="label">Panel version</span>
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-2">
          <span class="font-mono text-sm">v{{panel.version}}</span>
          <button class="btn" id="msm-update-btn">Check for Updates</button>
        </div>
        <div id="msm-update-out"></div>
        <p class="help">Compares the installed version with the latest release on GitHub. You download and install the update yourself. The panel never modifies its own files.</p>
      </div>

      <div class="border-t border-line pt-4">
        <span class="label">Defaults for new servers</span>
        <div class="grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
          <div>
            <label class="label" for="dflt-heap">Java heap (MB)</label>
            <input class="input" id="dflt-heap" type="number" inputmode="numeric" value="{{defaults.heapMb}}" data-default="{{defaultsBase.heapMb}}">
          </div>
          <div>
            <label class="label" for="dflt-container">Container limit (MB)</label>
            <input class="input" id="dflt-container" type="number" inputmode="numeric" value="{{defaults.containerMemoryMb}}" data-default="{{defaultsBase.containerMemoryMb}}">
            <p class="help">Usually 50% above the heap. Ignored when the wizard sets its own.</p>
          </div>
          <div>
            <label class="label" for="dflt-cpus">CPU cores</label>
            <input class="input" id="dflt-cpus" type="number" inputmode="decimal" step="0.5" min="0" value="{{defaults.cpus}}" data-default="{{defaultsBase.cpus}}">
            <p class="help">0 = no limit on CPU usage.</p>
          </div>
          <div>
            <label class="label" for="dflt-quota">Disk quota (GB)</label>
            <input class="input" id="dflt-quota" type="number" inputmode="numeric" value="{{defaults.diskQuotaGb}}" data-default="{{defaultsBase.diskQuotaGb}}">
            <p class="help">0 = storage use is not limited.</p>
          </div>
          <div>
            <label class="label" for="dflt-warnpct">Quota warn (%)</label>
            <input class="input" id="dflt-warnpct" type="number" inputmode="numeric" min="0" max="99" value="{{defaults.quotaWarnPct}}" data-default="{{defaultsBase.quotaWarnPct}}">
          </div>
          <div>
            <label class="label" for="dflt-critpct">Quota critical (%)</label>
            <input class="input" id="dflt-critpct" type="number" inputmode="numeric" min="1" max="100" value="{{defaults.quotaCriticalPct}}" data-default="{{defaultsBase.quotaCriticalPct}}">
          </div>
        </div>
        <div class="mt-2 flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-2">
          <button class="btn" id="dflt-save">Save Defaults</button>
          <button class="btn btn-ghost" id="dflt-restore">Restore Built-ins</button>
          <span class="help mt-0" id="dflt-note"></span>
        </div>
        <p class="help">These pre-fill the create-wizard, apply when a server is created via the API or a blueprint, and drive the quota-bar colors on the dashboard.</p>
      </div>
    </div>
  {{/settings/card}}

  {{#> settings/card heading="Users" wide=true}}
    <div class="overflow-x-auto -mx-5 sm:-mx-6 mb-4 mt-[-1.25rem]">
      <table class="table-base table-stack w-full text-sm" id="users-table">
        <thead class="bg-canvas/50">
          <tr class="text-[10px] uppercase tracking-widest text-ink-faint border-b border-line/30">
            <th class="font-bold py-3 pl-5">User</th>
            <th class="font-bold py-3">Role</th>
            <th class="font-bold py-3">2FA</th>
            <th class="font-bold py-3">Created</th>
            <th class="text-right font-bold py-3 pr-5">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line/30">
          {{#each users}}
            <tr class="hover:bg-inset/10 transition-colors group" data-user-id="{{id}}" data-username="{{username}}">
              <td data-th="User" class="p-3 pl-5 font-bold text-ink">
                <div class="flex items-center gap-3">
                  <span class="grid size-8 shrink-0 place-items-center overflow-hidden rounded-full bg-link/10 text-[10px] font-bold text-link border border-link/20 shadow-sm">
                    {{#if (avatarSrc avatar)}}
                      <img src="{{avatarSrc avatar}}" alt="" class="size-full object-cover">
                    {{else}}
                      {{initial username}}
                    {{/if}}
                  </span>
                  {{username}}{{#if (eq id ../user.id)}} <span class="badge bg-inset/50 border border-line/50 text-[9px] uppercase tracking-wider ml-1">you</span>{{/if}}
                </div>
              </td>
              <td data-th="Role" class="p-3">
                <select class="input w-auto text-xs py-1" data-user-role data-prev-role="{{role}}" data-label="Role for {{username}}">
                  <option value="admin" {{#if (eq role 'admin')}}selected{{/if}}>Admin</option>
                  <option value="operator" {{#if (eq role 'operator')}}selected{{/if}}>Operator</option>
                  <option value="viewer" {{#if (eq role 'viewer')}}selected{{/if}}>Viewer</option>
                </select>
              </td>
              <td data-th="2FA" class="p-3">
                {{#if totpEnabled}}
                  <span class="badge bg-ok/10 text-ok-strong border border-ok/20 text-[9px] uppercase tracking-wider">On</span>
                {{else}}
                  <span class="text-[11px] font-medium text-ink-faint">Off</span>
                {{/if}}
              </td>
              <td data-th="Created" class="whitespace-nowrap text-[11px] font-medium text-ink-faint p-3" data-ts="{{createdAt}}">{{createdAt}}</td>
              <td data-th="" class="p-3 sm:text-right pr-5">
                <div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap">
                  <button class="btn btn-ghost btn-sm text-ink-faint hover:text-ink hover:bg-inset/30 rounded-full size-8 p-0 grid place-items-center sm:opacity-0 group-hover:opacity-100 transition-opacity" data-menu="user-menu-{{@index}}" data-tip="Actions for {{username}}." aria-label="Actions for {{username}}">{{{icon 'ellipsis' 'size-4'}}}</button>
                  <template id="user-menu-{{@index}}">
                    <button data-user-password data-user-id="{{id}}" data-username="{{username}}">{{{icon 'key' 'size-3.5'}}} Set Password</button>
                    {{! Your own row: self-service, same modal as the topbar user menu -
                        2FA can only ever be set up on the device you're enrolling, so
                        there's nothing an admin can do here for someone ELSE's row. }}
                    {{#if (eq id ../user.id)}}
                      <button data-open-2fa>{{{icon 'shield-check' 'size-3.5'}}} {{#if totpEnabled}}Manage 2FA{{else}}Set Up 2FA{{/if}}</button>
                    {{else if totpEnabled}}
                      <button data-user-totp-reset data-user-id="{{id}}" data-username="{{username}}">{{{icon 'shield-check' 'size-3.5'}}} Reset 2FA</button>
                    {{/if}}
                    {{! No self-delete affordance - deleting your own account mid-session is a trap, not a feature. }}
                    {{#unless (eq id ../user.id)}}
                      <button class="btn btn-ghost btn-sm text-danger" data-user-delete data-user-id="{{id}}" data-username="{{username}}">{{{icon 'trash-2' 'size-3.5'}}} Delete User</button>
                    {{/unless}}
                  </template>
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    <div class="mt-4 flex flex-col sm:flex-row sm:flex-wrap gap-2 border-t border-line/30 pt-4">
      <button class="btn btn-primary btn-sm shadow-sm" id="user-add">{{{icon 'plus' 'size-3.5'}}} Add User</button>
      <a class="btn btn-ghost btn-sm border border-line/50 shadow-sm bg-canvas hover:bg-inset/30 transition-colors" href="/settings/permissions">{{{icon 'shield-check' 'size-3.5'}}} Server Permissions</a>
    </div>
    <p class="help mt-3 max-w-prose text-xs leading-relaxed font-medium">Roles: <b class="text-ink">Admin</b> can do everything. <b class="text-ink">Operator</b> can manage servers, but not storage, users, or update policies. <b class="text-ink">Viewer</b> is read-only. Server Permissions lets you change what an operator or viewer may do on each server.</p>
  {{/settings/card}}

  {{#> settings/card heading="Sign-in Security" id="lockouts-card" wide=true desc="Accounts and addresses currently blocked from signing in after too many failed attempts. Locks clear on their own after the cooldown; unlock one here to end it early."}}
    <div id="lockouts-body" class="text-sm text-ink-faint">Checking…</div>
    <button class="btn btn-sm mt-4 hidden w-full sm:w-auto" id="lockouts-clear-all">{{{icon 'lock-open' 'size-3.5'}}} Clear All Locks</button>
  {{/settings/card}}

  {{#> settings/card heading="Public API" id="api-tokens-card" wide=true desc="Let another app or website read your servers' status, like a live status page, an uptime monitor, or a Discord bot. It is read-only: nothing outside can start, stop, or change anything."}}
    {{> settings/toggle-row
        label="Let Outside Apps Read Status"
        help="Switches on by itself when you make your first key below. Turn it off any time to pause outside access without losing your keys."
        inputId="public-api-enabled"
        checked=publicApiEnabled}}

    <div class="mt-4 border-t border-line/30 pt-4">
      <p class="help mt-0 max-w-prose text-xs leading-relaxed font-medium">Each app connects with its own <b class="text-ink">access key</b> (sent as an <span class="font-mono bg-inset/30 px-1 py-0.5 rounded border border-line/30">Authorization: Bearer</span> header). Make one key per app; anyone holding a key can see the servers you allow it: name, type, whether it's running, players online, and resource use. Cancel a key to cut that app off straight away.</p>
      <div class="mt-4 overflow-x-auto -mx-5 sm:-mx-6 mt-[-1.25rem]">
        <table class="table-base table-stack w-full text-sm" id="api-tokens-table">
          <thead class="bg-canvas/50">
            <tr class="text-[10px] uppercase tracking-widest text-ink-faint border-b border-line/30">
              <th class="font-bold py-3 pl-5">Name</th>
              <th class="font-bold py-3">Key</th>
              <th class="font-bold py-3">Can See</th>
              <th class="font-bold py-3">Created</th>
              <th class="font-bold py-3">Last Used</th>
              <th class="font-bold py-3">Expires</th>
              <th class="font-bold py-3">Status</th>
              <th class="text-right font-bold py-3 pr-5">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line/30">
            {{#each apiTokens}}
              <tr class="hover:bg-inset/10 transition-colors group" data-token-id="{{id}}">
                <td data-th="Name" class="p-3 pl-5 font-bold text-ink">{{label}}</td>
                <td data-th="Key" class="p-3"><span class="font-mono text-xs text-ink-soft bg-inset/30 px-1.5 py-0.5 rounded border border-line/30">{{tokenPrefix}}&hellip;</span></td>
                <td data-th="Can See" class="p-3 font-medium text-ink-soft">{{#if scope.all}}<span class="badge bg-inset/50 border border-line/50 text-[9px] uppercase tracking-wider text-ink-faint">Every server</span>{{else}}<span class="font-bold tabular-nums">{{scope.serverIds.length}}</span> server(s){{/if}}</td>
                <td data-th="Created" class="whitespace-nowrap text-[11px] font-medium text-ink-faint p-3" data-ts="{{createdAt}}">{{createdAt}}</td>
                <td data-th="Last Used" class="whitespace-nowrap text-[11px] font-medium text-ink-faint p-3">{{#if lastUsedAt}}<span data-ts="{{lastUsedAt}}">{{lastUsedAt}}</span>{{else}}<span class="opacity-50">never</span>{{/if}}</td>
                <td data-th="Expires" class="whitespace-nowrap text-[11px] font-medium text-ink-faint p-3">{{#if expiresAt}}<span data-ts="{{expiresAt}}">{{expiresAt}}</span>{{else}}<span class="opacity-50">never</span>{{/if}}</td>
                <td data-th="Status" class="p-3">{{#if (eq status 'active')}}<span class="badge bg-ok/10 text-ok-strong border border-ok/20 text-[9px] uppercase tracking-wider">Active</span>{{else}}<span class="badge bg-inset/50 border border-line/50 text-[9px] uppercase tracking-wider">{{status}}</span>{{/if}}</td>
                <td data-th="" class="p-3 sm:text-right pr-5">
                  <div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap sm:opacity-0 group-hover:opacity-100 transition-opacity">
                    {{#unless revokedAt}}
                      <button class="btn btn-ghost btn-sm text-danger hover:bg-danger/10 rounded-full px-3 font-bold border border-transparent shadow-sm" data-token-revoke data-token-id="{{id}}" data-label="{{label}}">Cancel</button>
                    {{/unless}}
                  </div>
                </td>
              </tr>
            {{else}}
              <tr><td data-th="" colspan="8" class="py-12 text-center text-sm text-ink-faint">
                <span class="grid size-12 place-items-center rounded-full bg-inset/30 border border-line/30 shadow-inner mx-auto mb-3">{{{icon 'key' 'size-6 opacity-50'}}}</span>
                <p class="font-medium">No keys yet. Make one for each app that needs access.</p>
              </td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      <div class="mt-4 border-t border-line/30 pt-4">
        <button class="btn btn-primary btn-sm shadow-sm w-full sm:w-auto" id="api-token-add">{{{icon 'plus' 'size-3.5'}}} New Key</button>
      </div>
      <script type="application/json" id="api-token-servers">{{jsonScript serverOptions}}</script>
    </div>
  {{/settings/card}}
</div>
<script type="application/json" id="settings-self">{{jsonScript selfUserId}}</script>
<script type="module" src="/js/pages/settings.js"></script>
