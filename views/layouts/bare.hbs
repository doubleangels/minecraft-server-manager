<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <title>{{title}} · Minecraft Server Manager</title>
  {{> app-head}}
</head>
{{! Centering via child margin:auto, not items/justify-center: a flex-centered
    child taller than the viewport gets its top clipped beyond scroll reach -
    auto margins center the same way but overflow gracefully. }}
<body class="flex min-h-dvh p-4 pt-[max(1rem,env(safe-area-inset-top))] pr-[max(1rem,env(safe-area-inset-right))] pb-[max(1rem,env(safe-area-inset-bottom))] pl-[max(1rem,env(safe-area-inset-left))] *:m-auto">
  {{{body}}}
  <script type="module" src="/js/app.js"></script>
</body>
</html>
