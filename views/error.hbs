<div class="grid min-h-[50vh] place-items-center">
  <div class="text-center p-6">
    <div class="text-6xl font-extrabold tracking-tight text-danger">{{code}}</div>
    <h2 class="mt-4 text-xl font-bold tracking-tight text-ink">{{title}}</h2>
    <p class="mt-1.5 max-w-md text-sm text-ink-faint leading-relaxed">{{message}}</p>
    <a href="/" class="btn btn-primary mt-6 shadow-md">{{{icon 'arrow-left' 'size-4'}}} Back to the Dashboard</a>
  </div>
</div>
