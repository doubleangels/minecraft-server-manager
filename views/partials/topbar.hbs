{{! Safe-area padding: installed on a phone (viewport-fit=cover, translucent
    status bar) the page runs under the status bar and notch; these keep the
    bar's content clear of them. They resolve to 0 in a normal browser tab.
    The bar is opaque (page content must never show through it). backdrop-blur
    stays only because it makes the header the containing block for the task
    tray's fixed drop sheet on a phone; behind a solid background it draws nothing. }}
<header class="sticky top-0 z-20 flex items-center gap-2 border-b border-line bg-surface/90 py-2.5 pt-[max(0.6rem,env(safe-area-inset-top))] pr-[max(1rem,env(safe-area-inset-right))] pl-[max(1rem,env(safe-area-inset-left))] sm:gap-3.5 sm:py-3.5 sm:pt-[max(0.85rem,env(safe-area-inset-top))] backdrop-blur-xl sm:pr-[max(1.5rem,env(safe-area-inset-right))] sm:pl-[max(1.5rem,env(safe-area-inset-left))]">
  <button id="sidebar-toggle" class="btn btn-ghost btn-sm lg:hidden" aria-label="Toggle navigation">{{{icon 'menu' 'size-4'}}}</button>
  {{! min-w-0: a flex child won't shrink below its intrinsic width, so without
      it `truncate` never engages and a long title pushes the actions off-screen. }}
  <h1 class="min-w-0 flex-1 truncate text-base font-bold tracking-tight text-ink sm:text-lg">{{title}}</h1>
  {{! A phone keeps four controls here (menu, tasks, create, account) so the
      title has room; theme and the installed app's Refresh move into the
      account menu below sm (pull to refresh also reloads there). }}
  <div class="ml-auto flex shrink-0 items-center gap-1.5 sm:gap-2.5">
    <div id="task-tray" class="relative hidden">
      <button class="btn btn-ghost btn-sm relative" aria-label="Background tasks" data-tip="Background tasks in progress and just finished.">
        {{! The list icon stays put; the round ring around it spins only while something
            runs (a square ring would swing its corners as it turned). Reduced motion
            gets a still, full ring instead of a frozen arc. }}
        {{{icon 'list-checks' 'size-4'}}}
        <span data-task-ring class="pointer-events-none absolute inset-0 m-auto hidden size-6 animate-spin rounded-full border-2 border-ok/25 border-t-ok motion-reduce:animate-none motion-reduce:border-ok"></span>
        <span data-task-count class="absolute -right-1 -top-1 grid min-w-4 place-items-center rounded-full bg-ok px-1 text-[10px] font-bold leading-4 text-white">0</span>
      </button>
      <div data-task-panel class="card hidden origin-top-right shadow-modal animate-[menu-in_.12s_ease-out] fixed inset-x-2 top-[calc(100%+0.5rem)] sm:absolute sm:left-auto sm:right-0 sm:top-10 sm:w-80 overflow-hidden">
        <div class="border-b border-line px-3.5 py-2.5 eyebrow">Background Tasks</div>
        <div data-task-list class="max-h-96 overflow-y-auto"></div>
      </div>
    </div>
    {{! Label hides below sm: (icon-only) - the topbar is already tight on a
        phone (hamburger + title + this + theme + avatar); aria-label keeps it
        announced to screen readers regardless of which span is visible. }}
    <a href="/servers/new" class="btn btn-primary btn-sm shadow-sm" aria-label="Create a Server" data-tip="Create a new server.">{{{icon 'plus' 'size-3.5'}}} <span class="hidden sm:inline">Create a Server</span></a>
    {{! Installed app only: there is no browser reload button there. }}
    <button type="button" class="btn btn-ghost btn-sm hidden sm:[@media(display-mode:standalone)]:inline-flex" data-app-refresh aria-label="Refresh" data-tip="Reload this page.">{{{icon 'refresh-cw' 'size-4'}}}</button>
    <button id="theme-toggle" class="btn btn-ghost btn-sm hidden sm:inline-flex" aria-label="Toggle theme" data-tip="Switch between the dark and light theme.">
      <span data-theme-icon="dark">{{{icon 'moon' 'size-4'}}}</span><span data-theme-icon="light" class="hidden">{{{icon 'sun' 'size-4'}}}</span>
    </button>
    <button class="grid size-8 place-items-center overflow-hidden rounded-full ring-2 ring-link/30 bg-link/20 text-xs font-bold text-link shadow-xs transition hover:ring-link [@media(pointer:coarse)]:size-11" data-menu="user-menu" data-tip="{{user.username}} ({{capitalize user.role}})" data-user-totp-enabled="{{#if user.totpEnabled}}1{{/if}}" data-user-avatar="{{user.avatar}}">
      {{#if (avatarSrc user.avatar)}}
        <img src="{{avatarSrc user.avatar}}" alt="" class="size-full object-contain">
      {{else}}
        {{initial user.username}}
      {{/if}}
    </button>
    <template id="user-menu">
      <div class="border-b border-line px-3 py-2 text-xs text-ink-faint">{{user.username}} · {{capitalize user.role}}</div>
      <button type="button" class="w-full text-left" data-open-avatar-picker>{{{icon 'user' 'size-4'}}} Profile Picture</button>
      <button type="button" class="w-full text-left" data-open-2fa>{{{icon 'shield-check' 'size-4'}}} 2FA</button>
      {{! Phone-only copies of the topbar controls that move in here below sm. }}
      <button type="button" class="w-full text-left sm:hidden" data-theme-toggle>{{{icon 'sun-moon' 'size-4'}}} Switch Theme</button>
      <button type="button" class="hidden w-full text-left [@media(display-mode:standalone)]:block sm:[@media(display-mode:standalone)]:hidden" data-app-refresh>{{{icon 'refresh-cw' 'size-4'}}} Reload Page</button>
      {{! Shown by pwa.js only when this browser can install the app, or turn
          notifications on (each starts hidden and is revealed when it applies). }}
      <button type="button" class="hidden w-full text-left" data-install-app>{{{icon 'download' 'size-4'}}} Install App</button>
      <button type="button" class="hidden w-full text-left" data-enable-notifications>{{{icon 'bell' 'size-4'}}} Notify Me When Tasks Finish</button>
      <div class="my-1 border-t border-line"></div>
      <form method="post" action="/logout"><button type="submit" class="w-full text-left text-danger hover:text-danger">{{{icon 'log-out' 'size-4'}}} Sign Out</button></form>
    </template>
  </div>
</header>
