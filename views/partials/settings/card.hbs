{{!-- Settings section card - block partial so every section shares one header
    treatment, padding and rhythm:

      {{#> settings/card heading="Panel" desc="Optional one-liner."}}
        …section body…
      {{/settings/card}}

    Params: heading, desc (optional sub-line), wide (span both columns at lg),
    id (optional element id). --}}
<section class="card p-5 sm:p-6{{#if wide}} lg:col-span-2{{/if}}"{{#if id}} id="{{id}}"{{/if}}>
  <div class="mb-5 border-b border-line/50 pb-4">
    <h3 class="text-lg font-semibold tracking-tight text-ink">{{heading}}</h3>
    {{#if desc}}<p class="mt-1.5 max-w-prose text-sm text-ink-soft">{{desc}}</p>{{/if}}
  </div>
  {{> @partial-block}}
</section>
