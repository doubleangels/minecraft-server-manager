{{#if combined.breakdown.length}}
  <div class="grid min-w-0 grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="card stat-tile">
      <div class="stat-label">
        <span class="grid size-6 shrink-0 place-items-center rounded-full bg-grass-500/15 text-ok">{{{icon 'memory-stick' 'size-3.5'}}}</span>
        <span>Total Memory</span>
      </div>
      <div class="stat-value"><span data-combined-total-mem>{{combined.memoryUsedMb}}</span><span class="stat-unit"> MB</span></div>
      <div class="stat-sub"><span data-combined-total-mem-limit>{{combined.memoryLimitMb}}</span> MB allotted</div>
    </div>
    <div class="card stat-tile">
      <div class="stat-label">
        <span class="grid size-6 shrink-0 place-items-center rounded-full bg-diamond-400/15 text-link">{{{icon 'cpu' 'size-3.5'}}}</span>
        <span>Total CPU</span>
      </div>
      <div class="stat-value"><span data-combined-total-cpu>{{combined.cpuTotal}}</span><span class="stat-unit">%</span></div>
      <div class="stat-sub">across <span data-combined-total-running>{{combined.running}}</span> {{plural combined.running 'server' 'servers'}}</div>
    </div>
    <div class="card stat-tile">
      <div class="stat-label">
        <span class="grid size-6 shrink-0 place-items-center rounded-full bg-gold-400/15 text-warn">{{{icon 'users' 'size-3.5'}}}</span>
        <span>Players Online</span>
      </div>
      <div class="stat-value"><span data-combined-total-players>{{combined.playersOnline}}</span><span class="stat-unit"> / <span data-combined-total-players-max>{{combined.playersMax}}</span></span></div>
      <div class="stat-sub">across <span data-combined-total-running-2>{{combined.running}}</span> {{plural combined.running 'server' 'servers'}}</div>
    </div>
    <div class="card stat-tile">
      <div class="stat-label">
        <span class="grid size-6 shrink-0 place-items-center rounded-full bg-ok/15 text-ok">{{{icon 'server' 'size-3.5'}}}</span>
        <span>Running</span>
      </div>
      <div class="stat-value text-ok" data-combined-total-running-3>{{combined.running}}</div>
      <div class="stat-sub">server{{#unless (eq combined.running 1)}}s{{/unless}} live now</div>
    </div>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div class="card p-5">
      <div class="mb-3 flex items-center justify-between">
        <h3 class="font-bold flex items-center gap-2">
          <span>Memory Usage</span>
          <span class="badge badge-info font-mono">{{pct combined.memoryUsedMb combined.memoryLimitMb}}%</span>
        </h3>
        <span class="text-xs font-medium text-ink-faint">used vs allotted</span>
      </div>
      <div class="flex h-4 w-full overflow-hidden rounded-full bg-inset/70 p-0.5 border border-line/60 shadow-inner" data-combined-bar="memory" data-combined-limit="{{combined.memoryLimitMb}}">
        {{#each combined.breakdown}}
          <div data-combined-seg="memory" data-seg-id="{{this.id}}" data-seg-mb="{{this.memUsedMb}}" data-seg-limit="{{this.memLimitMb}}" class="h-full rounded-full transition-all duration-300 shadow-sm" style="width: {{pct this.memUsedMb ../combined.memoryLimitMb}}%; background: {{this.accent}};" title="{{this.name}}"></div>
        {{/each}}
      </div>
      <div class="mt-2.5 flex items-baseline justify-between gap-2 break-words text-xs font-medium text-ink-faint">
        <span class="text-ink font-semibold" data-combined-mem-total>{{combined.memoryUsedMb}} MB</span>
        <span>{{combined.memoryLimitMb}} MB total allotted</span>
      </div>
    </div>

    <div class="card p-5">
      <div class="mb-3 flex items-center justify-between">
        <h3 class="font-bold flex items-center gap-2">
          <span>CPU Capacity</span>
          <span class="badge badge-info font-mono">{{pct combined.cpuTotal combined.cpuCapacity}}%</span>
        </h3>
        <span class="text-xs font-medium text-ink-faint">share of allotted cores</span>
      </div>
      <div class="flex h-4 w-full overflow-hidden rounded-full bg-inset/70 p-0.5 border border-line/60 shadow-inner" data-combined-bar="cpu" data-combined-cap="{{combined.cpuCapacity}}">
        {{#each combined.breakdown}}
          <div data-combined-seg="cpu" data-seg-id="{{this.id}}" data-seg-cpu="{{this.cpuPct}}" data-seg-cap="{{mul this.cpus 100}}" class="h-full rounded-full transition-all duration-300 shadow-sm" style="width: {{pct this.cpuPct ../combined.cpuCapacity}}%; background: {{this.accent}};" title="{{this.name}}"></div>
        {{/each}}
      </div>
      <div class="mt-2.5 flex items-baseline justify-between gap-2 break-words text-xs font-medium text-ink-faint">
        <span class="text-ink font-semibold" data-combined-cpu-total>{{combined.cpuTotal}}%</span>
        <span>{{combined.cpuCapacity}}% core capacity</span>
      </div>
    </div>
  </div>

  <div class="mt-4 card p-5">
    <div class="mb-3 flex items-center justify-between border-b border-line pb-3">
      <h3 class="font-bold flex items-center gap-2">
        {{{icon 'activity' 'size-4 text-ok'}}}
        <span>Per-Server Live Usage</span>
      </h3>
      <span class="text-xs text-ink-faint">{{combined.breakdown.length}} active {{plural combined.breakdown.length 'server' 'servers'}}</span>
    </div>
    <div class="space-y-1 text-sm">
      {{#each combined.breakdown}}
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 rounded-xl px-2.5 py-2.5 transition hover:bg-inset/50" data-combined-row="{{this.id}}" data-row-players="{{this.playersOnline}}" data-row-players-max="{{this.playersMax}}">
          <span class="size-3 shrink-0 rounded-full ring-2 ring-surface shadow-xs" style="background: {{this.accent}}"></span>
          <a href="/servers/{{this.id}}" class="min-w-0 font-semibold text-ink hover:text-ok hover:underline">{{this.name}}</a>
          <span class="ml-auto grid w-full min-w-0 grid-cols-3 gap-3 text-xs tabular-nums sm:w-auto sm:grid-cols-none sm:gap-6 sm:text-right">
            <span class="flex items-center justify-between gap-1.5 sm:block"><span class="text-ink-faint sm:hidden">CPU</span><span class="font-semibold text-ink" data-combined-row-cpu="{{this.id}}">{{this.cpuPct}}%</span></span>
            <span class="flex items-center justify-between gap-1.5 sm:block"><span class="text-ink-faint sm:hidden">Mem</span><span class="font-semibold text-ink" data-combined-row-mem="{{this.id}}">{{this.memUsedMb}} <span class="text-ink-faint font-normal">MB</span></span></span>
            <span class="flex items-center justify-between gap-1.5 sm:block"><span class="text-ink-faint sm:hidden">Players</span><span class="font-semibold text-ink" data-combined-row-players="{{this.id}}">{{this.playersOnline}}<span class="text-ink-faint font-normal">/{{this.playersMax}}</span></span></span>
          </span>
        </div>
      {{/each}}
    </div>
  </div>
{{else}}
  <div class="card p-6 text-center text-sm text-ink-faint">
    {{{icon 'server-off' 'size-8 mx-auto mb-2 opacity-50'}}}
    <p>No servers are running right now. Start a server to see combined resource usage here.</p>
  </div>
{{/if}}
