{{> page-header heading="SCHEDULES" sub="Automatic tasks that run on a schedule, for a single server or for the panel itself."}}

<div class="mb-4 flex flex-col sm:flex-row sm:items-center gap-2">
  <button class="btn btn-primary shadow-sm" id="schedule-new">{{{icon 'plus' 'size-4'}}} New Task</button>
</div>

{{#if schedules.length}}
<div class="card overflow-hidden">
  <div class="border-b border-line/50 bg-inset/10 p-4 font-bold tracking-wide text-sm flex items-center justify-between gap-4">
    <div class="flex items-center gap-2">{{{icon 'calendar-clock' 'size-4 text-link'}}} Scheduled Tasks</div>
    <span class="text-[10px] uppercase tracking-widest text-ink-faint bg-inset/50 border border-line/30 px-2 py-0.5 rounded shadow-inner font-bold">{{schedules.length}} Active</span>
  </div>
  
  <div class="overflow-x-auto">
    <table class="table-base table-stack w-full text-sm" id="schedules-table">
    <thead class="bg-canvas/50">
      <tr class="text-[10px] uppercase tracking-widest text-ink-faint">
        <th class="font-bold py-3 pl-5">Server</th>
        <th class="font-bold py-3">Task</th>
        <th class="font-bold py-3">Cron</th>
        <th class="text-right font-bold py-3">Next Run</th>
        <th class="font-bold py-3">Enabled</th>
        <th class="text-right font-bold py-3 pr-5">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line/30">
      {{#each schedules}}
        <tr class="hover:bg-inset/10 transition-colors group" data-schedule-row data-schedule-id="{{id}}" data-server-id="{{serverId}}" data-task-type="{{taskType}}" data-task="{{task}}" data-cron="{{cron}}" data-payload="{{jsonAttr payload}}">
          {{! Global rows are faint by the serverId FACT, not by matching the display string. }}
          <td data-th="Server" class="p-3 pl-5 {{#unless serverId}}text-ink-faint font-medium{{else}}font-bold text-ink{{/unless}}">{{server}}</td>
          <td data-th="Task" class="p-3 font-bold text-ink-soft">{{task}}</td>
          <td data-th="Cron" class="p-3">
            <span class="font-mono text-xs text-ink-soft bg-inset/30 px-1.5 py-0.5 rounded border border-line/30">{{cron}}</span>
          </td>
          {{! nextMs + the panel-TZ hydrator: the table used to show UTC while
              the modal preview showed panel time for the SAME schedule. }}
          <td data-th="Next run" class="p-3 whitespace-nowrap sm:text-right tabular-nums text-[11px] font-bold text-ink-faint">{{#if nextMs}}<span data-ts="{{nextMs}}">{{next}}</span>{{else}}<span class="opacity-50">Not scheduled</span>{{/if}}</td>
          <td data-th="Enabled" class="p-3">
            <label class="msm-toggle"><input type="checkbox" data-schedule-toggle {{#if enabled}}checked{{/if}}><span></span></label>
          </td>
          <td data-th="" class="p-3 sm:text-right pr-5">
            <div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap sm:opacity-0 group-hover:opacity-100 transition-opacity">
              <button class="btn btn-ghost btn-sm text-ink-faint hover:text-ink hover:bg-inset/30 rounded-full size-8 p-0 grid place-items-center" data-schedule-edit data-tip="Edit this schedule.">{{{icon 'pencil' 'size-4'}}}</button>
              <button class="btn btn-ghost btn-sm text-danger hover:bg-danger/10 rounded-full size-8 p-0 grid place-items-center" data-schedule-delete data-tip="Delete this schedule." aria-label="Delete schedule">{{{icon 'trash-2' 'size-4'}}}</button>
            </div>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
  </div>
</div>
{{else}}
  {{> empty-state iconName='calendar-clock' title='No Scheduled Tasks Yet' message='Automate restarts, backups, and console commands on a schedule. Use New Task above to create the first one.'}}
{{/if}}

<div id="msm-schedule-data" hidden data-servers="{{jsonAttr serverOptions}}" data-task-types="{{jsonAttr taskTypes}}"></div>
<script type="module" src="/js/pages/schedules.js"></script>
