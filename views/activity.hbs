{{> page-header heading="ACTIVITY" sub="Every action across every server: who did what, when, with the details on record."}}
{{> insight-tabs}}

{{#if (or events.length (or filters.q (or filters.server filters.type)))}}
<form class="mb-4 flex flex-wrap items-center gap-2" method="get" action="/activity" id="activity-filters">
  <input class="input w-full sm:w-auto sm:max-w-xs sm:flex-1" type="search" aria-label="Search events" name="q" value="{{filters.q}}" placeholder="Search events…" autocomplete="off">
  {{! Phone: both filters share one row; sm+: they sit inline at natural width. }}
  <div class="grid w-full grid-cols-2 gap-2 sm:flex sm:w-auto">
  <select class="input w-full sm:w-auto" name="server" data-label="Filter by server">
    <option value="">All Servers</option>
    {{#each servers}}<option value="{{id}}" {{#if (eq id ../filters.server)}}selected{{/if}}>{{name}}</option>{{/each}}
  </select>
  <select class="input w-full sm:w-auto" name="type" data-label="Filter by type">
    <option value="">All Types</option>
    {{#each types}}<option value="{{this}}" {{#if (eq this ../filters.type)}}selected{{/if}}>{{this}}</option>{{/each}}
  </select>
  </div>
  <button class="btn btn-sm" type="submit">{{{icon 'search' 'size-3.5'}}} Apply Filters</button>
  <div class="ml-auto flex gap-1">
    <a class="btn btn-sm" href="/api/events/export?format=csv{{exportQs}}" data-tip="Export the filtered events as CSV.">{{{icon 'download' 'size-3.5'}}} CSV</a>
    <a class="btn btn-sm" href="/api/events/export?format=json{{exportQs}}" data-tip="Export the filtered events as JSON.">{{{icon 'download' 'size-3.5'}}} JSON</a>
  </div>
</form>

<div class="card">
  <ol class="divide-y divide-line">
    {{#each events}}
      {{! The summary keeps a readable minimum width; on a phone the server,
          actor and time drop to their own line instead of squeezing it. }}
      <li class="flex flex-wrap items-center gap-x-2 gap-y-1 p-3 text-sm">
        <span class="badge shrink-0">{{eventType type}}</span>
        <span class="min-w-[12rem] flex-1 break-words">{{summary}}</span>
        <span class="flex min-w-0 max-w-full flex-wrap items-center gap-x-2 text-xs">
          {{#if serverId}}
            <a href="/servers/{{serverId}}" class="min-w-0 max-w-full truncate text-link hover:underline">{{server}}</a>
          {{else}}
            <span class="min-w-0 max-w-full truncate text-ink-faint">{{server}}</span>
          {{/if}}
          <span class="whitespace-nowrap text-ink-faint">{{actor}} · <span data-ts="{{ts}}">{{ts}}</span></span>
        </span>
        {{#if hasLog}}<button class="btn btn-ghost btn-sm shrink-0" data-event-excerpt data-event-id="{{id}}" data-event-type="{{type}}" data-tip="View the captured log.">{{{icon 'file-text' 'size-3.5'}}}</button>{{/if}}
      </li>
    {{else}}
      <li class="p-10 text-center text-sm text-ink-faint">No events match these filters.</li>
      {{! wording kept in sync with the History tab's empty state }}
    {{/each}}
  </ol>
  {{#if events.length}}
  <div class="flex items-center justify-between border-t border-line p-3 text-xs text-ink-faint">
    <span>Showing {{from}} to {{to}} of {{total}} events</span>
    <div class="flex items-center gap-2">
      {{#if prevHref}}<a class="btn btn-ghost btn-sm" href="{{prevHref}}" aria-label="Previous page">{{{icon 'chevron-left' 'size-4'}}}</a>{{else}}<button class="btn btn-ghost btn-sm" disabled aria-label="Previous page">{{{icon 'chevron-left' 'size-4'}}}</button>{{/if}}
      <span class="tabular-nums">Page {{page}} of {{pages}}</span>
      {{#if nextHref}}<a class="btn btn-ghost btn-sm" href="{{nextHref}}" aria-label="Next page">{{{icon 'chevron-right' 'size-4'}}}</a>{{else}}<button class="btn btn-ghost btn-sm" disabled aria-label="Next page">{{{icon 'chevron-right' 'size-4'}}}</button>{{/if}}
    </div>
  </div>
  {{/if}}
</div>
{{else}}
  {{> empty-state iconName='history' title='No Activity Yet' message='Every action across every server lands here: starts and stops, backups, updates, and player management.'}}
{{/if}}
<script type="module" src="/js/pages/activity.js"></script>
