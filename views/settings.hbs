{{> page-header heading="PANEL SETTINGS" sub="How the panel itself behaves: its address and clock, what new servers start with, how long backups are kept, and the outside services it talks to."}}

{{! One ordered column with a jump bar, the same layout as a server's
    Configuration page. User accounts, sign-in security and per-server access
    live together on Users & Permissions. }}
<div class="lg:grid lg:grid-cols-[11rem_minmax(0,1fr)] lg:gap-6" id="settings-page">
  <nav class="mb-4 flex flex-nowrap overflow-x-auto pb-1 gap-1.5 lg:sticky lg:top-24 lg:mx-0 lg:mb-0 lg:flex-col lg:self-start lg:overflow-visible lg:px-0" aria-label="Settings sections" data-settings-jump>
    <a class="subtab shrink-0" href="#sec-panel" data-jump="sec-panel">General</a>
    <a class="subtab shrink-0" href="#sec-defaults" data-jump="sec-defaults">New Server Defaults</a>
    <a class="subtab shrink-0" href="#retention-card" data-jump="retention-card">Backups</a>
    <a class="subtab shrink-0" href="#sec-keys" data-jump="sec-keys">Mod Site Keys</a>
    <a class="subtab shrink-0" href="#api-tokens-card" data-jump="api-tokens-card">Public API</a>
    <a class="subtab shrink-0" href="/settings/permissions">{{{icon 'shield-check' 'size-3.5'}}} Users</a>
  </nav>

  <div class="min-w-0 space-y-5 [&>*]:min-w-0 [&>section]:scroll-mt-32">
  {{#> settings/card heading="General" id="sec-panel" desc="The address players see, the panel's clock, and its version."}}
    <div class="space-y-5">
      <div data-dirty-group="the public domain">
        <label class="label" for="set-domain">Public domain</label>
        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-2">
          <input class="input min-w-0 flex-1" id="set-domain" placeholder="mc.example.com" value="{{publicHost}}" autocomplete="off" spellcheck="false">
          <button class="btn" data-dirty-save id="set-domain-save">Save Domain</button>
        </div>
        <p class="help">Shown to players instead of your IP address in connect addresses (for example, <span class="font-mono">mc.example.com:25565</span>). Leave blank to use the server's IP address. Enter the domain only, with no scheme or port.</p>
        {{#if cookieSecureWarning}}
        <div class="notice notice-danger mt-2">
          {{{icon 'triangle-alert' 'size-4 mt-0.5 shrink-0 text-danger'}}}
          <div>
            <span class="font-semibold text-danger">The login cookie is not marked Secure.</span>
            <span>A public domain is set, but the secure-cookie option is not. If this panel is reachable over plain HTTP, the login cookie can be read in transit. Put the panel behind HTTPS and set <span class="font-mono">COOKIE_SECURE=true</span>, or <span class="font-mono">COOKIE_SECURE=auto</span> together with <span class="font-mono">TRUST_PROXY</span>, in the environment. See the README for details.</span>
          </div>
        </div>
        {{/if}}
      </div>

      <div data-dirty-group="the time zone">
        <span class="label">Time zone &amp; region</span>
        {{! data-native only until tzPicker fills them - it enhances post-fill. }}
        <div class="grid gap-2 sm:grid-cols-2">
          <select class="input" id="set-tz" data-native aria-label="Time zone" data-label="Time zone"></select>
          <select class="input" id="set-country" data-native aria-label="Country" data-label="Country"></select>
        </div>
        <div class="mt-2 flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-2">
          <button class="btn" data-dirty-save id="set-loc-save">Save Time Zone</button>
          <span class="help mt-0" id="set-loc-note"></span>
        </div>
        <p class="help">Controls how dates and player-activity times are shown across the panel. "Auto" follows this machine's system settings.</p>
      </div>

      <div class="border-t border-line pt-4">
        <span class="label">Panel version</span>
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-2">
          <span class="font-mono text-sm">v{{panel.version}}</span>
          <button class="btn" id="msm-update-btn">Check for Updates</button>
        </div>
        <div id="msm-update-out"></div>
        <p class="help">Compares the installed version with the latest release on GitHub. You download and install the update yourself. The panel never modifies its own files.</p>
      </div>

      <div class="border-t border-line pt-4">
        <span class="label">Bind address &amp; port</span>
        <dl class="grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
          <div><dt class="text-xs text-ink-faint">Bind Address</dt><dd class="font-mono font-medium">{{panel.host}}</dd></div>
          <div><dt class="text-xs text-ink-faint">Port</dt><dd class="font-mono font-medium">{{panel.port}}</dd></div>
        </dl>
        <p class="help">Set these in <span class="font-mono">.env</span> (PANEL_HOST and PANEL_PORT). A restart applies the changes. Theme is per-browser, set with the topbar toggle.</p>
      </div>
    </div>
  {{/settings/card}}

  {{#> settings/card heading="New Server Defaults" id="sec-defaults" guard="the new server defaults" desc="These pre-fill the create wizard, apply when a server is created via the API or a blueprint, and drive the quota-bar colors on the dashboard."}}
        <div class="grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
          <div>
            <label class="label" for="dflt-heap">Java heap (MB)</label>
            <input class="input" id="dflt-heap" type="number" inputmode="numeric" value="{{defaults.heapMb}}" data-default="{{defaultsBase.heapMb}}">
          </div>
          <div>
            <label class="label" for="dflt-container">Container limit (MB)</label>
            <input class="input" id="dflt-container" type="number" inputmode="numeric" value="{{defaults.containerMemoryMb}}" data-default="{{defaultsBase.containerMemoryMb}}">
            <p class="help">Usually 50% above the heap. Ignored when the wizard sets its own.</p>
          </div>
          <div>
            <label class="label" for="dflt-cpus">CPU cores</label>
            <input class="input" id="dflt-cpus" type="number" inputmode="decimal" step="0.5" min="0" value="{{defaults.cpus}}" data-default="{{defaultsBase.cpus}}">
            <p class="help">0 = no limit on CPU usage.</p>
          </div>
          <div>
            <label class="label" for="dflt-quota">Disk quota (GB)</label>
            <input class="input" id="dflt-quota" type="number" inputmode="numeric" value="{{defaults.diskQuotaGb}}" data-default="{{defaultsBase.diskQuotaGb}}">
            <p class="help">0 = storage use is not limited.</p>
          </div>
          <div>
            <label class="label" for="dflt-warnpct">Quota warn (%)</label>
            <input class="input" id="dflt-warnpct" type="number" inputmode="numeric" min="0" max="99" value="{{defaults.quotaWarnPct}}" data-default="{{defaultsBase.quotaWarnPct}}">
          </div>
          <div>
            <label class="label" for="dflt-critpct">Quota critical (%)</label>
            <input class="input" id="dflt-critpct" type="number" inputmode="numeric" min="1" max="100" value="{{defaults.quotaCriticalPct}}" data-default="{{defaultsBase.quotaCriticalPct}}">
          </div>
        </div>
        <div class="mt-2 flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-2">
          <button class="btn" data-dirty-save id="dflt-save">Save Defaults</button>
          <button class="btn btn-ghost" id="dflt-restore">Restore Built-ins</button>
          <span class="help mt-0" id="dflt-note"></span>
        </div>
  {{/settings/card}}

  {{#> settings/card heading="Backup Retention" id="retention-card" guard="the backup retention" desc="How many backups each server keeps of each kind, plus optional age and size limits. A server trims its older backups each time it makes a new one, and can set any of these differently on its Backups tab."}}
    <div data-retention-form>
      <div data-retention-fields>
        {{> backups/retention-fields prefix="ret" values=retention}}
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button class="btn" data-dirty-save data-retention-save>Save Retention</button>
        <button class="btn btn-ghost" id="ret-builtins" data-values="{{jsonAttr retentionDefaults}}">Fill In Built-ins</button>
      </div>
    </div>
  {{/settings/card}}

  {{#> settings/card heading="Mod Site Keys" id="sec-keys" guard="the CurseForge key" desc="Keys the panel uses to reach mod sites on your behalf. Stored encrypted."}}
    <div class="space-y-5">
      <div>
        <label class="label" for="set-cf-key">CurseForge API key</label>
        {{! min-w-0 + flex-wrap: the monospace placeholder would otherwise refuse
            to shrink and push the page wider than a narrow screen; wrapping lets
            the buttons drop to their own row. }}
        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-2">
          <input class="input min-w-0 flex-1 font-mono" id="set-cf-key" type="password" placeholder="{{#if cfKeyMasked}}{{cfKeyMasked}} (stored){{else}}paste your key from console.curseforge.com{{/if}}" autocomplete="off">
          <button class="btn" data-dirty-save id="set-cf-save">Save Key</button>
          <button class="btn btn-ghost" id="set-cf-test" data-tip="Test the stored key against CurseForge.">Test Key</button>
        </div>
        <p class="help">Needed for automatic CurseForge modpacks and CurseForge mod downloads. New keys are checked against CurseForge before they're saved.</p>
      </div>
      <div>
        <span class="label">Modrinth</span>
        <p class="help">No key needed. Modrinth's public API is used directly.</p>
      </div>
    </div>
  {{/settings/card}}

  {{#> settings/card heading="Public API" id="api-tokens-card" desc="Let another app or website read your servers' status, like a live status page, an uptime monitor, or a Discord bot. It is read-only: nothing outside can start, stop, or change anything."}}
    {{> settings/toggle-row
        label="Let Outside Apps Read Status"
        help="Switches on by itself when you make your first key below. Turn it off any time to pause outside access without losing your keys."
        inputId="public-api-enabled"
        checked=publicApiEnabled}}

    <div class="mt-4 border-t border-line pt-4">
      <p class="help mt-0 max-w-prose">Each app connects with its own <b>access key</b> (sent as an <span class="font-mono">Authorization: Bearer</span> header). Make one key per app; anyone holding a key can see the servers you allow it: name, type, whether it's running, players online, and resource use. Cancel a key to cut that app off straight away.</p>
      <div class="mt-4 overflow-x-auto">
        <table class="table-base table-stack" id="api-tokens-table">
          <thead><tr><th>Name</th><th>Key</th><th>Can See</th><th>Created</th><th>Last Used</th><th>Expires</th><th>Status</th><th class="text-right">Actions</th></tr></thead>
          <tbody>
            {{#each apiTokens}}
              <tr data-token-id="{{id}}">
                <td data-th="Name" class="font-medium">{{label}}</td>
                <td data-th="Key" class="font-mono text-xs">{{tokenPrefix}}&hellip;</td>
                <td data-th="Can See">{{#if scope.all}}Every server{{else}}{{scope.serverIds.length}} server(s){{/if}}</td>
                <td data-th="Created" class="whitespace-nowrap text-xs text-ink-faint" data-ts="{{createdAt}}">{{createdAt}}</td>
                <td data-th="Last Used" class="whitespace-nowrap text-xs text-ink-faint">{{#if lastUsedAt}}<span data-ts="{{lastUsedAt}}">{{lastUsedAt}}</span>{{else}}never{{/if}}</td>
                <td data-th="Expires" class="whitespace-nowrap text-xs text-ink-faint">{{#if expiresAt}}<span data-ts="{{expiresAt}}">{{expiresAt}}</span>{{else}}never{{/if}}</td>
                <td data-th="Status">{{#if (eq status 'active')}}<span class="badge badge-ok">Active</span>{{else}}<span class="badge">{{status}}</span>{{/if}}</td>
                <td data-th="" class="text-right">
                  {{#unless revokedAt}}
                    <button class="btn btn-ghost btn-sm text-danger" data-token-revoke data-token-id="{{id}}" data-label="{{label}}">Cancel</button>
                  {{/unless}}
                </td>
              </tr>
            {{else}}
              <tr><td data-th="" colspan="8" class="text-sm text-ink-faint">No keys yet. Make one for each app that needs access.</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      <button class="btn btn-primary btn-sm mt-4 w-full sm:w-auto" id="api-token-add">{{{icon 'plus' 'size-3.5'}}} New Key</button>
      <script type="application/json" id="api-token-servers">{{jsonScript serverOptions}}</script>
    </div>
  {{/settings/card}}

  <section class="card flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:p-5">
    <div class="min-w-0 flex-1">
      <h3 class="font-semibold text-ink">Users &amp; Permissions</h3>
      <p class="mt-1 text-xs text-ink-faint">Accounts, roles, two-factor sign-in, sign-in lockouts and what each user may do on each server are managed in one place.</p>
    </div>
    <a class="btn shrink-0" href="/settings/permissions">{{{icon 'shield-check' 'size-4'}}} Open Users &amp; Permissions</a>
  </section>
  </div>
</div>
<script type="application/json" id="settings-self">{{jsonScript selfUserId}}</script>
<script type="module" src="/js/pages/settings.js"></script>
