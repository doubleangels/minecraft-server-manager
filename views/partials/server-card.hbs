{{! A crashed server, or one with unread crash reports, trades its accent edge
    for redstone and a red outline, so it stands out in a full grid. }}
<a href="/servers/{{id}}" data-server-card="{{id}}" data-server-name="{{name}}" data-server-status="{{status}}" data-players-online="{{players.online}}" class="card group relative block overflow-hidden transition-all duration-200 hover:border-line-strong hover:shadow-raised hover:-translate-y-0.5{{#if (or (eq status 'crashed') crashesUnread)}} border-danger/50 bg-danger/10{{/if}}"
   data-filter="{{name}} {{flavor}} {{mcVersion}}{{#each tags}} {{this}}{{/each}}"
   style="border-top: 3px solid {{#if (or (eq status 'crashed') crashesUnread)}}var(--color-danger){{else}}{{accent}}{{/if}}">
  <div class="p-4 sm:p-5">
    <div class="flex items-start gap-3.5">
      <img src="{{iconSrc this.icon}}" alt="" class="size-12 shrink-0 rounded-xl shadow-xs ring-1 ring-white/10" style="background: {{accent}}" data-fallback-icon="/icons/servers/grass.svg">

      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2">
          {{! Selection mark for bulk actions (shown only in Select mode). }}
          <span class="hidden size-5 shrink-0 place-items-center rounded-md border-2 border-line-strong text-canvas" data-select-mark aria-hidden="true">{{{icon 'check' 'size-3.5'}}}</span>
          <h3 class="truncate text-base font-bold text-ink group-hover:text-ok transition-colors">{{name}}</h3>
          {{#if updateAvailable}}<span class="badge badge-warn shrink-0" title="An update is available.">update</span>{{/if}}
          {{#if crashesUnread}}<span class="badge badge-danger shrink-0" title="New crash reports.">{{crashesUnread}} {{plural crashesUnread 'crash' 'crashes'}}</span>{{/if}}
        </div>
        <p class="mt-0.5 flex flex-wrap items-center gap-x-2 text-xs text-ink-faint">
          <span class="font-semibold text-ink-soft">{{flavor}}</span>
          <span>{{mcVersion}}</span>
        </p>
        {{! Copies what players type to connect: the public domain when one is
            set, else the LAN address. A button inside the card link - serverPins.js
            keeps the click from also opening the server. }}
        <div class="mt-1 flex flex-wrap items-center gap-2">
          <button type="button" class="inline-flex max-w-full items-center gap-1.5 rounded-sm bg-inset/50 px-2 py-0.5 font-mono text-[11px] text-ink-soft hover:bg-inset hover:text-link border border-line/40 transition-colors" data-copy="{{address}}" data-tip="Copy the address players connect to." aria-label="Copy {{address}}"><span class="truncate">{{address}}</span>{{{icon 'copy' 'size-3 shrink-0'}}}</button>
          {{#if mapEnabled}}<button type="button" class="inline-flex items-center gap-1 rounded-sm bg-link/10 px-2 py-0.5 text-[11px] font-medium text-link hover:bg-link/20 border border-link/20 transition-colors" data-open-href="/map/{{id}}/" data-tip="Open the live map in a new tab." aria-label="Open the live map for {{name}}">{{{icon 'map' 'size-3'}}} Map</button>{{/if}}
        </div>
      </div>
      <button type="button" class="-m-1 shrink-0 rounded-sm p-1.5 text-ink-faint transition hover:text-warn focus-visible:outline-2 focus-visible:outline-diamond-400 aria-pressed:text-warn" data-pin-server="{{id}}" aria-pressed="false" data-tip="Pin to the top of the list." aria-label="Pin {{name}}">{{{icon 'star' 'size-4'}}}</button>
      <span class="flex flex-col items-end gap-1">
        <span class="inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-semibold {{statusText status}}">
          <span class="status-dot relative {{statusDot status}} {{#if (statusPulse status)}}pulse{{/if}}"></span>
          {{statusLabel status}}
        </span>
        <span class="max-w-40 truncate text-right text-[11px] font-medium text-warn {{#unless statusDetail}}hidden{{/unless}}" data-status-detail="{{id}}" title="{{statusDetail}}">{{statusDetail}}</span>
      </span>
    </div>

    <div class="mt-3.5 grid grid-cols-3 gap-2 rounded-xl bg-inset/40 p-2.5 text-xs tabular-nums border border-line/40" data-card-stats>
      <div class="min-w-0">
        <div class="text-[11px] font-medium uppercase tracking-wider text-ink-faint">Players</div>
        <div class="mt-0.5 font-bold text-ink">{{players.online}}<span class="font-normal text-ink-faint">/{{players.max}}</span></div>
      </div>
      <div class="min-w-0">
        <div class="text-[11px] font-medium uppercase tracking-wider text-ink-faint">CPU</div>
        <div class="mt-0.5 font-bold text-ink">{{#if (eq status 'running')}}{{stats.cpuPct}}%{{else}}-{{/if}}</div>
      </div>
      <div class="min-w-0">
        <div class="text-[11px] font-medium uppercase tracking-wider text-ink-faint">Memory</div>
        <div class="mt-0.5 truncate font-bold text-ink"{{#if memory.note}} data-tip="{{memory.note}}"{{/if}}>{{#if (eq status 'running')}}{{stats.memUsedMb}}<span class="font-normal text-ink-faint"> / {{resources.containerMemoryMb}} MB</span>{{else}}-{{/if}}</div>
      </div>
    </div>

    <div class="mt-3" data-card-disk>
      <div class="mb-1.5 flex justify-between text-[11px] font-medium text-ink-faint">
        <span>Disk Usage</span><span>{{bytes disk.used}}{{#if disk.quota}} of {{bytes disk.quota}}{{else}} (No Quota){{/if}}</span>
      </div>
      <div class="meter"><div class="{{meterColor disk.used disk.quota}}" style="width: {{pct disk.used disk.quota}}%"></div></div>
    </div>

    <div class="mt-2.5 flex justify-between text-[11px]" data-card-backup>
      <span class="text-ink-faint">Last Backup</span>
      <span class="tabular-nums font-medium {{#if backup.stale}}font-semibold text-warn{{else}}text-ink-soft{{/if}}"{{#if backup.stale}} data-tip="No backup in over 7 days."{{/if}}>{{backup.text}}</span>
    </div>

    {{#if tags.length}}
      <div class="mt-3 flex flex-wrap gap-1.5" data-card-tags>
        {{#each tags}}<span class="chip">{{this}}</span>{{/each}}
      </div>
    {{/if}}
  </div>
</a>
