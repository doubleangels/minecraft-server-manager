<script nonce="{{cspNonce}}">
  // Apply the saved theme before first paint (no flash), and point the status
  // bar color at the same surface.
  try {
    var t = localStorage.getItem('msm-theme');
    if (!t) t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    document.documentElement.dataset.theme = t;
    var m = document.querySelector('meta[name="theme-color"]');
    if (m) m.setAttribute('content', t === 'light' ? '#fcfdfd' : '#16191c');
  } catch (e) {}
</script>
