{{> page-header heading="WORLD LIBRARY" sub="Every saved world in one place. Upload archives, snapshot them from servers, install them anywhere, and copy them between servers."}}

<div data-worlds-page class="contents">
  <div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:flex-wrap gap-2">
    <button class="btn btn-primary shadow-sm" id="world-upload" data-tip="Any .zip or .tar archive. The world root is found automatically (level.dat anywhere, .mcworld, or Bukkit split folders).">{{{icon 'upload' 'size-4'}}} Upload World</button>
    {{! button labels kept in sync with the per-server Worlds tab }}
    <button class="btn shadow-sm" id="world-extract" data-tip="Save a server's live world into the library.">{{{icon 'camera' 'size-4'}}} Save to Library</button>
  </div>

  {{#if worlds.length}}
  <div class="card overflow-hidden">
    <div class="border-b border-line/50 bg-inset/10 p-4 font-bold tracking-wide text-sm flex items-center justify-between gap-4">
      <div class="flex items-center gap-2">{{{icon 'earth' 'size-4 text-link'}}} Saved Worlds</div>
      <span class="text-[10px] uppercase tracking-widest text-ink-faint bg-inset/50 border border-line/30 px-2 py-0.5 rounded shadow-inner font-bold">{{worlds.length}} {{plural worlds.length 'World' 'Worlds'}}</span>
    </div>
    
    <div class="overflow-x-auto">
      <table class="table-base table-stack w-full text-sm" id="worlds-table">
      <thead class="bg-canvas/50">
        <tr class="text-[10px] uppercase tracking-widest text-ink-faint">
          <th class="font-bold py-3 pl-5">World</th>
          <th class="font-bold py-3">Source</th>
          <th class="font-bold py-3">Compatibility</th>
          <th class="text-right font-bold py-3">Size</th>
          <th class="text-right font-bold py-3 pr-5">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line/30">
        {{#each worlds}}
          <tr class="hover:bg-inset/10 transition-colors group" data-world-row data-id="{{id}}" data-name="{{name}}" data-size="{{size}}">
            <td data-th="" class="sm:w-full sm:max-w-0 p-3 pl-5">
              <div class="flex items-center gap-3">
                <div class="grid size-10 place-items-center rounded-lg bg-inset/40 border border-line/50 shadow-inner shrink-0 text-link">
                  {{{icon 'earth' 'size-5'}}}
                </div>
                <div class="min-w-0">
                  <div class="truncate font-bold text-ink" title="{{name}}">{{name}}</div>
                  <div class="truncate text-[11px] text-ink-faint mt-0.5 font-medium"><span data-ts="{{created}}">{{created}}</span> <span class="mx-1 opacity-50">·</span> <span class="font-mono">{{hash}}</span></div>
                </div>
              </div>
            </td>
            <td data-th="Source" class="text-xs text-ink-soft font-medium p-3">{{source}}</td>
            <td data-th="Compatibility" class="p-3">
              {{#if flavor}}
                <span class="chip bg-inset/50 border-line/30 text-[10px] uppercase font-bold tracking-wider py-0.5 px-2">{{flavor}}{{#if mcVersion}} <span class="text-ink ml-0.5">{{mcVersion}}</span>{{/if}}</span>
              {{else if mcVersion}}
                <span class="chip bg-inset/50 border-line/30 text-[10px] uppercase font-bold tracking-wider py-0.5 px-2">{{mcVersion}}</span>
              {{else}}
                <span class="text-[11px] text-ink-faint font-medium">Unknown</span>
              {{/if}}
            </td>
            <td data-th="Size" class="whitespace-nowrap sm:text-right font-bold text-ink-soft tabular-nums p-3">{{bytes size}}</td>
            <td data-th="" class="sm:text-right p-3 pr-5">
              <div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap sm:opacity-0 group-hover:opacity-100 transition-opacity">
                <button class="btn btn-ghost btn-sm text-link hover:bg-link/10 hover:text-link rounded-full px-3 shadow-sm border border-transparent hover:border-link/20 font-bold" data-world-install data-tip="Pick a target server. A compatibility check runs before the install.">{{{icon 'import' 'size-3.5'}}} Install to…</button>
                <a class="btn btn-ghost btn-sm text-ink-faint hover:text-ink hover:bg-inset/30 rounded-full size-8 p-0 grid place-items-center" href="/api/worlds/{{id}}/download" data-tip="Download the archive.">{{{icon 'download' 'size-4'}}}</a>
                <button class="btn btn-ghost btn-sm text-danger hover:bg-danger/10 rounded-full size-8 p-0 grid place-items-center" data-world-delete data-tip="Delete this world ({{bytes size}} freed)." aria-label="Delete {{name}}">{{{icon 'trash-2' 'size-4'}}}</button>
              </div>
            </td>
          </tr>
        {{/each}}
      </tbody>
      </table>
    </div>
  </div>

  <div class="notice mt-4 max-w-prose text-xs shadow-sm">
    {{{icon 'lightbulb' 'size-4 mt-0.5 shrink-0 text-warn'}}}
    <div>Installing a world into a server offers <b class="text-ink">replace</b> (the current world is backed up first) or <b class="text-ink">install alongside</b> (activate it later). Copying between servers works even while the source is running: the panel takes a consistent snapshot first.</div>
  </div>
  {{else}}
    {{> empty-state iconName='earth' title='No Worlds in the Library Yet' message='Upload a world archive or save one from a running server with the buttons above. Installs, copies, and downloads all start from here.'}}
  {{/if}}

  <div id="msm-server-options" hidden data-options="{{jsonAttr serverOptions}}"></div>
</div>
<script type="module" src="/js/pages/worlds.js"></script>
