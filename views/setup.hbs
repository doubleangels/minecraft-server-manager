<div class="w-full max-w-lg" id="setup-wizard">
  <div class="mb-5 flex items-center justify-center gap-2.5">
    {{> brand-lockup}}
  </div>

  {{! Progress dots - one per step, driven by setup.js }}
  <div class="mb-4 flex items-center justify-center gap-2" id="setup-dots" aria-hidden="true">
    <span class="h-1.5 w-6 rounded-full bg-grass-500 transition-colors" data-dot></span>
    <span class="h-1.5 w-6 rounded-full bg-line transition-colors" data-dot></span>
    <span class="h-1.5 w-6 rounded-full bg-line transition-colors" data-dot></span>
    <span class="h-1.5 w-6 rounded-full bg-line transition-colors" data-dot></span>
    <span class="h-1.5 w-6 rounded-full bg-line transition-colors" data-dot></span>
  </div>

  <div class="card overflow-hidden shadow-sm p-6 sm:p-8 bg-canvas border border-line/50">
    {{! ---- Step 0: Welcome ---- }}
    <section data-step="0">
      <h2 class="text-center text-xl font-bold tracking-tight text-ink">Welcome to Minecraft Server Manager</h2>
      <p class="mx-auto mt-3 max-w-sm text-center text-[13px] font-medium leading-relaxed text-ink-soft">
        Your control panel for Minecraft servers on Docker. Create, configure, back up, and manage
        modpacks, worlds, players, and more. Let's get a few things set up. It only takes a minute.
      </p>
      <button class="btn btn-primary mt-8 w-full shadow-sm" data-next>Get Started {{{icon 'arrow-right' 'size-4'}}}</button>
    </section>

    {{! ---- Step 1: System checks ---- }}
    <section data-step="1" hidden>
      <div class="border-b border-line/50 pb-4 mb-5">
        <h2 class="text-lg font-bold tracking-wide flex items-center gap-2">{{{icon 'activity' 'size-5 text-link'}}} System Check</h2>
        <p class="mt-1.5 text-xs font-medium text-ink-faint">Making sure everything Minecraft Server Manager needs is in place.</p>
      </div>
      <div class="mt-4 space-y-2 bg-inset/10 p-4 rounded-lg border border-line/30 shadow-inner" id="checks-list">
        <div class="flex items-center gap-3 py-4 text-xs font-medium text-ink-soft">
          <span class="size-4 animate-spin rounded-full border-2 border-line border-t-grass-500"></span> Running checks…
        </div>
      </div>
      <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-3">
        <button class="btn btn-ghost shadow-sm hover:bg-inset/30" data-back>{{{icon 'arrow-left' 'size-4'}}} Back</button>
        <button class="btn btn-ghost shadow-sm hover:bg-inset/30" data-recheck>{{{icon 'rotate-cw' 'size-4'}}} Re-check</button>
        <button class="btn btn-primary shadow-sm sm:ml-auto" data-next>Continue {{{icon 'arrow-right' 'size-4'}}}</button>
      </div>
    </section>

    {{! ---- Step 2: Create admin ---- }}
    <section data-step="2" hidden>
      <div class="border-b border-line/50 pb-4 mb-5">
        <h2 class="text-lg font-bold tracking-wide flex items-center gap-2">{{{icon 'shield-check' 'size-5 text-link'}}} Create Your Admin Account</h2>
        <p class="mt-1.5 text-xs font-medium text-ink-faint">This is the owner account for the panel. You can add more users later.</p>
      </div>
      <div class="notice notice-danger mt-4 hidden shadow-sm text-xs font-bold uppercase tracking-wider" id="admin-error"></div>
      <form id="setup-admin" class="mt-6 space-y-5">
        <div class="bg-inset/10 p-4 rounded-lg border border-line/30 shadow-inner">
          <label class="label text-[10px] font-bold uppercase tracking-wider text-ink-faint mb-1.5" for="su-user">Username</label>
          <input class="input bg-canvas shadow-sm" id="su-user" name="username" autocomplete="username" required minlength="2" maxlength="32">
        </div>
        <div class="bg-inset/10 p-4 rounded-lg border border-line/30 shadow-inner">
          <label class="label text-[10px] font-bold uppercase tracking-wider text-ink-faint mb-1.5" for="su-pass">Password</label>
          <input class="input bg-canvas shadow-sm" id="su-pass" name="password" type="password" autocomplete="new-password" required minlength="8">
          <p class="help mt-2 text-[10px] font-medium text-ink-faint">At least 8 characters. If you get locked out later, you can reset this password from the server; the README explains how.</p>
        </div>
        {{#if needsPin}}
        <div class="bg-warn/5 p-4 rounded-lg border border-warn/30 shadow-inner">
          <label class="label text-[10px] font-bold uppercase tracking-wider text-warn-strong mb-1.5" for="su-pin">Setup PIN</label>
          <input class="input bg-canvas shadow-sm border-warn/30 focus:border-warn" id="su-pin" name="pin" inputmode="numeric" autocomplete="off" required maxlength="12" placeholder="6-digit PIN from the console">
          <p class="help mt-2 text-[10px] font-medium text-warn-strong opacity-80">This panel is reachable beyond this machine, so first-run setup is PIN-gated. The 6-digit PIN was printed to the panel's console/log on startup.</p>
        </div>
        {{/if}}
        <div class="flex flex-col-reverse sm:flex-row sm:items-center gap-3 mt-8">
          <button class="btn btn-ghost shadow-sm hover:bg-inset/30" type="button" data-back>{{{icon 'arrow-left' 'size-4'}}} Back</button>
          <button class="btn btn-primary shadow-sm sm:ml-auto" type="submit">{{{icon 'shield' 'size-4'}}} Create Admin</button>
        </div>
      </form>
    </section>

    {{! ---- Step 3: Panel configuration (optional) ---- }}
    <section data-step="3" hidden>
      <div class="border-b border-line/50 pb-4 mb-5">
        <div class="flex items-center gap-3">
          <h2 class="text-lg font-bold tracking-wide flex items-center gap-2">{{{icon 'settings' 'size-5 text-link'}}} Panel Configuration</h2>
          <span class="badge bg-inset/50 border border-line/50 text-[9px] uppercase tracking-wider font-bold">optional</span>
        </div>
        <p class="mt-1.5 text-xs font-medium text-ink-faint">You can change all of this later in Settings.</p>
      </div>

      <div class="space-y-5">
        <div class="bg-inset/10 p-4 rounded-lg border border-line/30 shadow-inner">
          <label class="label text-[10px] font-bold uppercase tracking-wider text-ink-faint mb-1.5" for="su-domain">Public domain <span class="text-[9px] font-medium">(optional)</span></label>
          <div class="flex flex-col sm:flex-row flex-wrap gap-3">
            <input class="input min-w-0 flex-1 bg-canvas shadow-sm" id="su-domain" placeholder="mc.example.com" autocomplete="off" spellcheck="false">
            <button class="btn btn-primary shadow-sm shrink-0" type="button" id="su-domain-save">Save Domain</button>
          </div>
          <p class="help mt-2 text-[10px] font-medium text-ink-faint">Shown to players instead of your IP address in connect addresses, for example <code class="code-inline bg-inset/30 border border-line/30 px-1 py-0.5 rounded text-ink">mc.example.com:25565</code>. Enter the domain only, with no scheme or port.</p>
        </div>

        <div class="bg-inset/10 p-4 rounded-lg border border-line/30 shadow-inner">
          <label class="label text-[10px] font-bold uppercase tracking-wider text-ink-faint mb-1.5" for="su-cf">CurseForge API key <span class="text-[9px] font-medium">(optional)</span></label>
          <div class="flex flex-col sm:flex-row flex-wrap gap-3">
            <input class="input min-w-0 flex-1 bg-canvas shadow-sm" id="su-cf" type="password" placeholder="$2a$10$…" autocomplete="off" spellcheck="false">
            <button class="btn btn-primary shadow-sm shrink-0" type="button" id="su-cf-save">Test &amp; Save</button>
          </div>
          <p class="help mt-2 text-[10px] font-medium text-ink-faint">Needed only for automated CurseForge modpacks. Get one at
            <a class="text-link underline hover:text-link font-bold" href="https://console.curseforge.com/" target="_blank" rel="noopener">console.curseforge.com</a>.</p>
        </div>

        <div class="bg-inset/10 p-4 rounded-lg border border-line/30 shadow-inner">
          <span class="label text-[10px] font-bold uppercase tracking-wider text-ink-faint mb-1.5 block">Time zone &amp; region</span>
          {{! data-native only until tzPicker fills them - it enhances post-fill. }}
          <div class="grid gap-3 sm:grid-cols-2">
            <select class="input bg-canvas shadow-sm" id="su-tz" data-native aria-label="Time zone" data-label="Time zone"></select>
            <select class="input bg-canvas shadow-sm" id="su-country" data-native aria-label="Country" data-label="Country"></select>
          </div>
          <p class="help mt-2 text-[10px] font-medium text-ink-faint">Detected from your system. Sets how dates and player-activity times are shown across the panel.</p>
          <button class="btn btn-primary shadow-sm mt-3" type="button" id="su-loc-save">Save Time Zone</button>
        </div>
      </div>

      <div class="mt-8 flex flex-col sm:flex-row sm:items-center">
        <button class="btn btn-primary shadow-sm w-full sm:w-auto sm:ml-auto" data-next>Continue {{{icon 'arrow-right' 'size-4'}}}</button>
      </div>
    </section>

    {{! ---- Step 4: Done ---- }}
    <section data-step="4" hidden>
      <div class="grid place-items-center py-6 text-center">
        <span class="grid size-16 place-items-center rounded-full bg-ok/10 text-ok-strong shadow-inner border border-ok/20 mb-2">{{{icon 'party-popper' 'size-8'}}}</span>
        <h2 class="mt-4 text-xl font-bold tracking-tight text-ink">You're All Set!</h2>
        <p class="mt-2 max-w-sm text-[13px] font-medium leading-relaxed text-ink-soft">Minecraft Server Manager is ready. Spin up your first Minecraft server whenever you like.</p>
      </div>
      <div class="mt-6 flex flex-col gap-3">
        <a class="btn btn-primary shadow-md w-full py-2.5 text-sm" href="/servers/new">{{{icon 'plus' 'size-4'}}} Create a Server</a>
        <a class="btn btn-ghost shadow-sm hover:bg-inset/30 w-full py-2.5 text-sm border border-line/50" href="/">Go to the Dashboard</a>
      </div>
    </section>
  </div>
</div>
<script type="module" src="/js/pages/setup.js"></script>
