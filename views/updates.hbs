{{> page-header heading="UPDATES" sub="Everything out of date across your servers. Nothing updates itself: every upgrade is deliberate, backed up, and reversible."}}

<div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:flex-wrap gap-2">
  <span class="text-[11px] font-medium text-ink-faint bg-inset/30 px-3 py-1.5 rounded-md border border-line/50 shadow-inner">Last checked: {{#if lastChecked}}<span data-ts="{{lastChecked}}" class="font-bold text-ink-soft">{{lastChecked}}</span>{{else}}<span class="font-bold text-ink-soft">never</span>{{/if}}</span>
  <button class="btn btn-sm btn-primary shadow-sm ml-auto" id="updates-check-all">{{{icon 'rotate-cw' 'size-3.5'}}} Check All Now</button>
</div>

<p class="mb-5 max-w-prose text-xs leading-relaxed font-medium text-ink-faint">
  A check asks <b class="text-ink">Modrinth</b>, <b class="text-ink">CurseForge</b>, <b class="text-ink">Hangar</b>, <b class="text-ink">SpigotMC</b> and <b class="text-ink">GitHub&nbsp;Releases</b> about your custom
  mods, plugins, datapacks and resource packs, and the <b class="text-ink">Minecraft version manifest</b>, <b class="text-ink">loader build lists</b> and
  <b class="text-ink">Docker image tags</b> for each server. Pinned modpacks are compared against their platform too.
</p>

{{#if updates.length}}
<div class="card overflow-hidden">
  <div class="border-b border-line/50 bg-inset/10 p-4 font-bold tracking-wide text-sm flex items-center justify-between gap-4">
    <div class="flex items-center gap-2">{{{icon 'arrow-up-circle' 'size-4 text-warn'}}} Available Updates</div>
    <span class="text-[10px] uppercase tracking-widest text-ink-faint bg-inset/50 border border-line/30 px-2 py-0.5 rounded shadow-inner font-bold">{{updates.length}} Pending</span>
  </div>
  
  <div class="overflow-x-auto">
    <table class="table-base table-stack w-full text-sm" id="updates-table">
    <thead class="bg-canvas/50">
      <tr class="text-[10px] uppercase tracking-widest text-ink-faint">
        <th class="font-bold py-3 pl-5">Server</th>
        <th class="font-bold py-3">Type</th>
        <th class="font-bold py-3">Subject</th>
        <th class="font-bold py-3">Current</th>
        <th class="font-bold py-3">Latest</th>
        <th class="text-right font-bold py-3 pr-5">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line/30">
      {{#each updates}}
        <tr class="hover:bg-inset/10 transition-colors group {{#if ignored}}opacity-50 hover:opacity-100{{/if}}" data-update-row data-server-id="{{serverId}}" data-server-name="{{server}}"
            data-kind="{{kind}}" data-subject-type="{{subjectType}}" data-subject="{{subject}}" data-current="{{current}}" data-latest="{{latest}}"
            {{#if versionId}}data-version-id="{{versionId}}"{{/if}} {{#if contentId}}data-content-id="{{contentId}}"{{/if}}
            {{#if imageUpgrade}}data-image-upgrade="1"{{/if}}
            {{#if targetVersion}}data-target-version="{{targetVersion}}"{{/if}}
            {{#if targetLoaderBuild}}data-target-build="{{targetLoaderBuild}}" data-env-key="{{envKey}}"{{/if}}>
          <td data-th="Server" class="whitespace-nowrap p-3 pl-5">{{#if serverId}}<a class="font-bold text-ink hover:text-link transition-colors" href="/servers/{{serverId}}">{{server}}</a>{{else}}<span class="font-medium text-ink-faint">{{server}}</span>{{/if}}</td>
          <td data-th="Type" class="p-3"><span class="badge bg-inset/50 border border-line/50 text-[9px] uppercase tracking-wider">{{kind}}</span></td>
          {{! w-full + max-w-0 (sm+ only) so long pack/mod names truncate instead of widening the table. }}
          <td data-th="Subject" class="sm:w-full sm:max-w-0 p-3"><span class="block truncate font-bold text-ink-soft" title="{{subject}}">{{subject}}</span></td>
          <td data-th="Current" class="truncate p-3 font-mono text-xs text-ink-faint sm:max-w-40" title="{{current}}">{{current}}</td>
          <td data-th="Latest" class="truncate p-3 font-mono text-xs sm:max-w-40 {{#if ignored}}text-ink-faint{{else}}text-warn-strong font-bold{{/if}}" title="{{latest}}">
            {{latest}}{{#if ignored}} <span class="badge ml-1 bg-inset/50 border border-line/50 text-ink-faint text-[9px] uppercase tracking-wider" data-tip="This update is ignored and won't be offered.">ignored</span>{{/if}}
          </td>
          <td data-th="" class="p-3 sm:text-right pr-5">
            <div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap sm:opacity-0 group-hover:opacity-100 transition-opacity">
              {{#if changelog}}<a class="btn btn-ghost btn-sm text-ink-faint hover:text-ink hover:bg-inset/30 rounded-full size-8 p-0 grid place-items-center" href="{{changelog}}" target="_blank" rel="noopener" data-tip="Changelog">{{{icon 'external-link' 'size-4'}}}</a>{{/if}}
              {{#if ignored}}
                <button class="btn btn-ghost btn-sm text-ink-faint hover:text-ink hover:bg-inset/30 rounded-full px-3 font-bold border border-transparent shadow-sm" data-update-unignore data-tip="Offer {{latest}} again.">{{{icon 'bell' 'size-3.5'}}} Un-ignore</button>
              {{else}}
                <button class="btn btn-ghost btn-sm text-ink-faint hover:text-ink hover:bg-inset/30 rounded-full size-8 p-0 grid place-items-center" data-update-ignore data-tip="Stop offering {{latest}} for this subject.">{{{icon 'bell-off' 'size-4'}}}</button>
                <button class="btn btn-sm text-warn hover:bg-warn/10 hover:border-warn/30 border border-line/50 bg-canvas shadow-sm rounded-full px-3 font-bold transition-colors" data-update-upgrade>{{{icon 'circle-arrow-up' 'size-3.5'}}} Upgrade…</button>
              {{/if}}
            </div>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
  </div>
</div>

<div class="notice mt-4 text-xs font-medium leading-relaxed shadow-sm">
  {{{icon 'info' 'size-4 mt-0.5 shrink-0 text-link'}}}
  <div>Your custom mods are always kept across pack updates. If a pack update changes the Minecraft or loader version, each custom mod is checked for compatibility, with a one-click "update this mod too" when a matching build exists. <b class="text-ink">Ignore</b> hides a specific version from this page and the sidebar count; a newer build than the one you ignored comes back on its own.</div>
</div>
{{else}}
  {{> empty-state iconName='circle-check' title='Everything Is Up to Date' message='No pending updates across your servers. Run a check to ask Modrinth, CurseForge, Hangar, SpigotMC, GitHub Releases and the Minecraft/loader/image registries for anything new.'}}
{{/if}}
<script type="module" src="/js/pages/updates.js"></script>
