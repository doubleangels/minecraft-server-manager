<div data-backups-server="{{server.id}}" class="contents">
<div class="mb-5 flex flex-col xl:flex-row xl:items-start gap-4">
  <div class="flex-1 bg-inset/30 p-4 rounded-xl border border-line/50 shadow-inner">
    <div class="flex items-center gap-2 mb-2 font-bold text-ink text-sm">
      {{{icon 'history' 'size-4 text-link'}}} Retention Policy
    </div>
    <p class="text-xs font-medium leading-relaxed text-ink-faint">
      For this server: <b class="text-ink">{{retention.keepScheduled}}</b> scheduled, <b class="text-ink">{{retention.keepPreUpdate}}</b> pre-update,
      <b class="text-ink">{{retention.keepManual}}</b> manual, <b class="text-ink">{{retention.keepPreRestore}}</b> pre-restore. The newest in each group are kept; older ones
      are pruned automatically.{{#if retention.maxAgeDays}} Anything older than <b class="text-ink">{{retention.maxAgeDays}}</b> days is also removed.{{/if}}{{#if retention.maxTotalGb}} Total backups are capped at <b class="text-ink">{{retention.maxTotalGb}}</b> GB (oldest are removed first).{{/if}}
    </p>
  </div>
  <div class="flex flex-col sm:flex-row sm:flex-wrap xl:flex-col items-stretch sm:items-center xl:items-stretch gap-3 shrink-0">
    <label class="flex items-center gap-2 text-[11px] font-bold text-ink-soft bg-inset/10 p-3 xl:p-2.5 rounded-lg border border-line/30 cursor-pointer hover:bg-inset/30 transition-colors shadow-sm" data-tip="After the backup is saved, remove chunks no player has spent 30+ seconds in to shrink the world. Only runs while the server is stopped.">
      <input type="checkbox" class="msm-check" id="bk-shrink"> <span>Shrink World Afterwards</span>
    </label>
    <button class="btn btn-primary shadow-sm{{#unless perms.backups}} hidden{{/unless}}" id="bk-now">{{{icon 'save' 'size-4'}}} Back Up Now</button>
  </div>
</div>

{{#if backups.length}}
<div class="card overflow-hidden shadow-sm">
  <div class="border-b border-line/50 bg-inset/10 p-4 font-bold tracking-wide text-sm flex items-center justify-between gap-4">
    <div class="flex items-center gap-2">{{{icon 'archive' 'size-4 text-link'}}} Server Archives</div>
    <span class="text-[10px] uppercase tracking-widest text-ink-faint bg-inset/50 border border-line/30 px-2 py-0.5 rounded shadow-inner font-bold">{{backups.length}} Total</span>
  </div>
  
  <div class="overflow-x-auto">
    <table class="table-base table-stack w-full text-sm" id="bk-table">
      <thead class="bg-canvas/50">
        <tr class="text-[10px] uppercase tracking-widest text-ink-faint">
          <th class="font-bold py-3 pl-5">Archive</th>
          <th class="font-bold py-3">Reason</th>
          <th class="text-right font-bold py-3">Size</th>
          <th class="text-right font-bold py-3">Created</th>
          <th class="text-right font-bold py-3 pr-5">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line/30">
        {{#each backups}}
          <tr class="hover:bg-inset/10 transition-colors group" data-backup-row data-backup-id="{{id}}" data-file="{{file}}" data-size="{{size}}">
            <td data-th="Archive" class="sm:w-full sm:max-w-0 p-3 pl-5"><span class="block truncate font-mono text-[11px] font-bold text-ink-soft bg-inset/30 px-2 py-1 rounded border border-line/30 w-fit max-w-full" title="{{file}}">{{file}}</span></td>
            <td data-th="Reason" class="p-3"><span class="badge bg-inset/50 border border-line/50 text-[9px] uppercase tracking-wider {{#if (eq reason 'pre-update')}}!border-warn/50 !text-warn-strong !bg-warn/10{{/if}}">{{reason}}</span></td>
            <td data-th="Size" class="whitespace-nowrap sm:text-right font-bold tabular-nums text-ink-soft p-3">{{bytes size}}</td>
            <td data-th="Created" class="whitespace-nowrap sm:text-right text-[11px] font-medium text-ink-faint p-3" data-ts="{{ts}}">{{ts}}</td>
            <td data-th="" class="p-3 sm:text-right pr-5">
              <div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap sm:opacity-0 group-hover:opacity-100 transition-opacity">
                {{! Restore stops the server and replaces its data - it must not scan
                    identically to the harmless Download beside it. }}
                <button class="btn btn-ghost btn-sm text-warn hover:bg-warn/10 hover:border-warn/30 border border-transparent rounded-full px-3 font-bold transition-colors shadow-sm" data-backup-restore data-tip="Stops the server, restores this archive, then starts it again.">{{{icon 'undo-2' 'size-3.5'}}} Restore</button>
                <a class="btn btn-ghost btn-sm text-ink-faint hover:text-ink hover:bg-inset/30 rounded-full size-8 p-0 grid place-items-center" href="/api/backups/{{id}}/download" data-tip="Download the archive." aria-label="Download {{file}}">{{{icon 'download' 'size-4'}}}</a>
                <button class="btn btn-ghost btn-sm text-ink-faint hover:text-ink hover:bg-inset/30 rounded-full size-8 p-0 grid place-items-center" data-backup-rename data-tip="Rename the archive." aria-label="Rename {{file}}">{{{icon 'square-pen' 'size-4'}}}</button>
                <button class="btn btn-ghost btn-sm text-danger hover:bg-danger/10 rounded-full size-8 p-0 grid place-items-center" data-backup-delete data-tip="Delete this archive ({{bytes size}} freed)." aria-label="Delete {{file}}">{{{icon 'trash-2' 'size-4'}}}</button>
              </div>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
  {{> empty-state iconName='archive' title='No Backups Yet' message='Use Back Up Now for the first one. Scheduled and pre-update backups also collect here automatically.'}}
{{/if}}
</div>
<script type="module" src="/js/pages/server-backups.js"></script>
