{{#unless serversOnly}}{{> page-header heading="DASHBOARD" sub="Every server at a glance: status, resource use, and the latest activity across the panel."}}{{/unless}}

{{! Blocking problems first: nothing below works without Docker. }}
<div id="docker-warning" class="notice notice-danger mb-4 hidden">
  {{{icon 'triangle-alert' 'size-4 mt-0.5 shrink-0 text-danger'}}}
  <div>
    <span class="font-semibold text-danger">Docker isn't reachable.</span>
    <span id="docker-warning-reason">Start Docker, then refresh. Creating or starting servers needs Docker running.</span>
  </div>
</div>

{{! Update counts live in the Updates card below (with the mod/server split),
    so this row is just people + infrastructure. }}
<div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-3 {{#if serversOnly}}hidden{{/if}}">
  <div class="card stat-tile">
    <div class="stat-label">{{{icon 'server' 'size-3.5'}}} Servers Online</div>
    {{! Green only when something IS online - 0/3 in success green lied. }}
    <div class="stat-value {{#if totals.running}}text-ok{{/if}}">{{totals.running}}<span class="stat-unit"> / {{totals.total}}</span></div>
  </div>
  <div class="card stat-tile">
    <div class="stat-label">{{{icon 'users' 'size-3.5'}}} Players Connected</div>
    <div class="stat-value">{{totals.players}}</div>
  </div>
  <div class="card stat-tile col-span-2 sm:col-span-1">
    <div class="stat-label">{{{icon 'box' 'size-3.5'}}} Docker</div>
    <div class="mt-1 flex items-center gap-2 text-sm font-semibold text-ink-faint" id="docker-status">
      <span class="status-dot relative bg-ink-faint"></span> Checking…
    </div>
  </div>
</div>

{{#unless serversOnly}}
<div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4 {{#if noServers}}hidden{{/if}}">
  <div class="card stat-tile">
    <div class="stat-label">{{{icon 'memory-stick' 'size-3.5'}}} Memory Allotted</div>
    <div class="stat-value">{{overview.mem.allottedMb}}<span class="stat-unit"> MB</span></div>
    <div class="stat-sub"><span data-overview-mem-used>{{overview.mem.usedMb}}</span> MB in use{{#if overview.mem.allottedMb}} · {{pct overview.mem.usedMb overview.mem.allottedMb}}% used{{/if}}</div>
  </div>

  <div class="card stat-tile">
    <div class="stat-label">{{{icon 'hard-drive' 'size-3.5'}}} Storage Used</div>
    <div class="stat-value">{{bytes overview.disk.usedBytes}}</div>
    <div class="stat-sub">across all server data folders</div>
  </div>

  <a href="/health" class="card stat-tile block hover:border-line-strong" aria-label="Open the health page">
    <div class="stat-label">{{{icon 'activity' 'size-3.5'}}} Health · 24h</div>
    <div class="stat-value {{#if overview.healthTotal}}text-danger{{else}}text-ok{{/if}}">{{overview.healthTotal}}<span class="stat-unit"> alert{{#unless (eq overview.healthTotal 1)}}s{{/unless}}</span></div>
    <div class="stat-sub">{{#if overview.healthTotal}}{{overview.health.crashes}} crash{{#unless (eq overview.health.crashes 1)}}es{{/unless}}, {{overview.health.oom}} out of memory, {{overview.health.autoRestarted}} auto-restart{{#unless (eq overview.health.autoRestarted 1)}}s{{/unless}}{{else}}No crashes, out-of-memory stops, or auto-restarts{{/if}}</div>
  </a>

  <a href="/updates" class="card stat-tile block hover:border-line-strong" aria-label="Open the updates page">
    <div class="stat-label">{{{icon 'circle-arrow-up' 'size-3.5'}}} Updates</div>
    <div class="stat-value {{#if overview.updates.all}}text-warn{{/if}}">{{overview.updates.all}}</div>
    <div class="stat-sub">{{overview.updates.mods}} mod{{#unless (eq overview.updates.mods 1)}}s{{/unless}} / {{overview.updates.server}} server-level</div>
  </a>
</div>
{{/unless}}




{{#unless serversOnly}}
<div class="mb-6 {{#if noServers}}hidden{{/if}}">
  <h2 class="mb-3 font-semibold">Servers by Status</h2>
  <div class="card flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 text-sm">
    {{#if overview.byStatus.running}}<span class="flex items-center gap-1.5"><span class="status-dot bg-ok"></span>{{overview.byStatus.running}} Running</span>{{/if}}
    {{#if overview.byStatus.starting}}<span class="flex items-center gap-1.5"><span class="status-dot bg-warn"></span>{{overview.byStatus.starting}} Starting</span>{{/if}}
    {{#if overview.byStatus.unhealthy}}<span class="flex items-center gap-1.5 text-warn"><span class="status-dot bg-warn"></span>{{overview.byStatus.unhealthy}} Unhealthy</span>{{/if}}
    {{#if overview.byStatus.stalled}}<span class="flex items-center gap-1.5 font-semibold text-danger"><span class="status-dot bg-danger"></span>{{overview.byStatus.stalled}} Stalled</span>{{/if}}
    {{#if overview.byStatus.updating}}<span class="flex items-center gap-1.5"><span class="status-dot bg-link"></span>{{overview.byStatus.updating}} Updating</span>{{/if}}
    {{#if overview.byStatus.crashed}}<span class="flex items-center gap-1.5 font-semibold text-danger"><span class="status-dot bg-danger"></span>{{overview.byStatus.crashed}} Crashed</span>{{/if}}
    {{#if overview.byStatus.stopped}}<span class="flex items-center gap-1.5"><span class="status-dot bg-ink-faint"></span>{{overview.byStatus.stopped}} Stopped</span>{{/if}}
  </div>
</div>
{{/unless}}

{{#unless noServers}}
{{#unless serversOnly}}<h2 class="mb-3 font-semibold">Servers</h2>{{/unless}}
<div class="mb-4 flex flex-wrap items-center gap-2">
  <input class="input w-full sm:w-auto sm:max-w-xs sm:flex-1" type="search" placeholder="Search servers, tags…" aria-label="Search servers" id="server-filter">
  {{! Visible "Sort" label: only the first option carried a "Sort:" prefix, so
      the closed trigger read context-free once anything else was picked. }}
  <label class="text-xs text-ink-faint" for="server-sort">Sort</label>
  <select class="input w-auto" id="server-sort" data-label="Sort servers">
    <option value="status" {{#if (eq sort 'status')}}selected{{/if}}>Status</option>
    <option value="name" {{#if (eq sort 'name')}}selected{{/if}}>Name</option>
    <option value="size" {{#if (eq sort 'size')}}selected{{/if}}>Size</option>
    <option value="started" {{#if (eq sort 'started')}}selected{{/if}}>Last Started</option>
    <option value="created" {{#if (eq sort 'created')}}selected{{/if}}>Created</option>
  </select>
  {{#unless (eq user.role 'viewer')}}
    <button class="btn btn-sm ml-auto" id="bulk-toggle" aria-pressed="false" data-tip="Pick several servers, then start, stop, restart or back them up together.">{{{icon 'list-checks' 'size-3.5'}}} Select</button>
  {{/unless}}
  <div class="seg {{#if (eq user.role 'viewer')}}ml-auto{{/if}}" role="group" aria-label="View">
    <button class="seg-btn" id="view-grid" aria-pressed="false" data-tip="Grid view.">{{{icon 'layout-grid' 'size-4'}}}</button>
    <button class="seg-btn" id="view-list" aria-pressed="false" data-tip="List view.">{{{icon 'list' 'size-4'}}}</button>
  </div>
</div>

{{/unless}}

{{#if noServers}}
  {{> empty-state iconName='pickaxe' title='No Servers Yet' message='Create your first Minecraft server. Pick a server type and version, or start from a blueprint. You will be playing in minutes.' ctaHref='/servers/new' ctaLabel='Create a Server'}}
{{else}}
<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" id="server-grid">
  {{#each servers}}
    {{> server-card}}
  {{/each}}

  <a href="/servers/new" class="grid min-h-44 place-items-center rounded-lg border-2 border-dashed border-line text-ink-faint transition hover:border-ok hover:text-ok">
    <div class="grid place-items-center text-center">
      {{{icon 'plus' 'size-8'}}}
      <div class="mt-2 text-sm font-medium">Create a Server</div>
      {{! label kept in sync with the empty-state CTA, topbar, and setup }} 
    </div>
  </a>
</div>
{{/if}}

{{! Fleet resource charts sit after the servers themselves: the servers are
    what people come here for, the combined graph is context. }}
{{#unless serversOnly}}
<div class="mt-8 {{#if noServers}}hidden{{/if}}" id="combined-overview">
  <div class="mb-3 flex items-center justify-between">
    <h2 class="font-semibold">Resource Overview</h2>
  </div>
  <div data-combined-root>
    {{> combined-graphs}}
  </div>
</div>
{{/unless}}

<div class="mt-8 {{#if serversOnly}}hidden{{/if}}">
  <div class="mb-3 flex items-center justify-between">
    <h2 class="font-semibold">Recent Activity</h2>
    <a href="/activity" class="text-sm text-link hover:underline">View All →</a>
  </div>
  <div class="card">
    <ol class="divide-y divide-line">
      {{#each activity}}
        {{! The summary keeps a readable minimum width; on a phone the server and
            time drop to their own line instead of squeezing it to a word a line. }}
        <li class="flex flex-wrap items-center gap-x-2 gap-y-1 p-3 text-sm">
          <span class="badge shrink-0">{{eventType type}}</span>
          <span class="min-w-[12rem] flex-1 break-words">{{summary}}</span>
          <span class="flex min-w-0 max-w-full items-center gap-2 text-xs">
            {{! deleted-server names are plain faint text - link-styled dead spans read as broken. }}
            {{#if serverId}}<a href="/servers/{{serverId}}" class="min-w-0 truncate text-link hover:underline">{{server}}</a>{{else}}<span class="min-w-0 truncate text-ink-faint">{{server}}</span>{{/if}}
            <span class="shrink-0 text-ink-faint" data-ts-ago="{{ts}}">{{ts}}</span>
          </span>
        </li>
      {{else}}
        <li class="p-8 text-center text-sm text-ink-faint">No activity yet. Actions on your servers will show up here.</li>
      {{/each}}
    </ol>
  </div>
</div>
{{! Bulk action bar: appears in Select mode, pinned to the bottom of the
    screen. z-10: inside the page, below the topbar (20). }}
<div id="bulk-bar" class="action-bar -mx-4 mt-4 hidden sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8">
  {{! Phone: the count on its own line, then the four actions as one even
      row (no lone button wrapping onto a third line). sm+: one row. }}
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
    <span class="flex items-center gap-3 text-sm sm:mr-auto"><span><b data-bulk-count>0</b> selected</span> <button type="button" class="text-xs text-link hover:underline" data-bulk-all>Select All</button></span>
    <div class="grid grid-cols-4 gap-2 sm:flex">
      <button class="btn btn-sm px-1 sm:px-2.5" data-bulk="start" disabled>{{{icon 'play' 'size-3.5'}}} Start</button>
      <button class="btn btn-sm px-1 sm:px-2.5" data-bulk="restart" disabled>{{{icon 'rotate-cw' 'size-3.5'}}} Restart</button>
      <button class="btn btn-sm btn-danger px-1 sm:px-2.5" data-bulk="stop" disabled>{{{icon 'square' 'size-3.5'}}} Stop</button>
      <button class="btn btn-sm px-1 sm:px-2.5" data-bulk="backup" disabled>{{{icon 'save' 'size-3.5'}}} Back Up</button>
    </div>
  </div>
</div>
<script type="module" src="/js/pages/dashboard.js"></script>
