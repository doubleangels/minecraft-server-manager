<div data-players-root data-server-id="{{server.id}}" data-running="{{#if (or (eq server.status 'running') (eq server.status 'unhealthy'))}}1{{else}}0{{/if}}">

  <div class="mb-4 flex flex-wrap items-center gap-2">
    {{#if players.length}}
    <input class="input w-full sm:w-auto sm:max-w-xs" placeholder="Search players…" id="players-search">
    <select class="input w-full sm:w-auto" id="players-filter" data-label="Filter players">
      <option value="all">All Players</option>
      <option value="online">Online</option>
      <option value="whitelisted">Whitelisted</option>
      <option value="ops">Ops</option>
      <option value="banned">Banned</option>
    </select>
    {{/if}}
    <label class="flex cursor-pointer items-center gap-2 text-sm">
      <span class="msm-toggle"><input type="checkbox" id="players-wl-enforce" {{#if whitelistEnforced}}checked{{/if}}><span></span></span>
      Whitelist Enforced
    </label>
    <div class="flex w-full sm:ml-auto sm:w-auto gap-2">
      <button class="btn btn-primary btn-sm w-full sm:w-auto" id="players-add">{{{icon 'user-plus' 'size-3.5'}}} Add Players</button>
    </div>
  </div>

  {{#unless (or (eq server.status 'running') (eq server.status 'unhealthy'))}}
    <div class="notice notice-warn mb-4 max-w-prose text-xs">
      The server is offline. Whitelist, operator, and ban changes are written straight to the server files and take effect on the next start.
      Kicks and teleports need a running server.
    </div>
  {{/unless}}

  {{#if players.length}}
  <div class="card overflow-x-auto">
    <table class="table-base table-stack">
      <thead><tr>
        <th scope="col">Player</th><th scope="col">Status</th><th scope="col">Roles</th><th scope="col">Details</th><th scope="col" class="text-right">Actions</th>
      </tr></thead>
      <tbody>
        {{#each players}}
          <tr data-player-row
              data-name="{{name}}"
              data-online="{{#if online}}1{{else}}0{{/if}}"
              data-whitelisted="{{#if whitelisted}}1{{else}}0{{/if}}"
              data-op="{{#if op}}1{{else}}0{{/if}}"
              data-banned="{{#if banned}}1{{else}}0{{/if}}"
              data-last-seen="{{lastSeen}}" data-last-seen-approx="{{#if lastSeenApprox}}1{{/if}}">
            <td data-th="Player">
              <a href="/servers/{{../server.id}}/players/{{name}}" class="group flex items-center gap-2.5" data-tip="Open {{name}}'s page: roles, teleport, and inventory.">
                <span class="relative grid size-8 shrink-0 place-items-center overflow-hidden rounded-sm bg-inset text-xs font-bold">
                  {{#if bedrock}}{{{icon 'gamepad-2' 'size-4'}}}{{else}}{{name.[0]}}{{/if}}
                  {{#if uuid}}<img class="absolute inset-0 h-full w-full object-cover" data-skin-uuid="{{uuid}}" alt="{{name}}" aria-hidden="true" loading="lazy">{{/if}}
                </span>
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <div class="truncate font-medium transition group-hover:text-link">{{name}}</div>
                    {{#if bedrock}}<span class="chip shrink-0" data-tip="Joined from Bedrock Edition via Geyser/Floodgate.">{{{icon 'gamepad-2' 'size-3'}}} Bedrock</span>{{/if}}
                  </div>
                  {{#if uuid}}<div class="max-w-36 truncate font-mono text-[11px] text-ink-faint">{{uuid}}</div>{{/if}}
                </div>
              </a>
            </td>
            <td data-th="Status" data-player-status>
              {{#if online}}
                <span class="flex items-center gap-1.5 text-xs font-medium text-ok"><span class="status-dot relative bg-ok pulse"></span> Online</span>
              {{else if banned}}
                <span class="flex items-center gap-1.5 text-xs font-medium text-danger"><span class="status-dot bg-danger"></span> Banned</span>
              {{else if whitelisted}}
                <span class="flex items-center gap-1.5 text-xs font-medium text-ok"><span class="status-dot bg-ok"></span> Whitelisted</span>
              {{else}}
                <span class="flex items-center gap-1.5 text-xs font-medium text-ink-soft"><span class="status-dot bg-ink-faint"></span> Joined</span>
                {{#if ../whitelistEnforced}}
                  <div class="mt-0.5 text-[11px] leading-tight text-warn" data-tip="Whitelist enforcement is on. This player has never been whitelisted, so they will be turned away when they try to join.">Not whitelisted, join blocked</div>
                {{else}}
                  <div class="mt-0.5 text-[11px] leading-tight text-ink-faint">Not whitelisted</div>
                {{/if}}
              {{/if}}
              {{#unless online}}{{#if lastSeen}}<div class="mt-0.5 text-[11px] leading-tight text-ink-faint" data-tip="{{#if lastSeenApprox}}Estimated from the server's own name cache, from before the panel logged this player.{{else}}When this player last left the server.{{/if}}">Last seen {{#if lastSeenApprox}}about {{/if}}<span data-ts-ago="{{lastSeen}}">{{lastSeen}}</span></div>{{/if}}{{/unless}}
            </td>
            {{! Off-state chips keep full opacity - dimming reads as disabled,
                and genuinely disabled composers already use opacity for that. }}
            <td data-th="Roles">
              <div class="flex flex-wrap gap-1.5">
                <button class="chip {{#if whitelisted}}border-ok/40 bg-ok/15 text-ok{{/if}}"
                        data-role-toggle="whitelist" data-name="{{name}}" data-on="{{#if whitelisted}}1{{else}}0{{/if}}"
                        data-tip="{{#if whitelisted}}Remove this player from the whitelist.{{else}}Add this player to the whitelist.{{/if}}">
                  {{{icon 'shield-check' 'size-3.5'}}} <span data-chip-label>Whitelist</span>
                </button>
                <button class="chip {{#if op}}border-link/40 bg-link/15 text-link{{/if}}"
                        data-role-toggle="op" data-name="{{name}}" data-on="{{#if op}}1{{else}}0{{/if}}"
                        data-tip="{{#if op}}Remove operator status from this player.{{else}}Make this player an operator (level 4).{{/if}}">
                  {{{icon 'shield' 'size-3.5'}}} <span data-chip-label>Op{{#if op}} L{{opLevel}}{{/if}}</span>
                </button>
                <button class="chip {{#if banned}}border-danger/40 bg-danger/15 text-danger{{/if}}"
                        data-role-toggle="ban" data-name="{{name}}" data-on="{{#if banned}}1{{else}}0{{/if}}"
                        data-tip="{{#if banned}}Pardon this player.{{else}}Ban this player.{{/if}}">
                  {{{icon 'ban' 'size-3.5'}}} <span data-chip-label>{{#if banned}}Banned{{else}}Ban{{/if}}</span>
                </button>
              </div>
            </td>
            <td data-th="Details" class="text-xs text-ink-faint" data-ban-details>
              {{#if banned}}
                <div class="truncate text-danger sm:max-w-56" title="{{default banReason 'No reason recorded'}}">{{default banReason 'No reason recorded'}}</div>
                {{#if banDate}}<div class="mt-0.5">{{banDate}}{{#if banSource}} · {{banSource}}{{/if}}</div>{{/if}}
                {{#if banExpires}}<div class="mt-0.5 text-warn">Expires {{banExpires}}</div>{{/if}}
              {{else}}
                -
              {{/if}}
            </td>
            <td data-th="" class="text-right">
              <div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap">
                {{#if online}}
                  <button class="btn btn-ghost btn-sm" data-act="kick" data-name="{{name}}" data-tip="Kick with a message.">{{{icon 'log-out' 'size-3.5'}}}</button>
                {{/if}}
                {{#if (or (eq ../server.status 'running') (eq ../server.status 'unhealthy'))}}
                  <button class="btn btn-ghost btn-sm" data-act="teleport" data-name="{{name}}" data-tip="Teleport by coordinates, biome, or player.">{{{icon 'compass' 'size-3.5'}}}</button>
                {{else}}
                  <span data-tip="Start the server to teleport players."><button class="btn btn-ghost btn-sm" data-act="teleport" data-name="{{name}}" disabled>{{{icon 'compass' 'size-3.5'}}}</button></span>
                {{/if}}
                <button class="btn btn-ghost btn-sm" data-menu="player-menu-{{@index}}" data-tip="More actions.">{{{icon 'ellipsis' 'size-3.5'}}}</button>
                <template id="player-menu-{{@index}}">
                  <button data-act="op-level" data-name="{{name}}">{{{icon 'shield' 'size-3.5'}}} Set Operator Level…</button>
                  <button data-act="ban-reason" data-name="{{name}}">{{{icon 'ban' 'size-3.5'}}} Ban with Reason…</button>
                  <button data-act="notes" data-name="{{name}}">{{{icon 'sticky-note' 'size-3.5'}}} Moderator Notes…</button>
                  {{#if uuid}}<button data-act="copy-uuid" data-uuid="{{uuid}}">{{{icon 'clipboard-copy' 'size-3.5'}}} Copy UUID</button>{{/if}}
                  {{#unless online}}<button class="text-danger" data-act="delete-player" data-name="{{name}}">{{{icon 'trash-2' 'size-3.5'}}} Delete Player…</button>{{/unless}}
                </template>
              </div>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
    <div class="empty-inline hidden" id="players-no-match">{{{icon 'search-x' 'size-6'}}}No players match these filters.</div>
  </div>
  {{else}}
    {{> empty-state iconName='users' title='No Players Seen Yet' message='Add a player by name and the panel looks them up with Mojang, or players appear here automatically the first time they join.'}}
  {{/if}}

  <div class="card mt-6 p-4">
    {{! One form row that fills the card: three fields share the width, then the
        duration and the button. Phone: two columns, IP and reason full width. }}
    <div class="mb-3">
      <h3 class="mb-3 font-semibold">Banned IPs</h3>
      <div class="grid grid-cols-2 gap-2 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)_minmax(0,1fr)_auto_auto]">
        <input class="input col-span-2 lg:col-span-1" placeholder="IP address" id="banip-ip" aria-label="IP address">
        <input class="input col-span-2 lg:col-span-1" placeholder="Reason (optional)" id="banip-reason" aria-label="Reason">
        <input class="input min-w-0" placeholder="Linked player" id="banip-player" list="banip-player-list" autocomplete="off" data-tip="Optional. Tags this ban with the player it belongs to, shown in the Player column below.">
        <datalist id="banip-player-list">
          {{#each players}}<option value="{{name}}">{{/each}}
        </datalist>
        <select class="input" id="banip-duration" data-label="Ban duration">
          <option value="">Permanent</option>
          <option value="3600000">1 Hour</option>
          <option value="86400000">1 Day</option>
          <option value="259200000">3 Days</option>
          <option value="604800000">7 Days</option>
          <option value="2592000000">30 Days</option>
        </select>
        <button class="btn col-span-2 lg:col-span-1" id="banip-add">{{{icon 'ban' 'size-4'}}} Ban IP</button>
      </div>
    </div>
    {{! Both branches stay in the DOM so bans/pardons can swap them in place. }}
    <div class="overflow-x-auto {{#unless bannedIps.length}}hidden{{/unless}}" id="banip-table">
      <table class="table-base table-stack">
        <thead><tr><th scope="col">IP</th><th scope="col">Player</th><th scope="col">Reason</th><th scope="col">Date</th><th scope="col">Expires</th><th scope="col" class="text-right">Actions</th></tr></thead>
        <tbody id="banip-rows">
          {{#each bannedIps}}
            <tr data-banip-row="{{ip}}">
              <td data-th="IP" class="font-mono">{{ip}}</td>
              <td data-th="Player" class="text-xs text-ink-soft">{{default player '-'}}</td>
              <td data-th="Reason" class="text-xs text-ink-soft">{{default reason '-'}}</td>
              <td data-th="Date" class="text-xs text-ink-faint">{{default created '-'}}</td>
              <td data-th="Expires" class="text-xs text-ink-faint">{{#if (eq expires 'forever')}}Permanent{{else}}{{expires}}{{/if}}</td>
              <td data-th="" class="text-right">
                <button class="btn btn-ghost btn-sm text-danger" data-act="pardon-ip" data-ip="{{ip}}" data-tip="Remove this IP ban.">{{{icon 'x' 'size-3.5'}}}</button>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    <p class="text-sm text-ink-faint {{#if bannedIps.length}}hidden{{/if}}" id="banip-empty">No banned IPs.</p>
  </div>
</div>

<script type="application/json" id="players-data">{{jsonScript players}}</script>
<script type="module" src="/js/pages/players.js"></script>
