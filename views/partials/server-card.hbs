<a href="/servers/{{id}}" class="card group relative block overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:border-line-strong hover:shadow-lg flex flex-col h-full bg-canvas"
   data-filter="{{name}} {{flavor}} {{mcVersion}}{{#each tags}} {{this}}{{/each}}"
   style="border-left: 4px solid {{accent}}">
  <div class="p-4 sm:p-5 flex flex-col h-full">
    <!-- Header -->
    <div class="flex items-start gap-4">
      <div class="relative shrink-0">
        <img src="{{iconSrc this.icon}}" alt="" class="size-14 rounded-xl object-cover shadow-sm ring-1 ring-inset ring-black/10 group-hover:scale-105 transition-transform duration-300" style="background: {{accent}}" data-fallback-icon="/icons/servers/grass.svg">
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2">
          <h3 class="truncate font-bold text-lg leading-tight group-hover:text-ok transition-colors">{{name}}</h3>
          {{#if updateAvailable}}<span class="badge badge-warn shrink-0 py-0.5 px-1.5 text-[10px] uppercase font-bold tracking-wider" title="Update available">Update</span>{{/if}}
          {{#if crashesUnread}}<span class="badge badge-danger shrink-0 py-0.5 px-1.5 text-[10px] uppercase font-bold tracking-wider" title="New crash reports.">{{crashesUnread}} {{plural crashesUnread 'crash' 'crashes'}}</span>{{/if}}
        </div>
        <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-medium text-ink-faint">
          <span class="text-ink bg-inset/50 px-1.5 py-0.5 rounded-md">{{flavor}}</span>
          <span class="text-ink bg-inset/50 px-1.5 py-0.5 rounded-md">{{mcVersion}}</span>
          <span class="text-ink-faint/30">·</span>
          <span class="font-mono text-[11px] bg-inset/30 px-1.5 py-0.5 rounded text-ink-soft">TCP:{{ports.game}}</span>
        </div>
      </div>
      <!-- Status Badge -->
      <div class="shrink-0 flex flex-col items-end gap-1.5">
        <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-widest border border-line/30 shadow-sm bg-canvas {{statusText status}}">
          <span class="status-dot relative {{statusDot status}} {{#if (statusPulse status)}}pulse{{/if}}"></span>
          {{statusLabel status}}
        </span>
        {{#if statusDetail}}<span class="max-w-[100px] sm:max-w-[120px] truncate text-right text-[10px] font-medium text-warn" data-status-detail="{{id}}" title="{{statusDetail}}">{{statusDetail}}</span>{{/if}}
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="mt-5 grid grid-cols-4 gap-2 bg-inset/30 rounded-xl p-3 border border-line/50" data-card-stats>
      <div class="flex flex-col col-span-2 sm:col-span-1">
        <span class="text-[10px] font-bold text-ink-faint uppercase tracking-wider mb-1 flex items-center gap-1">{{{icon 'users' 'size-3'}}} Players</span>
        <span class="text-sm font-bold tabular-nums text-ink">{{players.online}}<span class="text-xs font-medium text-ink-soft">/{{players.max}}</span></span>
      </div>
      <div class="flex flex-col col-span-2 sm:col-span-1">
        <span class="text-[10px] font-bold text-ink-faint uppercase tracking-wider mb-1 flex items-center gap-1">{{{icon 'cpu' 'size-3'}}} CPU</span>
        <span class="text-sm font-bold tabular-nums text-ink">{{#if (eq status 'running')}}{{stats.cpuPct}}%{{else}}-{{/if}}</span>
      </div>
      <div class="flex flex-col col-span-2 sm:col-span-1">
        <span class="text-[10px] font-bold text-ink-faint uppercase tracking-wider mb-1 flex items-center gap-1">{{{icon 'memory-stick' 'size-3'}}} RAM</span>
        <span class="text-sm font-bold tabular-nums text-ink truncate"{{#if memory.note}} data-tip="{{memory.note}}"{{/if}}>{{#if (eq status 'running')}}{{stats.memUsedMb}}<span class="text-[10px] font-medium text-ink-soft ml-0.5">MB</span>{{else}}-{{/if}}</span>
      </div>
      <div class="flex flex-col col-span-2 sm:col-span-1">
        <span class="text-[10px] font-bold text-ink-faint uppercase tracking-wider mb-1 flex items-center gap-1">{{{icon 'clock' 'size-3'}}} Uptime</span>
        <span class="text-sm font-bold tabular-nums text-ink truncate">{{#if (eq status 'running')}}{{default stats.uptime '0m'}}{{else}}-{{/if}}</span>
      </div>
    </div>

    <!-- Disk -->
    <div class="mt-auto pt-4" data-card-disk>
      <div class="flex items-center justify-between text-xs mb-1.5 font-medium">
        <span class="flex items-center gap-1.5 text-ink-soft">{{{icon 'hard-drive' 'size-3.5'}}} Disk Usage</span>
        <span class="text-ink-faint tabular-nums"><span class="text-ink font-semibold">{{bytes disk.used}}</span>{{#if disk.quota}} <span class="text-line-strong mx-0.5">/</span> {{bytes disk.quota}}{{else}} <span class="opacity-50 ml-1">(no quota)</span>{{/if}}</span>
      </div>
      <div class="meter h-1.5 rounded-full overflow-hidden bg-inset/50 border border-line/30"><div class="{{meterColor disk.used disk.quota}} h-full rounded-full transition-all duration-500" style="width: {{pct disk.used disk.quota}}%"></div></div>
    </div>

    <!-- Last backup -->
    <div class="mt-3 flex items-center justify-between text-xs font-medium" data-card-backup>
      <span class="flex items-center gap-1.5 text-ink-soft">{{{icon 'archive' 'size-3.5'}}} Last Backup</span>
      <span class="tabular-nums {{#if backup.stale}}text-warn font-semibold{{else}}text-ink-faint{{/if}}"{{#if backup.stale}} data-tip="No backup in over 7 days."{{/if}}>{{backup.text}}</span>
    </div>

    <!-- Tags -->
    {{#if tags.length}}
      <div class="mt-4 pt-4 border-t border-line/30 flex flex-wrap gap-1.5" data-card-tags>
        {{#each tags}}<span class="chip text-[10px] py-0.5 px-2 bg-inset/40 text-ink-soft border-line/50 border hover:bg-inset/80 transition-colors">{{this}}</span>{{/each}}
      </div>
    {{/if}}
  </div>
</a>
