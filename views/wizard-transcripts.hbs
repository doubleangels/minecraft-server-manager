{{> page-header heading="CHATBOT TRANSCRIPTS" sub="Kept according to each server's retention policy, including conversations from servers that were later deleted."}}

<div class="card overflow-hidden">
  {{#if transcripts.length}}
    <div class="divide-y divide-line">
      {{#each transcripts}}
        <div class="p-4">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-faint">
            <span class="font-medium text-ink-soft">{{server_name}}</span>
            <span class="font-mono">{{server_id}}</span>
            <span>{{#if speaker}}<span class="chip">{{speaker}}</span>{{/if}}</span>
            <span class="ml-auto" data-ts="{{created_at}}">{{created_at}}</span>
          </div>
          <p class="mt-2 whitespace-pre-wrap break-words text-sm {{#if (eq role 'error')}}text-danger{{else}}text-ink{{/if}}">{{content}}</p>
        </div>
      {{/each}}
    </div>
  {{else}}
    {{> empty-state iconName='bot' title='No Transcripts Being Kept' message="Set a retention policy on a server's Chatbot tab to start recording conversations."}}
  {{/if}}
</div>
