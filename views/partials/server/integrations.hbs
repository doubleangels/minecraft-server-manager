<div class="space-y-4" id="ig-root" data-server-id="{{server.id}}" data-invite="{{jsonAttr integrations.invite}}">

  {{#if (eq sub 'chatbot')}}
  {{#if integrations.wizard}}
  <div class="card p-4 lg:col-span-2" id="ig-wizard" data-dirty-group="the chatbot settings">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h3 class="flex items-center gap-2 font-semibold">{{{icon 'sparkles' 'size-4 text-link'}}} Chatbot Settings</h3>
        <p class="mt-1 text-xs text-ink-faint">Players invoke this chatbot with <code class="code-inline">@{{integrations.wizard.invocationName}}</code>. Configuration and transcripts are visible only to admins.</p>
      </div>
      <span class="msm-toggle"><input type="checkbox" id="ig-wz-enabled" {{#if integrations.wizard.enabled}}checked{{/if}}><span></span></span>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      <div class="space-y-4">
        <div>
          <label class="label" for="ig-wz-name">Invocation Name</label>
          <div class="flex items-center gap-1">
            <span class="font-mono text-sm text-ink-faint">@</span>
            <input class="input font-mono text-xs" id="ig-wz-name" maxlength="32" pattern="[A-Za-z][A-Za-z0-9_-]{0,31}" value="{{integrations.wizard.invocationName}}" placeholder="wizard">
          </div>
          <p class="help">Players call the chatbot with this name, for example <code class="code-inline">@bubba</code>. It also becomes the chatbot's chat and transcript label.</p>
        </div>
        <div>
          <label class="label" for="ig-wz-url">OpenAI-compatible Base URL</label>
          <input class="input font-mono text-xs" id="ig-wz-url" value="{{integrations.wizard.baseUrl}}" placeholder="http://192.168.1.50:11434">
          <p class="help">Ollama works with its host and port; <code class="code-inline">/v1</code> is added automatically. LAN/private addresses are supported.</p>
        </div>
        <div>
          <label class="label" for="ig-wz-model">Model</label>
          <div class="flex gap-2">
            <input class="input min-w-0 flex-1 font-mono text-xs" id="ig-wz-model" list="ig-wz-models" value="{{integrations.wizard.model}}" placeholder="llama3.2:latest">
            <datalist id="ig-wz-models"></datalist>
            <button class="btn shrink-0" id="ig-wz-models-load">Discover</button>
          </div>
          <p class="help">Discovery fills suggestions; free text always remains available.</p>
        </div>
        <div>
          <label class="label" for="ig-wz-key">API Key <span class="font-normal text-ink-faint">(Optional)</span></label>
          <input class="input font-mono text-xs" type="password" id="ig-wz-key" autocomplete="new-password" placeholder="{{#if integrations.wizard.hasApiKey}}Stored securely, leave blank to keep{{else}}Not required by default Ollama installs{{/if}}">
          {{#if integrations.wizard.hasApiKey}}
            <label class="mt-2 flex items-center gap-2 text-xs"><input type="checkbox" class="msm-check" id="ig-wz-key-clear"> Remove Stored Key on Save</label>
          {{/if}}
        </div>
        <div>
          <label class="label" for="ig-wz-retention">Transcript Retention</label>
          <div class="flex items-center gap-2">
            <input class="input w-28" type="number" id="ig-wz-retention" min="0" max="3650" value="{{integrations.wizard.retentionDays}}">
            <span class="text-sm text-ink-soft">days</span>
          </div>
          <p class="help">Default 7. Set 0 to store no transcripts. Existing transcripts remain associated with deleted servers until this period expires.</p>
        </div>
      </div>

      <div>
        <label class="label" for="ig-wz-prompt">Chatbot Persona and System Prompt</label>
        <textarea class="input min-h-72 max-h-[60vh] resize-y font-mono text-xs leading-5" id="ig-wz-prompt" maxlength="12000">{{integrations.wizard.systemPrompt}}</textarea>
        <p class="help">This is sent as the system message for this server. Powers are exposed as fixed, validated tools, never raw console commands.</p>
      </div>
    </div>

    <div class="mt-5 rounded-xl border border-line/70 bg-surface-container/50 p-4 sm:p-5 shadow-xs">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h4 class="font-semibold">Player Outreach</h4>
          <p class="help">Deterministic per-session greetings and check-ins. No LLM call is needed to send them.</p>
        </div>
        <label class="flex items-center gap-2 text-sm"><span>Greet Players on Join</span><span class="msm-toggle"><input type="checkbox" id="ig-wz-welcome-enabled" {{#if integrations.wizard.welcomeEnabled}}checked{{/if}}><span></span></span></label>
      </div>
      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        <div>
          <label class="label" for="ig-wz-welcome-message">Join Greeting</label>
          <textarea class="input min-h-24 max-h-72 resize-y text-xs" id="ig-wz-welcome-message" maxlength="400">{{integrations.wizard.welcomeMessage}}</textarea>
          <p class="help">Broadcast once when a player joins. Variables: <code class="code-inline">{player}</code>, <code class="code-inline">{chatbot}</code>, and <code class="code-inline">{mention}</code>. The older <code class="code-inline">{wizard}</code> variable remains supported.</p>
        </div>
        <div>
          <label class="label" for="ig-wz-checkin-message">Playtime Check-In</label>
          <textarea class="input min-h-24 max-h-72 resize-y text-xs" id="ig-wz-checkin-message" maxlength="400">{{integrations.wizard.checkinMessage}}</textarea>
          <div class="mt-2 flex flex-wrap items-center gap-2 text-sm">
            <span>Send privately after</span>
            {{! The number and its unit wrap together, never apart. }}
            <span class="inline-flex items-center gap-2 whitespace-nowrap"><input class="input w-20" type="number" inputmode="numeric" id="ig-wz-checkin-minutes" min="0" max="1440" value="{{integrations.wizard.checkinMinutes}}"> <span class="text-ink-soft">minutes online</span></span>
          </div>
          <p class="help">Sent once per play session. Set 0 to disable. The message may also use <code class="code-inline">{minutes}</code>.</p>
        </div>
      </div>
      <div class="mt-4">
        <label class="label" for="ig-wz-conversation-minutes">Opt-In Conversation Mode</label>
        <div class="flex flex-wrap items-center gap-2 text-sm">
          <span>Keep listening for</span>
          <span class="inline-flex items-center gap-2 whitespace-nowrap"><input class="input w-20" type="number" inputmode="numeric" id="ig-wz-conversation-minutes" min="0" max="60" value="{{integrations.wizard.conversationMinutes}}"> <span class="text-ink-soft">minutes</span></span>
          <span class="text-ink-soft">after a player says <code class="code-inline">@{{integrations.wizard.invocationName}} chat</code></span>
        </div>
        <p class="help">During this explicitly opened window, that player can reply without repeating the mention. <code class="code-inline">@{{integrations.wizard.invocationName}} bye</code>, leaving the server, or the timeout closes it. Messages beginning with <code class="code-inline">!</code>, <code class="code-inline">/</code>, or another <code class="code-inline">@</code> are ignored. Set 0 to disable.</p>
      </div>
    </div>

    <div class="mt-5 rounded-xl border border-line/70 bg-surface-container/50 p-4 sm:p-5 shadow-xs">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h4 class="font-semibold">Chatbot Powers <span class="text-xs font-normal text-warn">Experimental</span></h4>
          <p class="help">Basic users receive self/world powers. Controllers receive separately validated powers that may affect another online player. Everyone else remains conversation-only.</p>
        </div>
        <label class="flex items-center gap-2 text-sm"><span>Enable Powers</span><span class="msm-toggle"><input type="checkbox" id="ig-wz-powers-enabled" {{#if integrations.wizard.powersEnabled}}checked{{/if}}><span></span></span></label>
      </div>
      <div class="mt-4 grid gap-4 lg:grid-cols-4">
        <div>
          <label class="label" for="ig-wz-testers">Basic Users</label>
          <textarea class="input min-h-28 max-h-72 resize-y font-mono text-xs" id="ig-wz-testers" placeholder="Gleep52&#10;PlayerA">{{{joinLines integrations.wizard.powerTesters}}}</textarea>
          <p class="help">One exact player name per line. Maximum 50.</p>
        </div>
        <div>
          <label class="label" for="ig-wz-controllers">Power Controllers</label>
          <textarea class="input min-h-28 max-h-72 resize-y font-mono text-xs" id="ig-wz-controllers" placeholder="Gleep52">{{{joinLines integrations.wizard.powerControllers}}}</textarea>
          <p class="help">Only these exact players may affect another online player. Their gifts may use any valid item ID, but still obey the quantity limit. Add them to Basic users too if they should retain self/world powers.</p>
        </div>
        <div>
          <label class="label" for="ig-wz-gifts">Allowed Gifts</label>
          <textarea class="input min-h-28 max-h-72 resize-y font-mono text-xs" id="ig-wz-gifts">{{{joinLines integrations.wizard.giftItems}}}</textarea>
          <p class="help">One namespaced item ID per line. Restricts gifts that Basic users give themselves; power controllers may give other players any valid vanilla or modded item.</p>
        </div>
        <div class="space-y-3">
          <label class="flex items-center gap-2 text-sm"><input class="msm-check" type="checkbox" id="ig-wz-dry-run" {{#if integrations.wizard.powersDryRun}}checked{{/if}}> Dry Run (Audit Only; Change Nothing)</label>
          <div><label class="label" for="ig-wz-gift-max">Maximum Gift Quantity</label><input class="input w-28" type="number" id="ig-wz-gift-max" min="1" max="16" value="{{integrations.wizard.giftMaxCount}}"></div>
          <div><label class="label" for="ig-wz-power-cooldown">Per-Player Cooldown</label><div class="flex items-center gap-2"><input class="input w-28" type="number" id="ig-wz-power-cooldown" min="3" max="3600" value="{{integrations.wizard.powerCooldownSec}}"><span class="text-sm text-ink-soft">seconds</span></div></div>
        </div>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-2 text-sm sm:grid-cols-3 lg:grid-cols-6">
        <label class="flex items-center gap-2"><input class="msm-check" type="checkbox" data-wz-power="heal" {{#if integrations.wizard.powerFlags.heal}}checked{{/if}}> Healing</label>
        <label class="flex items-center gap-2"><input class="msm-check" type="checkbox" data-wz-power="feed" {{#if integrations.wizard.powerFlags.feed}}checked{{/if}}> Feeding</label>
        <label class="flex items-center gap-2"><input class="msm-check" type="checkbox" data-wz-power="spawn" {{#if integrations.wizard.powerFlags.spawn}}checked{{/if}}> Teleports</label>
        <label class="flex items-center gap-2"><input class="msm-check" type="checkbox" data-wz-power="time" {{#if integrations.wizard.powerFlags.time}}checked{{/if}}> Time</label>
        <label class="flex items-center gap-2"><input class="msm-check" type="checkbox" data-wz-power="weather" {{#if integrations.wizard.powerFlags.weather}}checked{{/if}}> Weather</label>
        <label class="flex items-center gap-2"><input class="msm-check" type="checkbox" data-wz-power="gift" {{#if integrations.wizard.powerFlags.gift}}checked{{/if}}> Gifts</label>
      </div>
    </div>

    <div class="mt-4 flex flex-col sm:flex-row sm:items-center sm:flex-wrap gap-2">
      <button class="btn" id="ig-wz-test">Test Connection</button>
      <button class="btn" id="ig-wz-transcripts">Refresh This Server's Transcripts</button>
      <button class="btn" id="ig-wz-power-audit">Refresh Power Audit</button>
      <a class="btn btn-ghost" href="/wizard-transcripts">All Transcript Archives</a>
    </div>
    <div class="mt-4 hidden max-h-80 overflow-auto rounded-xl border border-line bg-surface-container/60 p-3 text-xs" id="ig-wz-transcript-list"></div>
    <div class="mt-4 hidden max-h-80 overflow-auto rounded-xl border border-line bg-surface-container/60 p-3 text-xs" id="ig-wz-power-audit-list"></div>
  {{! Save pinned as the card's footer, so it stays in reach on a long card. }}
  <div class="action-bar action-bar-footer flex flex-wrap items-center gap-2 sm:flex-nowrap">
    <span class="hidden basis-full items-center gap-1.5 text-xs text-warn sm:mr-auto sm:basis-auto" data-ig-dirty="wz">{{{icon 'circle-dot' 'size-3.5'}}} Unsaved changes!</span>
    <button data-dirty-save class="btn btn-primary flex-1 sm:ml-auto sm:flex-none" id="ig-wz-save">{{{icon 'save' 'size-4'}}} Save Chatbot</button>
  </div>
  </div>
  {{else}}
  <div class="card p-6 text-center text-sm text-ink-faint lg:col-span-2">
    Chatbot configuration is visible only to admins.
  </div>
  {{/if}}
  {{/if}}

  {{#if (eq sub 'discord')}}
  <div class="card p-4 lg:col-span-2" data-dirty-group="the Discord settings">
    <div class="mb-4 flex items-center justify-between gap-3">
      <h3 class="flex items-center gap-2 font-semibold">{{{icon 'webhook' 'size-4 text-link'}}} Discord Notifications</h3>
      <span class="msm-toggle"><input type="checkbox" id="ig-dc-enabled" {{#if integrations.discord.enabled}}checked{{/if}}><span></span></span>
    </div>
    <div class="space-y-4">
      <div>
        <label class="label" for="ig-dc-url">Webhook URL</label>
        <input class="input font-mono text-xs" type="password" id="ig-dc-url" autocomplete="off" placeholder="https://discord.com/api/webhooks/…">
        {{! The stored webhook is shown as a fact, not a placeholder - a
            placeholder disappears on focus and reads as example text. }}
        {{#if integrations.discord.hasWebhook}}
          <p class="help">Stored: <code class="code-inline">{{integrations.discord.webhookMasked}}</code>. Leave blank to keep it, or paste a new URL to replace it.</p>
        {{else}}
          <p class="help">Create a webhook in your Discord server under Server Settings → Integrations → Webhooks, then paste its URL here. It is stored encrypted.</p>
        {{/if}}
      </div>
      <div>
        <span class="label">Send Notifications for</span>
        <div class="grid grid-cols-2 gap-2 text-sm sm:grid-cols-3">
          <label class="flex items-center gap-2"><input type="checkbox" class="msm-check" data-dc-event="lifecycle" {{#if integrations.discord.events.lifecycle}}checked{{/if}}> Start / Stop</label>
          <label class="flex items-center gap-2"><input type="checkbox" class="msm-check" data-dc-event="crashes" {{#if integrations.discord.events.crashes}}checked{{/if}}> Crashes</label>
          <label class="flex items-center gap-2"><input type="checkbox" class="msm-check" data-dc-event="backups" {{#if integrations.discord.events.backups}}checked{{/if}}> Backups</label>
          <label class="flex items-center gap-2"><input type="checkbox" class="msm-check" data-dc-event="updates" {{#if integrations.discord.events.updates}}checked{{/if}}> Updates</label>
          <label class="flex items-center gap-2"><input type="checkbox" class="msm-check" data-dc-event="players" {{#if integrations.discord.events.players}}checked{{/if}}> Kicks / Bans</label>
          <label class="flex items-center gap-2" title="Out of memory, stalled boot, failed scheduled task, quota stop, health-check failure."><input type="checkbox" class="msm-check" data-dc-event="alerts" {{#if integrations.discord.events.alerts}}checked{{/if}}> Alerts</label>
        </div>
      </div>
      <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center">
        {{#if integrations.discord.hasWebhook}}
          <button class="btn" id="ig-dc-test">{{{icon 'send' 'size-4'}}} Send Test</button>
        {{else}}
          {{! Disabled controls swallow hover - the wrapper carries the "why". }}
          <span class="grid sm:inline-grid" data-tip="Save a webhook URL first."><button class="btn" id="ig-dc-test" disabled>{{{icon 'send' 'size-4'}}} Send Test</button></span>
        {{/if}}
      </div>
    </div>
  {{! Save pinned as the card's footer, so it stays in reach on a long card. }}
  <div class="action-bar action-bar-footer flex flex-wrap items-center gap-2 sm:flex-nowrap">
    <span class="hidden basis-full items-center gap-1.5 text-xs text-warn sm:mr-auto sm:basis-auto" data-ig-dirty="dc">{{{icon 'circle-dot' 'size-3.5'}}} Unsaved changes!</span>
    <button data-dirty-save class="btn btn-primary flex-1 sm:ml-auto sm:flex-none" id="ig-dc-save">{{{icon 'save' 'size-4'}}} Save</button>
  </div>
  </div>
  {{/if}}

  {{#if (eq sub 'status-page')}}
  <div class="card p-4 lg:col-span-2" data-dirty-group="the status page settings">
    <div class="mb-4 flex items-center justify-between gap-3">
      <h3 class="flex items-center gap-2 font-semibold">{{{icon 'globe' 'size-4 text-ok'}}} Public Status Page</h3>
      <span class="msm-toggle"><input type="checkbox" id="ig-sp-enabled" {{#if integrations.statusPage.enabled}}checked{{/if}}><span></span></span>
    </div>
    <div class="space-y-4">
      <div>
        <label class="label" for="ig-sp-slug">Page Address</label>
        <div class="flex items-center gap-2">
          <span class="shrink-0 font-mono text-xs text-ink-faint">/status/</span>
          {{! min-w-0: see settings.hbs - an unconstrained flex-1 input refuses to
              shrink below its intrinsic width and pushes the page wider on mobile. }}
          <input class="input min-w-0 flex-1 font-mono text-xs" id="ig-sp-slug" placeholder="my-server" value="{{integrations.statusPage.slug}}">
        </div>
        <p class="help">Anyone with the link sees the name, MOTD, version, player count, and uptime, and nothing else. There is no way into the panel from it. Off by default.</p>
      </div>
      {{#if (and integrations.statusPage.enabled integrations.statusPage.path)}}
        <div class="flex flex-col sm:flex-row sm:items-center sm:flex-wrap gap-2">
          <a class="btn" href="{{integrations.statusPage.path}}" target="_blank" rel="noopener" id="ig-sp-link">{{{icon 'link' 'size-4'}}} Open Page</a>
          <button class="btn btn-ghost" id="ig-sp-copy">{{{icon 'copy' 'size-4'}}} Copy Link</button>
        </div>
      {{/if}}
    </div>
  {{! Save pinned as the card's footer, so it stays in reach on a long card. }}
  <div class="action-bar action-bar-footer flex flex-wrap items-center gap-2 sm:flex-nowrap">
    <span class="hidden basis-full items-center gap-1.5 text-xs text-warn sm:mr-auto sm:basis-auto" data-ig-dirty="sp">{{{icon 'circle-dot' 'size-3.5'}}} Unsaved changes!</span>
    <button data-dirty-save class="btn btn-primary flex-1 sm:ml-auto sm:flex-none" id="ig-sp-save">{{{icon 'save' 'size-4'}}} Save</button>
  </div>
  </div>
  {{/if}}

  {{#if (eq sub 'invites')}}
  <div class="card p-4 lg:col-span-2">
    <h3 class="mb-4 flex items-center gap-2 font-semibold">{{{icon 'send' 'size-4 text-warn'}}} Invite Friends</h3>
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="space-y-4">
        <div>
          <label class="label" for="ig-addr">Address to Share</label>
          <select class="input" id="ig-addr" data-label="Address to share">
            {{#each integrations.invite.candidates}}
              <option value="{{this}}" data-desc="Local network (LAN)">{{this}}</option>
            {{/each}}
            {{#if integrations.invite.publicAddress}}
              <option value="{{integrations.invite.publicAddress}}" data-desc="Public IP address (needs port forwarding)">{{integrations.invite.publicAddress}}</option>
            {{/if}}
            <option value="__custom" data-desc="Domain or address you set up yourself">Custom Address…</option>
          </select>
          <input class="input mt-2 hidden font-mono text-xs" id="ig-host" placeholder="play.example.com:{{integrations.invite.port}}">
        </div>
        <div>
          <span class="label">Invite Text</span>
          <pre class="max-h-44 overflow-auto whitespace-pre-wrap rounded-xl border border-line bg-surface-container/60 p-3 font-mono text-xs text-ink-soft" id="ig-invite-text">{{integrations.invite.inviteText}}</pre>
        </div>
        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-2">
          <button class="btn btn-primary" id="ig-copy-invite">{{{icon 'copy' 'size-4'}}} Copy Invite Text</button>
          <button class="btn" data-share-from="#ig-invite-text" data-share-title="{{server.name}}" hidden>{{{icon 'share-2' 'size-4'}}} Share Invite</button>
          {{#if integrations.invite.modded}}
            <button class="btn" id="ig-mrpack">{{{icon 'download' 'size-4'}}} Download Client Modpack (.mrpack)</button>
          {{/if}}
        </div>
      </div>
      <div class="space-y-3 text-sm">
        {{#if integrations.invite.modded}}
          <div class="rounded-xl border border-line bg-surface-container/60 p-3.5">
            <p class="font-medium">{{{icon 'shield' 'size-3.5'}}} What friends need.</p>
            <p class="mt-1 text-xs text-ink-soft">Import the .mrpack into Prism Launcher or the Modrinth App. It installs the right Minecraft version and the mods, and adds this server to their multiplayer list.</p>
            {{#if integrations.invite.manualMods.length}}
              <p class="mt-2 text-xs text-warn">These mods are not on Modrinth, so friends must add the files to their <code class="code-inline">mods</code> folder themselves:</p>
              <ul class="mt-1 list-inside list-disc text-xs text-ink-soft">
                {{#each integrations.invite.manualMods}}<li>{{name}} <span class="font-mono text-ink-faint">({{filename}})</span></li>{{/each}}
              </ul>
            {{/if}}
          </div>
        {{else}}
          <div class="rounded-xl border border-line bg-surface-container/60 p-3.5">
            <p class="font-medium">{{{icon 'shield' 'size-3.5'}}} What friends need.</p>
            <p class="mt-1 text-xs text-ink-soft">Just vanilla Minecraft {{integrations.invite.mcVersion}}. No mods are needed on the client.</p>
          </div>
        {{/if}}
        {{#if integrations.invite.whitelistEnforced}}
          <div class="notice notice-warn text-xs">{{{icon 'triangle-alert' 'size-4 mt-0.5 shrink-0 text-warn'}}}<div>The whitelist is enforced. Add each friend on the Players tab before they join.</div></div>
        {{/if}}
        <details class="rounded-xl border border-line bg-surface-container/60 p-3.5 text-xs">
          <summary class="cursor-pointer font-medium text-sm">Playing over the Internet (Port Forwarding)</summary>
          <p class="mt-2 text-ink-soft">{{integrations.invite.portForwardGuidance}}</p>
          {{#if integrations.invite.publicIp}}
            <p class="mt-2">Detected public IP: <code class="code-inline">{{integrations.invite.publicIp}}</code></p>
          {{else}}
            <p class="mt-2 text-ink-faint">Your public IP address could not be detected right now. The panel may be offline.</p>
          {{/if}}
        </details>
      </div>
    </div>
  </div>
  {{/if}}
</div>

<script type="module" src="/js/pages/integrations.js"></script>
